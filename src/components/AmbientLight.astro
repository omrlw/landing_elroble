---
import { ambientProfiles, arcPath, type AmbientProfile } from '../scripts/ambient-shader';

interface Props {
  profile: AmbientProfile;
  side?: 'start' | 'end';
  tone?: 'cream' | 'forest';
}

const { profile, side = 'start', tone = 'cream' } = Astro.props;
const paths = ambientProfiles[profile].map(arcPath);
---

<span class:list={['ambient-light', `ambient-light--${tone}`, { 'ambient-light--end': side === 'end' }]}
  data-ambient-light={profile} data-light-tone={tone} data-light-side={side} aria-hidden="true">
  <span class="ambient-light__area" data-light-area>
    <svg class="ambient-light__fallback" viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false">
      {paths.map((path) => (
        <>
          <path class="ambient-light__shade" d={path} />
          <path class="ambient-light__rim" d={path} />
          <path class="ambient-light__glint" d={path} pathLength="100" />
        </>
      ))}
    </svg>
  </span>
</span>

<script>
  import { setupAmbientLight } from '../scripts/ambient-light';

  const dispose = setupAmbientLight();
  if (import.meta.hot) import.meta.hot.dispose(dispose);
</script>

<style>
  .ambient-light {
    --ambient-rim: color-mix(in srgb, var(--color-paper) 64%, transparent);
    --ambient-shadow: color-mix(in srgb, var(--color-oak) 4%, transparent);
    --ambient-glint: color-mix(in srgb, var(--color-paper) 86%, transparent);
    position: absolute;
    z-index: -1;
    inset: 0;
    overflow: clip;
    border-radius: inherit;
    mask-image: var(--ambient-mask, none);
    pointer-events: none;
  }

  .ambient-light--forest {
    --ambient-rim: color-mix(in srgb, var(--color-honey) 20%, transparent);
    --ambient-shadow: color-mix(in srgb, var(--color-paper) 3%, transparent);
    --ambient-glint: color-mix(in srgb, var(--color-paper) 31%, transparent);
  }

  .ambient-light__area {
    position: absolute;
    inset-block: var(--ambient-y, 50%) var(--ambient-bottom, auto);
    inset-inline-start: 0;
    inline-size: min(var(--ambient-size, clamp(15rem, 31vw, 32rem)), 74%);
    aspect-ratio: var(--ambient-aspect, 1.22);
    translate: calc(-1 * var(--ambient-crop, 16%)) var(--ambient-shift, -50%);
  }

  .ambient-light--end .ambient-light__area {
    inset-inline: auto 0;
    translate: var(--ambient-crop, 16%) var(--ambient-shift, -50%);
  }

  .ambient-light__fallback,
  .ambient-light__area > :global(canvas) {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
  }

  .ambient-light[data-light-live] .ambient-light__fallback { visibility: hidden; }
  .ambient-light--end .ambient-light__fallback { scale: -1 1; }
  .ambient-light__fallback { fill: none; stroke-linecap: round; }
  .ambient-light__fallback path { vector-effect: non-scaling-stroke; }
  .ambient-light__shade { stroke: var(--ambient-shadow); stroke-width: 5; }
  .ambient-light__rim { stroke: var(--ambient-rim); stroke-width: 1; }
  .ambient-light__glint {
    stroke: var(--ambient-glint);
    stroke-width: 2;
    stroke-dasharray: 13 87;
  }

  @media (prefers-reduced-motion: no-preference) {
    .ambient-light:not([data-light-live]) .ambient-light__glint {
      animation: ambient-lustre 10s linear infinite paused;
    }
    .ambient-light[data-light-visible] .ambient-light__glint { animation-play-state: running; }
    @keyframes ambient-lustre { to { stroke-dashoffset: -100; } }
  }

  @media (forced-colors: active) {
    .ambient-light { display: none; }
  }
</style>
