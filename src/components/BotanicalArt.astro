---
import { Image } from 'astro:assets';
import oakAcorns from '../assets/botanical/day-oak-acorns.webp';
import oliveSprig from '../assets/botanical/olive-sprig.webp';

const artwork = {
  acorns: oakAcorns,
  branch: oliveSprig,
};

interface Props {
  motif: keyof typeof artwork;
  class?: string;
}

const { motif, class: className, ...attrs } = Astro.props;
const source = artwork[motif];
const widths = [48, 64, 96, 128, 192, 256, 384].filter((width) => width < source.width);
const sizes = 'clamp(4rem, 12vw, 8rem)';
---

<span {...attrs} class:list={['botanical', `botanical--${motif}`, className]} aria-hidden="true">
  <Image src={source} alt="" width={Math.min(256, source.width)} widths={widths}
    {sizes} format="webp" loading="lazy" decoding="async" />
</span>

<style>
  .botanical {
    display: grid;
    place-items: center;
    inline-size: clamp(4rem, 12vw, 8rem);
    aspect-ratio: 5 / 4;
    pointer-events: none;
    user-select: none;
  }

  .botanical--acorns { --botanical-image-width: 76%; }
  .botanical--branch { --botanical-image-width: 81%; }

  .botanical img {
    display: block;
    inline-size: var(--botanical-image-width, 100%);
    block-size: auto;
    max-block-size: 100%;
    object-fit: contain;
  }
</style>
