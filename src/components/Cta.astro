---
import { whatsappUrl } from '../config/business';
import ActionIcon from './ActionIcon.astro';

interface Props {
  label?: string;
  compactLabel?: string;
  href?: string;
  variant?: 'primary' | 'light' | 'glass' | 'compact' | 'oak';
  class?: string;
}

const {
  label = 'Agendar una visita',
  compactLabel,
  href = whatsappUrl,
  variant = 'primary',
  class: className,
} = Astro.props;

const surfaceClasses = {
  primary: 'liquid-glass--action',
  light: 'liquid-glass--clear',
  glass: 'liquid-glass--blur',
  compact: 'liquid-glass--action',
  oak: 'liquid-glass--action liquid-glass--oak',
};
---

<a class:list={[
  'cta liquid-glass liquid-glass--interactive',
  `cta--${variant}`,
  surfaceClasses[variant],
  className,
]} href={href}>
  {compactLabel ? (
    <>
      <span class="cta-label cta-label--full">{label}</span>
      <span class="cta-label cta-label--compact">{compactLabel}</span>
    </>
  ) : (
    <span>{label}</span>
  )}
  <span class="cta-icon" aria-hidden="true"><ActionIcon name="arrow-right" /></span>
</a>

<style>
  .cta {
    display: inline-flex;
    width: var(--cta-width, fit-content);
    max-width: 100%;
    min-height: var(--cta-height, var(--cta-min-height));
    align-items: center;
    justify-content: var(--cta-justify, space-between);
    gap: var(--cta-gap, 0.75rem);
    padding: var(--cta-padding, 0.65rem clamp(1rem, 2vw, 1.5rem));
    border: 1px solid transparent;
    border-radius: 999px;
    font-size: var(--text-cta);
    line-height: var(--leading-control);
    font-weight: 600;
    text-align: start;
    text-decoration: none;
  }

  .cta-label--compact { display: none; }

  .cta--compact {
    --cta-height: 2.75rem;
    --cta-gap: 0.5rem;
    --cta-padding: 0.375rem 0.5rem 0.375rem 1.0625rem;
    --cta-medallion-size: 1.75rem;
    font-size: var(--text-meta);
    white-space: nowrap;
  }

  .cta-icon {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    inline-size: var(--cta-medallion-size, 2rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--glass-lens-forest);
    box-shadow: var(--highlight-dark);
    color: var(--color-paper);
  }

  .cta--light .cta-icon { background: var(--surface-action); }
  .cta--oak .cta-icon { inline-size: 1.25rem; background: none; box-shadow: none; }

  @media (prefers-reduced-transparency: reduce), (forced-colors: active) {
    .cta--glass {
      --glass-backdrop: var(--glass-fill);
      --glass-filter: none;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .cta {
      transition: box-shadow var(--glass-motion) var(--glass-ease), --glass-wash var(--glass-motion) var(--glass-ease),
        translate var(--motion-state) var(--ease-soft), scale var(--motion-state) var(--ease-soft);
    }
    .cta-icon svg { transition: translate var(--motion-state) var(--ease-soft); }
    .cta-icon { transition: scale var(--motion-state) var(--ease-soft); }
    .cta:focus-visible .cta-icon svg { translate: .15rem 0; }
    .cta:active { translate: 0 1px; scale: .989; transition-duration: var(--motion-press); }
    .cta:active .cta-icon { scale: .94; transition-duration: var(--motion-press); }

    @media (hover: hover) and (pointer: fine) {
      .cta:hover:not(:active) { translate: 0 -1px; }
      .cta:hover .cta-icon svg { translate: .19rem 0; }
      .cta:hover:not(:active) .cta-icon { scale: 1.06; }
    }
  }
</style>
