---
import { whatsappUrl } from '../config/business';

interface Props {
  label?: string;
  compactLabel?: string;
  href?: string;
  variant?: 'primary' | 'light' | 'glass' | 'compact' | 'oak';
  icon?: string | false;
  class?: string;
}

const {
  label = 'Agendar una visita',
  compactLabel,
  href = whatsappUrl,
  variant = 'primary',
  icon = '/icons/cta-arrow.svg',
  class: className,
} = Astro.props;
---

<a class:list={[
  'cta liquid-glass liquid-glass--interactive',
  `cta--${variant}`,
  variant === 'light' ? 'liquid-glass--clear' : 'liquid-glass--action',
  { 'liquid-glass--optical': variant === 'glass', 'liquid-glass--oak': variant === 'oak' },
  className,
]} href={href}>
  <slot name="surface" />
  {compactLabel ? (
    <>
      <span class="cta-label cta-label--full">{label}</span>
      <span class="cta-label cta-label--compact">{compactLabel}</span>
    </>
  ) : (
    <span>{label}</span>
  )}
  {icon && <span class="cta-icon" aria-hidden="true"><img src={icon} width="22" height="22" alt="" /></span>}
</a>

<style>
  .cta {
    display: inline-flex;
    width: var(--cta-width, fit-content);
    max-width: 100%;
    min-height: var(--cta-height, var(--cta-min-height));
    align-items: center;
    justify-content: var(--cta-justify, space-between);
    gap: var(--cta-gap, 0.75rem);
    padding: var(--cta-padding, 0.65rem clamp(1rem, 2vw, 1.5rem));
    border: 1px solid transparent;
    border-radius: 999px;
    font-size: var(--text-cta);
    line-height: var(--leading-control);
    font-weight: 600;
    text-align: start;
    text-decoration: none;
  }

  .cta-label--compact { display: none; }

  .cta--compact {
    --cta-height: 2.75rem;
    --cta-gap: 0.5rem;
    --cta-padding: 0.375rem 0.5rem 0.375rem 1.0625rem;
    --cta-icon-size: 1.75rem;
    font-size: var(--text-meta);
    white-space: nowrap;
  }

  .cta--compact .cta-icon img {
    inline-size: 1.0625rem;
    block-size: 1.0625rem;
  }

  .cta-icon {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    inline-size: var(--cta-icon-size, 2rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--glass-lens-forest);
    box-shadow: var(--highlight-dark);
  }

  .cta--light .cta-icon { background: var(--surface-action); }
  .cta--oak .cta-icon { inline-size: 1.25rem; background: none; box-shadow: none; }

  @media (prefers-reduced-motion: no-preference) {
    .cta {
      transition: box-shadow var(--glass-motion) var(--glass-ease), --glass-wash var(--glass-motion) var(--glass-ease),
        translate var(--motion-state) var(--ease-soft), scale var(--motion-state) var(--ease-soft);
    }
    .cta-icon img { transition: translate var(--motion-state) var(--ease-soft); }
    .cta-icon { transition: scale var(--motion-state) var(--ease-soft); }
    .cta:focus-visible img { translate: .15rem 0; }
    .cta:not(.cta--glass):active { translate: 0 1px; scale: .989; transition-duration: var(--motion-press); }
    .cta:active .cta-icon { scale: .94; transition-duration: var(--motion-press); }

    @media (hover: hover) and (pointer: fine) {
      .cta:not(.cta--glass):hover { translate: 0 -1px; }
      .cta:not(.cta--glass):hover img { translate: .19rem 0; }
      .cta:not(.cta--glass):hover:not(:active) .cta-icon { scale: 1.06; }
      .cta:not(.cta--glass):active { translate: 0 1px; }
    }
  }
</style>
