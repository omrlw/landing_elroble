---
import { whatsappUrl } from '../config/business';

interface Props {
  label?: string;
  href?: string;
  variant?: 'primary' | 'light' | 'glass';
  icon?: string | false;
  class?: string;
}

const {
  label = 'Agendar una visita',
  href = whatsappUrl,
  variant = 'primary',
  icon = '/icons/cta-arrow.svg',
  class: className,
} = Astro.props;
---

<a class:list={['cta', `cta--${variant}`, { 'liquid-glass': variant === 'glass' }, className]} href={href}>
  <span>{label}</span>
  {icon && <span class="cta-icon" aria-hidden="true"><img src={icon} width="22" height="22" alt="" /></span>}
</a>

<style>
  .cta {
    display: inline-flex;
    width: var(--cta-width, fit-content);
    max-width: 100%;
    min-height: var(--cta-height, 3.5rem);
    align-items: center;
    justify-content: var(--cta-justify, space-between);
    gap: var(--cta-gap, 0.75rem);
    padding: var(--cta-padding, 0.65rem clamp(1rem, 2vw, 1.5rem));
    border: 1px solid transparent;
    border-radius: 999px;
    font-size: var(--text-button);
    line-height: 1.25;
    font-weight: 600;
    text-align: start;
    text-decoration: none;
    transition: filter var(--motion-state) var(--ease-soft), box-shadow var(--motion-state) var(--ease-soft);
  }

  .cta:not(:global(.liquid-glass)) {
    background: var(--cta-background, var(--surface-action));
    color: var(--cta-color, var(--color-paper));
    box-shadow: var(--cta-highlight, var(--highlight-dark));
  }

  .cta--light {
    --cta-background: var(--surface-paper);
    --cta-color: var(--color-forest);
    --cta-highlight: var(--highlight-light);
  }

  .cta-icon {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    inline-size: var(--cta-icon-size, 2rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--surface-on-forest);
    box-shadow: var(--highlight-dark);
  }

  .cta--light .cta-icon { background: var(--color-forest); }

  @media (hover: hover) {
    .cta:hover {
      filter: brightness(1.08);
    }
    .cta:not(:global(.liquid-glass)):hover:not(:focus-visible) {
      box-shadow: var(--cta-highlight, var(--highlight-dark)), var(--shadow-control);
    }
  }

  .cta:focus-visible {
    outline: 2px solid var(--color-forest);
    outline-offset: 2px;
    box-shadow: 0 0 0 2px var(--color-paper);
  }

  .cta:active { filter: brightness(.91); }

  @media (prefers-reduced-motion: no-preference) {
    .cta { transition-property: filter, box-shadow, translate, scale; }
    .cta-icon img { transition: translate var(--motion-state) var(--ease-soft); }
    .cta-icon { transition: scale var(--motion-state) var(--ease-soft); }
    .cta:focus-visible img { translate: .15rem 0; }
    .cta:active { translate: 0 1px; scale: .989; transition-duration: var(--motion-press); }
    .cta:active .cta-icon { scale: .94; transition-duration: var(--motion-press); }

    @media (hover: hover) and (pointer: fine) {
      .cta:hover { translate: 0 -1px; }
      .cta:hover img { translate: .19rem 0; }
      .cta:hover:not(:active) .cta-icon { scale: 1.06; }
      .cta:active { translate: 0 1px; }
    }
  }
</style>
