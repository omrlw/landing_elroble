---
interface Props {
  controls: string;
}

const { controls } = Astro.props;
---

<button class="gallery-playback" type="button" data-gallery-playback aria-controls={controls} aria-label="Pausar carrusel" hidden>
  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
    <path class="gallery-playback__pause" d="M6 4.5v7m4-7v7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
    <path class="gallery-playback__play" d="M6 4.75v6.5L11 8 6 4.75Z" fill="currentColor" stroke="currentColor" stroke-linejoin="round" />
  </svg>
</button>
