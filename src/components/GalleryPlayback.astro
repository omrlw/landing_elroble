---
import ActionIcon from './ActionIcon.astro';

interface Props {
  controls: string;
}

const { controls } = Astro.props;
---

<button class="gallery-playback" type="button" data-gallery-playback aria-controls={controls} aria-label="Pausar carrusel" hidden>
  <ActionIcon class="gallery-playback__pause" name="pause" size={14} />
  <ActionIcon class="gallery-playback__play" name="play" size={14} />
</button>
