---
interface Props {
  class?: string;
  sampleImage?: boolean;
  indicator?: boolean;
}

const { class: className, sampleImage, indicator } = Astro.props;
---

<span class:list={['optical-glass', className]} aria-hidden="true" data-optical-glass data-optical-image={sampleImage ? '' : undefined}
  data-nav-lens={indicator ? '' : undefined} hidden={indicator}>
  {sampleImage && <span class="optical-glass__sample" data-optical-sample></span>}
</span>
