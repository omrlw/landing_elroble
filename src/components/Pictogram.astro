---
import activities from '../assets/icons/activities.svg';
import autonomy from '../assets/icons/autonomy.svg';
import brain from '../assets/icons/brain.svg';
import details from '../assets/icons/details.svg';
import entrance from '../assets/icons/entrance.svg';
import evaluation from '../assets/icons/evaluation.svg';
import facebook from '../assets/icons/facebook.svg';
import family from '../assets/icons/family.svg';
import group from '../assets/icons/group.svg';
import health from '../assets/icons/health.svg';
import heart from '../assets/icons/heart.svg';
import instagram from '../assets/icons/instagram.svg';
import integral from '../assets/icons/integral.svg';
import listen from '../assets/icons/listen.svg';
import mimp from '../assets/icons/mimp.svg';
import movement from '../assets/icons/movement.svg';
import palette from '../assets/icons/palette.svg';
import physio from '../assets/icons/physio.svg';
import ramp from '../assets/icons/ramp.svg';
import reminiscence from '../assets/icons/reminiscence.svg';
import sunrise from '../assets/icons/sunrise.svg';
import tiktok from '../assets/icons/tiktok.svg';

const icons = {
  activities, autonomy, brain, details, entrance, evaluation,
  facebook, family, group, health, heart, instagram, integral, listen,
  mimp, movement, palette, physio, ramp, reminiscence, sunrise, tiktok,
};

interface Props {
  name: keyof typeof icons;
  size?: 16 | 20 | 24;
  label?: string;
}

const { name, size = 24, label } = Astro.props;
const Icon = icons[name];
---

<Icon
  class="pictogram"
  width={size}
  height={size}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
/>
