---
import { getImage, Image } from 'astro:assets';
import accompaniment from '../assets/approach/acompanamiento-en-la-mesa.jpg';
import portrait from '../assets/approach/portrait.png';
import portraitMobile from '../assets/approach/portrait-mobile.png';
import oliveSprig from '../assets/botanical/olive-sprig.webp';

const mobilePortrait = await getImage({ src: portraitMobile, width: 768, format: 'webp' });
const principles = [
  {
    id: 'listen',
    title: ['Escuchar', 'su historia.'],
    description: 'Conocer sus intereses, hábitos y preferencias nos ayuda a proponer una participación que tenga sentido para esa persona.',
    tabletDescription: 'Proponemos actividades según sus gustos y hábitos.',
  },
  {
    id: 'autonomy',
    title: ['Dar espacio', 'a su autonomía.'],
    description: 'Acompañar también implica dar tiempo para elegir, intentar y hacer. Ofrecemos apoyo según sus capacidades, respetando lo que puede realizar por sí misma.',
    tabletDescription: 'Le damos tiempo y apoyo para elegir y hacer a su ritmo.',
  },
  {
    id: 'family',
    title: ['Contar con', 'la familia.'],
    description: 'La familia aporta una mirada valiosa sobre su historia y su vida cotidiana. Esa información ayuda a orientar el acompañamiento y conversar sobre sus necesidades.',
    tabletDescription: 'Lo que comparte la familia nos ayuda a orientar el cuidado.',
  },
];
---

<section class="approach" id="enfoque" tabindex="-1" aria-labelledby="approach-title">
  <Image class="approach-sprig" src={oliveSprig} alt="" aria-hidden="true"
    width={320} widths={[128, 192, 256, 320]}
    sizes="(min-width: 100rem) 144px, (min-width: 48rem) 9vw, 28px" format="webp" />
  <div class="container approach-inner">
    <header class="approach-heading" data-reveal="heading">
      <h2 id="approach-title">Cuidar también es<br /><em>reconocer quién es.</em></h2>
      <p class="approach-intro-desktop">
        Sus gustos, sus decisiones y su manera de hacer las cosas forman parte del cuidado. En El
        Roble, acompañamos desde lo que cada persona necesita y también desde lo que disfruta.
      </p>
      <p class="approach-intro-compact">
        Acompañamos a cada persona desde lo que necesita y lo que disfruta.
      </p>
    </header>

    <div class="approach-layout">
      <picture class="approach-portrait" data-reveal="frame">
        <source media="(max-width: 767px)" srcset={mobilePortrait.src} />
        <Image
          data-reveal-image
          src={portrait}
          alt="Una mujer mayor con chaleco verde durante una actividad."
          format="webp"
          widths={[384, 560, 768, 1120]}
          sizes="(max-width: 1199px) 384px, (max-width: 1920px) 30vw, 560px"
        />
      </picture>

      <div class="approach-note">
        <span class="approach-note-symbol liquid-glass liquid-glass--forest-panel liquid-glass--lens" aria-hidden="true">
          <img src="/images/approach/autonomy-note.svg" alt="" loading="lazy" />
        </span>
        <p class="approach-note-desktop">Seguir eligiendo. Seguir participando.</p>
        <p><em>Seguir siendo uno mismo.</em></p>
      </div>

      {principles.map(({ id, title, description, tabletDescription }) => (
        <article class={`approach-principle approach-principle--${id} liquid-glass liquid-glass--forest-panel`} data-reveal="quiet">
          <div class="approach-principle-heading">
            <h3><span>{title[0]}</span>{' '}{title[1]}</h3>
            <span class="approach-principle-icon liquid-glass liquid-glass--forest-panel liquid-glass--lens">
              <img src={`/images/approach/${id}.svg`} alt="" loading="lazy" />
            </span>
          </div>
          <p class="approach-intro-desktop">{description}</p>
          <p class="approach-principle-tablet">{tabletDescription}</p>
        </article>
      ))}

      <div class="approach-detail">
        <Image
          src={accompaniment}
          alt="Una mujer mayor coloca una ficha en su cartón de bingo junto a una acompañante."
          format="webp"
          widths={[520, 780, 1040]}
          sizes="(max-width: 1920px) 28vw, 520px"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .approach {
    position: relative;
    isolation: isolate;
    overflow: clip;
    margin-inline: var(--section-edge);
    border-radius: 28px;
    background: var(--surface-forest);
    color: var(--color-cream);
  }

  .approach-inner {
    position: relative;
    width: calc(100% - max(.75rem, var(--page-gutter) - var(--section-edge)) * 2);
    padding-block: var(--space-section) var(--section-gap);
    padding-inline: .75rem;
  }

  .approach-sprig {
    position: absolute;
    z-index: -1;
    inset-block-start: clamp(.9rem, 2.5vw, 2.625rem);
    inset-inline-start: clamp(.375rem, 1.65vw, 1.75rem);
    inline-size: clamp(3rem, 9vw, 9rem);
    block-size: auto;
    scale: -1 1;
    rotate: -14deg;
    opacity: .47;
    pointer-events: none;
  }

  .approach-heading {
    display: grid;
    justify-items: center;
    gap: var(--space-related);
    margin-block-end: var(--section-gap);
    text-align: center;
  }

  .approach-heading h2,
  .approach-principle h3,
  .approach-note {
    color: inherit;
  }

  .approach-layout {
    display: grid;
    grid-template-areas: "portrait" "note" "listen" "autonomy" "family";
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-detail);
  }

  .approach-portrait,
  .approach-detail {
    display: block;
    position: relative;
    overflow: hidden;
  }

  .approach-portrait {
    grid-area: portrait;
    height: 418px;
    border-radius: 192px 192px 16px 16px;
  }

  .approach-portrait img,
  .approach-detail img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .approach-detail {
    display: none;
  }

  .approach-note {
    grid-area: note;
    margin-block: var(--space-detail) var(--space-related);
    font: 700 var(--text-subheading) / var(--leading-title) var(--font-display);
    text-align: center;
  }

  .approach-note-symbol,
  .approach-note-desktop,
  .approach-intro-desktop,
  .approach-principle-tablet {
    display: none;
  }

  .approach-principle {
    --glass-sheen: var(--glass-sheen-forest);
    --glass-edge: var(--glass-edge-forest);
    --glass-depth: var(--shadow-card);
    padding: var(--space-inset);
    border: 1px solid transparent;
    border-radius: 24px;
  }

  .approach-principle--listen { grid-area: listen; }
  .approach-principle--autonomy { grid-area: autonomy; }
  .approach-principle--family { grid-area: family; }

  .approach-principle-heading {
    display: flex;
    align-items: center;
    gap: var(--space-related);
  }

  .approach-principle h3 {
    font-size: var(--text-item);
    line-height: var(--leading-item);
  }

  .approach-principle-icon,
  .approach-note-symbol {
    flex: none;
    place-items: center;
    width: 34px;
    aspect-ratio: 1;
    border: 1px solid transparent;
    border-radius: 50%;
  }

  .approach-principle-icon {
    display: grid;
    order: -1;
  }
  .approach-principle-icon img, .approach-note-symbol img { filter: brightness(0) invert(.96); }

  @media (max-width: 40rem) {
    .approach-inner { padding-inline: 0; }
    .approach-sprig { inset-block-start: .25rem; inset-inline-start: .625rem; inline-size: 1.75rem; }
  }

  @media (min-width: 768px) {
    .approach-inner { padding-inline: 0; }

    .approach-layout {
      grid-template-areas: "portrait portrait portrait" "listen autonomy family" "note note note";
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--section-gap) var(--space-related);
    }

    .approach-portrait {
      justify-self: center;
      width: 384px;
      height: 472px;
    }

    .approach-portrait img {
      object-position: center 58%;
    }

    .approach-principle-heading {
      justify-content: space-between;
      gap: var(--space-detail);
    }

    .approach-principle h3 span {
      display: block;
    }

    .approach-principle-icon {
      order: 0;
    }

    .approach-principle-tablet {
      display: block;
      margin-block-start: var(--space-related);
    }

    .approach-note { margin-block: 0; }
  }

  @media (min-width: 1200px) {
    .approach-heading p {
      max-inline-size: 65ch;
    }

    .approach-intro-compact,
    .approach-principle-tablet {
      display: none;
    }

    .approach-intro-desktop,
    .approach-note-desktop {
      display: block;
    }

    .approach-layout {
      grid-template-areas: "listen portrait autonomy" "detail portrait family" ". portrait ." "note note note";
      grid-template-columns: 520fr 560fr 520fr;
      grid-template-rows: auto auto minmax(0, 1fr) auto;
      gap: var(--space-inset);
      align-items: start;
    }

    .approach-portrait {
      width: 100%;
      height: auto;
      aspect-ratio: 2 / 3;
      border-radius: 400px 400px 16px 16px;
    }

    .approach-portrait img {
      position: absolute;
      inset: 0;
      object-position: center;
    }

    .approach-detail {
      display: block;
      grid-area: detail;
      width: 100%;
      min-height: 0;
      aspect-ratio: 520 / 364;
      border-radius: 16px;
    }

    .approach-detail img {
      position: absolute;
      inset: 0;
    }

    .approach-principle:is(.approach-principle--listen, .approach-principle--autonomy) { align-self: stretch; }

    .approach-principle-icon {
      width: 48px;
    }

    .approach-principle p {
      margin-block-start: var(--space-related);
    }

    .approach-note p + p { margin-block-start: var(--space-detail); }

    .approach-note-symbol {
      display: grid;
      width: 44px;
      margin: 0 auto var(--space-related);
    }
  }
</style>
