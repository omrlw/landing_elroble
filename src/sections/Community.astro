---
import { Image } from 'astro:assets';
import { business, phoneUrl } from '../config/business';
import leaves from '../assets/lower/community-leaves.png';
import leaf from '../assets/lower/community-leaf.png';
import salon from '../assets/lower/community-salon.png';
import activity from '../assets/lower/community-activity.png';
import clay from '../assets/lower/community-clay.png';
import participant from '../assets/lower/community-participant.png';

const profileUrl = business.socialProfiles.tiktok;
const profileHandle = new URL(profileUrl).pathname.split('/').filter(Boolean).at(-1);
const emailHref = `mailto:${business.email}`;
const [street, ...locality] = business.address.split(', ');
const posters = [
  { photo: salon, description: 'Salón luminoso del centro' },
  { photo: activity, description: 'Una persona mayor arma piezas de colores' },
  { photo: clay, description: 'Manos con figuras de arcilla' },
  { photo: participant, description: 'Una mujer mayor durante una actividad' },
];
---

<div class="closing">
  <Image class="ornament beginning" src={leaves} alt="" widths={[144, 260, 520]} sizes="(min-width: 80rem) 260px, (min-width: 40rem) 143px, 92px" data-ambient="leaf" />
  <Image class="ornament accent" src={leaf} alt="" widths={[144, 260, 520]} sizes="(min-width: 80rem) 260px, 143px" data-ambient="leaf" />
  <div class="container closing-container">
    <section class="community" id="comunidad" aria-labelledby="community-heading">
      <header data-reveal>
        <h2 id="community-heading">La vida que <em>compartimos.</em></h2>
        <p class="community-description">Pequeños momentos de nuestro día a día.</p>
        <p class="community-compact-description">Entre talleres, juegos y charlas, así se vive un día en El Roble.</p>
      </header>

      <ul class="posters" aria-label="Vistas previas de la comunidad en TikTok" data-reveal="card">
        {posters.map(({ photo, description }) => (
          <li>
            <a href={profileUrl} class="poster" aria-label={`${description}. Abrir el perfil de El Roble en TikTok`} target="_blank" rel="noopener noreferrer">
              <Image
                class="poster-image"
                src={photo}
                alt=""
                widths={[240, 320, 480, 640, 768]}
                sizes="(min-width: 120rem) 344px, (min-width: 80rem) 18vw, (min-width: 40rem) 28vw, calc(100vw - 88px)"
                loading="lazy"
                decoding="async"
              />
              <span class="play" aria-hidden="true">
                <picture>
                  <source media="(min-width: 80rem)" srcset="/lower/tiktok-play.svg" />
                  <source media="(min-width: 40rem)" srcset="/lower/tiktok-play-tablet.svg" />
                  <img src="/lower/tiktok-play-mobile.svg" alt="" />
                </picture>
              </span>
              <span class="poster-profile">
                <picture>
                  <source media="(min-width: 40rem)" srcset="/lower/tiktok-small.svg" />
                  <img src="/lower/tiktok-mobile.svg" alt="" />
                </picture>
                {profileHandle}
              </span>
            </a>
          </li>
        ))}
      </ul>

      <div class="profile-links">
        <p>{profileHandle}</p>
        <a class="profile-text" href={profileUrl} target="_blank" rel="noopener noreferrer">
          Ver publicaciones en TikTok <img src="/lower/tiktok-external.svg" width="20" height="20" alt="" />
        </a>
        <a class="follow" href={profileUrl} target="_blank" rel="noopener noreferrer">
          <picture>
            <source media="(min-width: 80rem)" srcset="/lower/tiktok-action.svg" />
            <img src="/lower/tiktok-action-tablet.svg" width="22" height="22" alt="" />
          </picture>
          <span class="follow-desktop">Síguenos</span>
          <span class="follow-mobile">Ver en TikTok</span>
        </a>
      </div>
    </section>

    <footer id="contacto" class="contact" tabindex="-1" aria-label="Información de contacto">
      <div class="footer-main">
        <p class="footer-brand">
          <picture>
            <source media="(min-width: 80rem)" srcset="/lower/footer-logo.svg" />
            <source media="(min-width: 40rem)" srcset="/lower/footer-logo-tablet.svg" />
            <img src="/lower/footer-logo-mobile.svg" alt="El Roble, Centro Geronto Geriátrico" />
          </picture>
        </p>
        <div class="footer-navigation">
          <p>Cerca de ti,<br />y de tu familia.</p>
          <nav aria-label="Navegación del pie">
            <a href="#centro-de-dia">Nuestro centro</a>
            <a href="#preguntas">Preguntas frecuentes</a>
          </nav>
        </div>
        <h2 class="contact-title">Visitas y contacto</h2>
        <address>
          <a class="contact-row location" href={business.mapUrl} target="_blank" rel="noopener noreferrer">
            <span class="contact-icon"><img src="/lower/location.svg" width="15" height="20" alt="" /></span>
            <span class="contact-copy">
              <strong>Ubicación</strong>
              <span class="contact-value">{street}<span class="address-comma">, </span><span class="address-locality">{locality.join(', ')}</span></span>
            </span>
          </a>
          <a class="contact-row phone" href={phoneUrl}>
            <span class="contact-icon"><img src="/lower/phone.svg" width="20" height="20" alt="" /></span>
            <span class="contact-copy">
              <strong>Teléfono</strong>
              <span class="contact-value">{business.phone}</span>
            </span>
          </a>
          <a class="contact-row email" href={emailHref}>
            <span class="contact-icon"><img src="/lower/mail.svg" width="20" height="14" alt="" /></span>
            <span class="contact-copy">
              <strong>Correo</strong>
              <span class="contact-value">{business.email}</span>
            </span>
          </a>
        </address>
      </div>

      <div class="footer-meta">
        <div class="socials">
          <span class="social-label">Síguenos</span>
          <a href={profileUrl} target="_blank" rel="noopener noreferrer" aria-label="El Roble en TikTok"><img src="/lower/tiktok.svg" alt="" /></a>
          <span class="social-icon"><img src="/lower/instagram.svg" alt="Instagram" /></span>
          <span class="social-icon"><img src="/lower/facebook.svg" alt="Facebook" /></span>
        </div>
        <small>© 2026 El Roble</small>
        <small class="legal">Privacidad · Cookies · Términos</small>
      </div>
    </footer>
  </div>
</div>

<style>
  .closing {
    position: relative;
    overflow: clip;
    background: #233322;
    color: var(--color-cream);
    padding-block: 3.5rem 2rem;
  }
  .closing-container { width: calc(100% - 3rem); position: relative; }
  .ornament { position: absolute; height: auto; pointer-events: none; }
  .beginning { --ambient-tempo: 16s; width: 5.75rem; right: -.75rem; bottom: 24.3rem; opacity: .34; }
  .accent { --ambient-tempo: 14s; --ambient-phase: -6s; display: none; opacity: .25; }

  .community {
    position: relative;
    display: grid;
    gap: 1rem;
    padding: 1.5rem 1.25rem;
    border-radius: 2rem;
    background: linear-gradient(180deg, #fffdfc, #f7f3ec);
    color: var(--color-ink);
    box-shadow: 0 16px 32px -16px #5f371529;
  }
  .community header { display: grid; gap: .75rem; }
  .community h2 {
    margin: 0;
    font: 700 clamp(2rem, 1.75rem + 2vw, 4rem)/1.05 var(--font-display);
    color: var(--color-ink);
  }
  .community h2 em { display: block; color: var(--color-oak, #532d12); font-weight: inherit; }
  .community header p { margin: 0; font-size: clamp(1rem, .95rem + .25vw, 1.25rem); line-height: 1.5; }
  .community-description { display: none; }

  .posters { display: grid; grid-template-columns: minmax(0, 1fr); list-style: none; margin: 0; padding: 0; }
  .posters > li:not(:first-child) { display: none; }
  .poster {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 1.5rem;
    aspect-ratio: 9 / 16;
    background: var(--color-forest);
    color: var(--color-cream);
    box-shadow: 0 16px 32px -16px #14201329;
    isolation: isolate;
  }
  .poster::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(0deg, #142013b3, transparent 50%, #1420131a);
  }
  .poster-image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .play { position: absolute; top: 50%; left: 50%; translate: -50% -50%; width: 3.75rem; aspect-ratio: 1; display: grid; place-items: center; border-radius: 50%; background: linear-gradient(160deg, #fcfaf6c7, #ece4d899); box-shadow: inset 0 1px 1px #fffc, 0 8px 16px -2px #0b0d0e3d; backdrop-filter: blur(16px); }
  .play img, .poster-profile img, .profile-links img { display: block; }
  .poster-profile { position: absolute; inset: auto auto 1rem 1rem; display: inline-flex; align-items: center; gap: .5rem; color: #fcfaf5; font-size: 1rem; font-weight: 600; }
  .profile-links { display: grid; justify-items: start; }
  .profile-links p, .profile-text, .follow-desktop { display: none; }
  .profile-links .follow {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    min-height: 3rem;
    padding: .5rem 1.25rem;
    border-radius: 999px;
    color: var(--color-cream);
    background: linear-gradient(#2a4025, #1c2b1a);
    box-shadow: inset 0 1px #fff5;
    font-weight: 600;
    text-decoration: none;
  }

  .contact { margin-block-start: 2.5rem; }
  .footer-main { display: grid; gap: 1rem; }
  .footer-brand { margin: 0; }
  .footer-brand img { display: block; }
  .footer-navigation { display: none; }
  .contact-title { margin: 0; color: inherit; font: 600 1.75rem/1.12 var(--font-display); }
  address { display: grid; gap: .75rem; margin: 0; font-style: normal; }
  .contact-row { display: flex; min-width: 0; min-height: 2.75rem; gap: .75rem; align-items: start; color: inherit; }
  .contact-copy { display: grid; gap: .125rem; min-width: 0; font-size: 1rem; line-height: 1.5; }
  .contact-copy strong { font-weight: 600; color: #dbded0; }
  .contact-value { text-decoration: underline; text-underline-offset: .16em; overflow-wrap: anywhere; }
  .address-comma { display: none; }
  .address-locality { display: block; }
  .contact-icon { display: grid; flex: none; place-items: center; width: 2.25rem; aspect-ratio: 1; border-radius: 50%; background: linear-gradient(#f4f1ec16, #f4f1ec0a); }
  .footer-meta { display: flex; flex-direction: column; align-items: flex-start; gap: .5rem; border-top: 1px solid #f4f1ec2e; margin-block-start: 1.5rem; padding-block-start: 1rem; }
  .socials { display: flex; align-items: center; gap: .5rem; }
  .socials a, .social-icon { display: grid; place-items: center; width: 2.75rem; aspect-ratio: 1; border-radius: 50%; background: linear-gradient(#f4f1ec13, #f4f1ec05); }
  .social-label { display: none; }
  .footer-meta small { font-size: .875rem; }
  .legal { text-decoration: underline; text-underline-offset: .16em; }

  :is(.follow, .footer-navigation a, .socials a, .contact-icon, .play) { transition: filter var(--motion-state), background-color var(--motion-state); }
  :is(.follow, .footer-navigation a, .socials a):active { filter: brightness(.88); }
  .poster:focus-visible .play { filter: brightness(1.08); }
  .poster:active .play { filter: brightness(.92); }
  .contact-row:is(:focus-visible, :active) .contact-icon { background-color: #f4f1ec22; }

  @media (hover: hover) {
    .profile-links .follow:hover, .footer-navigation a:hover, .socials a:hover { filter: brightness(1.2); }
    .contact-row:hover .contact-icon { background-color: #f4f1ec22; }
    .profile-text:hover { text-decoration-thickness: .125em; }
  }
  @media (prefers-reduced-motion: no-preference) and (hover: hover) and (pointer: fine) {
    .poster-image { transition: scale var(--motion-photo) var(--ease-soft); }
    .play { transition-property: filter, scale; }
    .poster:hover .poster-image { scale: 1.045; }
    .poster:hover .play { scale: 1.07; }
    .poster:active .play { scale: .96; }
  }

  @media (min-width: 40rem) {
    .closing { padding-block: clamp(3.5rem, 9.375vw, 4.5rem) 2.5rem; }
    .closing-container { width: min(105rem, 100% - var(--page-gutter) * 2); }
    .beginning { width: 8.94rem; top: -1.5rem; left: -1.5rem; bottom: auto; right: auto; }
    .accent { display: block; width: 8.94rem; right: 3rem; bottom: 17.5rem; }
    .community { justify-items: center; gap: 1rem; padding: 2rem 1.5rem; border-radius: 2.5rem; }
    .community header { gap: 1rem; margin-block-end: .75rem; text-align: center; }
    .community h2 { font-size: clamp(2.25rem, 1.78rem + 2vw, 4rem); }
    .community h2 em { display: inline; }
    .community-description { display: block; }
    .community-compact-description { display: none; }
    .posters { width: min(100%, 54rem); grid-template-columns: repeat(3, minmax(0, 1fr)); align-items: end; gap: 1rem; padding-block-end: .625rem; }
    .posters > li:nth-child(-n+3) { display: block; }
    .posters > li:nth-child(2) { translate: 0 -.625rem; }
    .poster { aspect-ratio: auto; height: clamp(14rem, 38.54vw, 21rem); border-radius: 1.25rem; box-shadow: 0 24px 48px -24px #1420137a; }
    .play { width: 3rem; backdrop-filter: blur(12px); }
    .poster-profile { inset: auto 0 .75rem; justify-content: center; font-size: .875rem; font-weight: 500; }
    .profile-links { justify-items: center; }
    .profile-links p { display: block; margin: 0; font-size: 1rem; font-weight: 600; }
    .profile-links .follow { min-height: 3.5rem; padding-inline: 1.5rem; gap: .75rem; font-size: 1.125rem; }
    .profile-text { display: inline-flex; align-items: center; gap: .5rem; min-height: 2.25rem; color: inherit; font-size: 1rem; text-decoration: underline; text-underline-offset: .16em; margin-block-end: .375rem; }
    .follow-desktop { display: inline; }
    .follow-mobile { display: none; }
    .contact { border-top: 1px solid #f4f1ec2e; padding-block-start: 2rem; }
    .footer-main { grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: 1.75rem 2rem; }
    .footer-brand { grid-column: 1 / -1; }
    .footer-navigation { display: grid; gap: 1rem; }
    .footer-navigation p { margin: 0; font: 600 clamp(2rem, 1.65rem + .7vw, 2.25rem)/1.1 var(--font-display); }
    .footer-navigation nav { display: flex; flex-direction: column; gap: .5rem; }
    .footer-navigation a { display: grid; place-items: center; min-height: 3.5rem; padding: .5rem 1rem; text-align: center; border: 1px solid #f4f1ec3d; border-radius: 999px; background: linear-gradient(#f4f1ec16, #f4f1ec0a); color: inherit; text-decoration: none; font-weight: 600; }
    .contact-title { display: none; }
    address { gap: 1rem; }
    .contact-row { gap: 1rem; min-height: 3.75rem; align-items: center; }
    .contact-icon { width: 3rem; border: 1px solid #f4f1ec3d; }
    .address-comma, .address-locality { display: inline; }
    .phone { order: 1; }
    .footer-meta { flex-flow: row wrap; align-items: center; gap: 1rem; margin-block-start: 2rem; }
    .socials { gap: 1rem; }
    .social-label { display: inline; margin-inline-end: .5rem; font-size: 1rem; }
  }

  @media (min-width: 80rem) {
    .closing { padding-block: clamp(4.5rem, 5vw, 6rem) 2rem; }
    .beginning { width: clamp(9rem, 13.54vw, 16.25rem); top: -1rem; left: -2.75rem; }
    .accent { width: clamp(9rem, 13.54vw, 16.25rem); right: -8rem; top: 42%; bottom: auto; }
    .community { gap: 1.75rem; padding: clamp(2rem, 2.5vw, 3rem) clamp(1.5rem, 2.08vw, 2.5rem); }
    .community header { margin-block-end: 0; }
    .community h2 { font-size: clamp(2.75rem, 1.25rem + 2.3vw, 4rem); line-height: 1; }
    .community h2 em { display: block; }
    .posters { grid-template-columns: repeat(4, minmax(0, 1fr)); width: min(100%, 90.5rem); align-items: start; gap: 1.5rem; padding-block-end: 0; }
    .posters > li:last-child { display: block; }
    .posters > li:nth-child(even) { translate: none; margin-block-start: 1.5rem; }
    .poster { height: auto; aspect-ratio: 43 / 77; border-radius: 1.5rem; box-shadow: 0 16px 32px -16px #14201329; }
    .play { width: 4rem; backdrop-filter: blur(16px); }
    .poster-profile { inset: auto auto 1.25rem 1rem; }
    .profile-links p { font-size: 1.25rem; font-weight: 500; }
    .profile-links .follow { margin-block-start: 1.25rem; font-size: 1.375rem; }
    .contact { border: 0; margin-block-start: 4rem; padding-block-start: 0; }
    .footer-main { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(2rem, 3.333vw, 4rem); align-items: center; }
    .footer-brand { grid-column: 2; grid-row: 1; margin-inline: auto; }
    .footer-navigation { grid-column: 1; grid-row: 1; }
    .footer-navigation nav { flex-direction: row; flex-wrap: wrap; gap: .75rem; }
    .footer-navigation a { min-width: max-content; padding-inline: 1.5rem; font-weight: 400; font-size: clamp(1rem, .75rem + .42vw, 1.25rem); }
    address { grid-column: 3; grid-row: 1; }
    .contact-row { min-height: 4rem; }
    .contact-copy strong { font-weight: 500; font-size: clamp(1rem, .75rem + .42vw, 1.25rem); }
    .footer-meta { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(2rem, 3.333vw, 4rem); min-height: 4.5rem; margin-block-start: 3rem; padding-block-start: 1.5rem; }
    .footer-meta small:first-of-type { text-align: center; }
    .footer-meta .legal { text-align: right; }
  }
</style>
