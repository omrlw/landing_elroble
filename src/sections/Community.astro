---
import { Image } from 'astro:assets';
import OpticalGlass from '../components/OpticalGlass.astro';
import { business, phoneUrl } from '../config/business';
import oakBough from '../assets/botanical/community-oak-sprig.webp';
import salon from '../assets/lower/community-salon.png';
import activity from '../assets/lower/community-activity.png';
import clay from '../assets/lower/community-clay.png';
import participant from '../assets/lower/community-participant.png';

const profileUrl = business.socialProfiles.tiktok;
const profileHandle = new URL(profileUrl).pathname.split('/').filter(Boolean).at(-1);
const emailHref = `mailto:${business.email}`;
const [street, ...locality] = business.address.split(', ');
const posters = [
  { photo: salon, description: 'Salón luminoso del centro' },
  { photo: activity, description: 'Una persona mayor arma piezas de colores' },
  { photo: clay, description: 'Manos con figuras de arcilla' },
  { photo: participant, description: 'Una mujer mayor durante una actividad' },
];
---

<div class="closing">
  <div class="container closing-container">
    <section class="community" id="comunidad" aria-labelledby="community-heading">
      <Image class="community-bough" src={oakBough} alt="" aria-hidden="true"
        width={480} widths={[160, 240, 320, 480, 640]}
        sizes="(min-width: 80rem) 270px, (min-width: 40rem) 22vw, 108px" format="webp" />
      <header data-reveal="heading">
        <h2 id="community-heading">La vida que <em>compartimos.</em></h2>
        <p class="community-description">Pequeños momentos de nuestro día a día.</p>
        <p class="community-compact-description">Entre talleres, juegos y charlas, así se vive un día en El Roble.</p>
      </header>

      <ul class="posters" aria-label="Vistas previas de la comunidad en TikTok" data-reveal="posters">
        {posters.map(({ photo, description }) => (
          <li>
            <a href={profileUrl} class="poster" aria-label={`${profileHandle}. ${description}. Abrir el perfil de El Roble en TikTok`} target="_blank" rel="noopener noreferrer" data-glass-scene>
              <Image
                class="poster-image"
                data-glass-image
                src={photo}
                alt=""
                widths={[240, 320, 480, 640, 768]}
                sizes="(min-width: 120rem) 344px, (min-width: 80rem) 18vw, (min-width: 40rem) 28vw, calc(100vw - 88px)"
                loading="lazy"
                decoding="async"
              />
              <span class="play liquid-glass liquid-glass--clear liquid-glass--optical" aria-hidden="true">
                <OpticalGlass source="image" />
                <picture>
                  <source media="(min-width: 80rem)" srcset="/lower/tiktok-play.svg" />
                  <source media="(min-width: 40rem)" srcset="/lower/tiktok-play-tablet.svg" />
                  <img src="/lower/tiktok-play-mobile.svg" alt="" />
                </picture>
              </span>
              <span class="poster-profile">
                <picture>
                  <source media="(min-width: 40rem)" srcset="/lower/tiktok-small.svg" />
                  <img src="/lower/tiktok-mobile.svg" alt="" />
                </picture>
                {profileHandle}
              </span>
            </a>
          </li>
        ))}
      </ul>

      <div class="profile-links">
        <p>{profileHandle}</p>
        <a class="profile-text" href={profileUrl} target="_blank" rel="noopener noreferrer">
          Ver publicaciones en TikTok <img src="/lower/tiktok-external.svg" width="20" height="20" alt="" />
        </a>
        <a class="follow liquid-glass liquid-glass--action liquid-glass--interactive" href={profileUrl} target="_blank" rel="noopener noreferrer">
          <picture>
            <source media="(min-width: 80rem)" srcset="/lower/tiktok-action.svg" />
            <img src="/lower/tiktok-action-tablet.svg" width="22" height="22" alt="" />
          </picture>
          <span class="follow-desktop">Síguenos</span>
          <span class="follow-mobile">Ver en TikTok</span>
        </a>
      </div>
    </section>

    <footer id="contacto" class="contact" tabindex="-1" aria-label="Información de contacto">
      <div class="footer-main">
        <p class="footer-brand" data-reveal="quiet">
          <picture>
            <source media="(min-width: 80rem)" srcset="/lower/footer-logo.svg" />
            <source media="(min-width: 40rem)" srcset="/lower/footer-logo-tablet.svg" />
            <img src="/lower/footer-logo-mobile.svg" alt="El Roble, Centro Geronto Geriátrico" />
          </picture>
        </p>
        <div class="footer-navigation">
          <p>Cerca de ti,<br />y de tu familia.</p>
          <nav aria-label="Navegación del pie">
            <a class="liquid-glass liquid-glass--forest-panel liquid-glass--interactive" href="#centro-de-dia">Nuestro centro</a>
            <a class="liquid-glass liquid-glass--forest-panel liquid-glass--interactive" href="#preguntas">Preguntas frecuentes</a>
          </nav>
        </div>
        <h2 class="contact-title">Visitas y contacto</h2>
        <address>
          <a class="contact-row location" href={business.mapUrl} target="_blank" rel="noopener noreferrer">
            <span class="contact-icon liquid-glass liquid-glass--forest-panel liquid-glass--lens"><img src="/lower/location.svg" width="15" height="20" alt="" /></span>
            <span class="contact-copy">
              <strong>Ubicación</strong>
              <span class="contact-value">{street}<span class="address-comma">, </span><span class="address-locality">{locality.join(', ')}</span></span>
            </span>
          </a>
          <a class="contact-row phone" href={phoneUrl}>
            <span class="contact-icon liquid-glass liquid-glass--forest-panel liquid-glass--lens"><img src="/lower/phone.svg" width="20" height="20" alt="" /></span>
            <span class="contact-copy">
              <strong>Teléfono</strong>
              <span class="contact-value">{business.phone}</span>
            </span>
          </a>
          <a class="contact-row email" href={emailHref}>
            <span class="contact-icon liquid-glass liquid-glass--forest-panel liquid-glass--lens"><img src="/lower/mail.svg" width="20" height="14" alt="" /></span>
            <span class="contact-copy">
              <strong>Correo</strong>
              <span class="contact-value">{business.email}</span>
            </span>
          </a>
        </address>
      </div>

      <div class="footer-meta">
        <div class="socials">
          <span class="social-label">Síguenos</span>
          <a class="liquid-glass liquid-glass--forest-panel liquid-glass--lens liquid-glass--interactive" href={profileUrl} target="_blank" rel="noopener noreferrer" aria-label="El Roble en TikTok"><img src="/lower/tiktok.svg" alt="" /></a>
          <span class="social-icon liquid-glass liquid-glass--forest-panel liquid-glass--lens"><img src="/lower/instagram.svg" alt="Instagram" /></span>
          <span class="social-icon liquid-glass liquid-glass--forest-panel liquid-glass--lens"><img src="/lower/facebook.svg" alt="Facebook" /></span>
        </div>
        <small>© 2026 El Roble</small>
        <small class="legal">Privacidad · Cookies · Términos</small>
      </div>
    </footer>
  </div>
</div>

<style>
  .closing {
    position: relative;
    isolation: isolate;
    overflow: clip;
    background: var(--surface-forest);
    color: var(--color-cream);
    padding-block: var(--section-gap) var(--space-inset);
  }
  .closing-container { position: relative; }
  .community {
    --community-content-width: 54rem;
    position: relative;
    isolation: isolate;
    overflow: clip;
    display: grid;
    gap: var(--space-inset);
    padding: var(--space-inset) max(1.25rem, var(--space-inset));
    border-radius: 2rem;
    background: var(--surface-paper);
    color: var(--color-ink);
    box-shadow: var(--shadow-raised);
  }
  .community-bough {
    position: absolute;
    z-index: -1;
    inset-block-start: .125rem;
    inset-inline-end: clamp(-1.5rem, 3.1vw - 2.25rem, .75rem);
    inline-size: clamp(5rem, 19vw, 15rem);
    block-size: auto;
    rotate: -7deg;
    opacity: .62;
    pointer-events: none;
  }
  .community header {
    display: grid;
    gap: var(--space-related);
    inline-size: min(100%, var(--community-content-width));
    text-align: center;
  }
  .community h2 em { display: block; color: var(--color-oak); font-weight: inherit; }
  .community header p { justify-self: center; max-inline-size: 65ch; }
  .community-description { display: none; }

  .posters { display: grid; grid-template-columns: minmax(0, 1fr); list-style: none; margin: 0; padding: 0; }
  .posters > li:not(:first-child) { display: none; }
  .poster {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 1.5rem;
    aspect-ratio: 9 / 16;
    background: var(--color-forest);
    color: var(--color-cream);
    box-shadow: var(--shadow-card);
    isolation: isolate;
  }
  .poster::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(0deg, var(--color-dialog-backdrop) 18%, transparent 52%);
  }
  .poster-image { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .play { position: absolute; top: 50%; left: 50%; translate: -50% -50%; width: 3.75rem; aspect-ratio: 1; display: grid; place-items: center; border-radius: 50%; }
  .play.liquid-glass--optical {
    --optical-film: linear-gradient(
      color-mix(in srgb, var(--color-cream) 68%, transparent),
      color-mix(in srgb, var(--color-cream) 55%, transparent)
    );
  }
  .play img, .poster-profile img, .profile-links img { display: block; }
  .poster-profile { position: absolute; inset: auto auto 1rem 1rem; display: inline-flex; align-items: center; gap: .5rem; color: var(--color-paper); font-size: var(--text-meta); font-weight: 600; }
  .profile-links { display: grid; justify-items: center; }
  .profile-links p, .profile-text, .follow-desktop { display: none; }
  .profile-links .follow {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    min-height: var(--cta-min-height);
    padding: .5rem 1.25rem;
    border-radius: 999px;
    font-size: var(--text-cta);
    font-weight: 600;
    line-height: var(--leading-control);
    text-decoration: none;
  }

  .contact { margin-block-start: var(--section-gap); }
  .footer-main { display: grid; gap: var(--space-related); }
  .footer-brand { margin: 0; }
  .footer-brand img { display: block; }
  .footer-navigation { display: none; }
  .contact-title { margin: 0; color: inherit; font: 700 var(--text-subheading) / var(--leading-title) var(--font-display); }
  address { display: grid; gap: var(--space-related); margin: 0; font-style: normal; }
  .contact-row { display: flex; min-width: 0; min-height: 2.75rem; gap: .75rem; align-items: start; color: inherit; }
  .contact-copy { display: grid; gap: .125rem; min-width: 0; font-size: var(--text-control); }
  .contact-copy strong { font-weight: 600; color: var(--color-on-forest-muted); }
  .contact-value { text-decoration: underline; text-underline-offset: .16em; overflow-wrap: anywhere; }
  .address-comma { display: none; }
  .address-locality { display: block; }
  .contact-icon { display: grid; flex: none; place-items: center; width: 2.25rem; aspect-ratio: 1; border-radius: 50%; }
  .footer-meta { display: flex; flex-direction: column; align-items: flex-start; gap: var(--space-detail); border-top: 1px solid var(--color-on-forest-line); margin-block-start: var(--section-gap); padding-block-start: var(--space-related); }
  .socials { display: flex; align-items: center; gap: .5rem; }
  .socials a, .social-icon { display: grid; place-items: center; width: 2.75rem; aspect-ratio: 1; border-radius: 50%; }
  .social-label { display: none; }
  .footer-meta small { font-size: var(--text-meta); }
  .legal { text-decoration: underline; text-underline-offset: .16em; }

  .poster:focus-visible { outline-color: var(--color-forest); }
  .poster:focus-visible .play, .contact-row:focus-visible .contact-icon { --glass-wash: var(--glass-lift); }
  .poster:active .play, .contact-row:active .contact-icon { --glass-wash: var(--glass-press); }

  @media (hover: hover) {
    .poster:hover:not(:active) .play, .contact-row:hover:not(:active) .contact-icon { --glass-wash: var(--glass-lift); }
    .profile-text:hover { text-decoration-thickness: .125em; }
  }
  @media (prefers-reduced-motion: no-preference) {
    :is(.play, .contact-icon) { transition: --glass-wash var(--glass-motion) var(--glass-ease); }
  }

  @media (min-width: 40rem) {
    .community { justify-items: center; border-radius: 2.5rem; }
    .community h2 em { display: inline; }
    .community-description { display: block; }
    .community-compact-description { display: none; }
    .posters { width: min(100%, var(--community-content-width)); grid-template-columns: repeat(3, minmax(0, 1fr)); align-items: end; gap: var(--space-related); padding-block-end: .625rem; }
    .posters > li:nth-child(-n+3) { display: block; }
    .posters > li:nth-child(2) { translate: 0 -.625rem; }
    .poster { aspect-ratio: auto; height: clamp(14rem, 38.54vw, 21rem); border-radius: 1.25rem; }
    .play { width: 3rem; }
    .poster-profile { inset: auto 0 .75rem; justify-content: center; }
    .profile-links p { display: block; margin: 0; font-size: var(--text-control); font-weight: 600; }
    .profile-links .follow { padding-inline: 1.5rem; gap: .75rem; margin-block-start: var(--space-detail); }
    .profile-text { display: inline-flex; align-items: center; gap: .5rem; min-height: 2.25rem; color: inherit; font-size: var(--text-control); text-decoration: underline; text-underline-offset: .16em; }
    .follow-desktop { display: inline; }
    .follow-mobile { display: none; }
    .contact { border-top: 1px solid var(--color-on-forest-line); padding-block-start: var(--space-inset); }
    .footer-main { grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: var(--space-inset) var(--section-gap); }
    .footer-brand { grid-column: 1 / -1; }
    .footer-navigation { display: grid; gap: var(--space-related); }
    .footer-navigation p { margin: 0; font: 700 var(--text-subheading) / var(--leading-title) var(--font-display); }
    .footer-navigation nav { display: flex; flex-direction: column; gap: .5rem; }
    .footer-navigation a { --glass-edge: var(--glass-edge-forest); display: grid; place-items: center; min-height: 3.5rem; padding: .5rem 1rem; text-align: center; border: 1px solid transparent; border-radius: 999px; text-decoration: none; font-size: var(--text-control); font-weight: 600; }
    .contact-title { display: none; }
    .contact-row { gap: 1rem; min-height: 3.75rem; align-items: center; }
    .contact-icon { width: 3rem; border: 1px solid transparent; }
    .address-comma, .address-locality { display: inline; }
    .phone { order: 1; }
    .footer-meta { flex-flow: row wrap; align-items: center; gap: var(--space-related); }
    .socials { gap: 1rem; }
    .social-label { display: inline; margin-inline-end: .5rem; font-size: var(--text-control); }
  }

  @media (min-width: 80rem) {
    .community { --community-content-width: 90.5rem; }
    .community h2 em { display: block; }
    .posters { grid-template-columns: repeat(4, minmax(0, 1fr)); align-items: start; gap: var(--space-inset); padding-block-end: 0; }
    .posters > li:last-child { display: block; }
    .posters > li:nth-child(even) { translate: none; margin-block-start: 1.5rem; }
    .poster { height: auto; aspect-ratio: 43 / 77; border-radius: 1.5rem; }
    .play { width: 4rem; }
    .poster-profile { inset: auto auto 1.25rem 1rem; }
    .contact { border: 0; padding-block-start: 0; }
    .footer-main { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--section-gap); align-items: center; }
    .footer-brand { grid-column: 2; grid-row: 1; margin-inline: auto; }
    .footer-navigation { grid-column: 1; grid-row: 1; }
    .footer-navigation nav { flex-direction: row; flex-wrap: wrap; gap: .75rem; }
    .footer-navigation a { min-width: max-content; padding-inline: 1.5rem; }
    address { grid-column: 3; grid-row: 1; }
    .contact-row { min-height: 4rem; }
    .footer-meta { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--section-gap); }
    .footer-meta small:first-of-type { text-align: center; }
    .footer-meta .legal { text-align: right; }
  }
</style>
