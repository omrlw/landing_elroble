---
import { Image } from 'astro:assets';
import BotanicalPattern from '../components/BotanicalPattern.astro';
import Cta from '../components/Cta.astro';
import OpticalGlass from '../components/OpticalGlass.astro';
import oakTwig from '../assets/botanical/faq-oak-twig.webp';
import oliveSprig from '../assets/botanical/olive-sprig.webp';
import { business } from '../config/business';

const questions = [
  {
    title: '¿El Roble es centro de día o residencia?',
    compact: '¿Centro de día o residencia?',
    answer: 'El Roble es un centro de día. Tu familiar participa en actividades, recibe acompañamiento durante la mañana y vuelve a casa al finalizar la jornada.',
  },
  {
    title: '¿Qué horarios y modalidades ofrecen?',
    compact: '¿Qué horarios ofrecen?',
    answer: `${business.schedule} Las modalidades incluyen actividades, movimiento suave y acompañamiento.`,
  },
  {
    title: '¿Qué incluye la atención?',
    answer: 'Incluye actividades de memoria y reminiscencia, talleres creativos, motricidad fina, juegos, convivencia, movimiento suave y acompañamiento especializado durante la mañana. Cualquier necesidad adicional se conversa previamente con la familia.',
  },
  {
    title: '¿Puede participar una persona con deterioro cognitivo?',
    compact: '¿Y si hay deterioro cognitivo?',
    tablet: '¿Puede participar alguien con deterioro cognitivo?',
    answer: 'Antes de comenzar realizamos una evaluación para conocer las necesidades y capacidades de tu familiar, adaptar su participación y confirmar si El Roble es una alternativa adecuada.',
  },
  {
    title: '¿Podemos conocer el centro antes de decidir?',
    compact: '¿Podemos conocer el centro?',
    answer: 'Sí. Puedes coordinar una visita para recorrer los ambientes, conocer al equipo, contarnos sobre tu familiar y resolver tus dudas antes de elegir una modalidad.',
  },
  {
    title: '¿Cómo es una mañana en El Roble?',
    compact: '¿Cómo es una mañana aquí?',
    answer: 'La jornada combina actividades cognitivas, creativas y de movimiento con momentos para conversar, compartir y descansar. Adaptamos la participación al ritmo, los intereses y las capacidades de cada persona.',
  },
  {
    title: '¿Cómo adaptan las actividades?',
    answer: 'Partimos de la historia, los intereses y las capacidades de cada persona. Proponemos formas de participar que respeten su ritmo, su autonomía y aquello que disfruta hacer.',
  },
  {
    title: '¿Qué papel tiene la familia?',
    answer: 'La familia comparte información sobre hábitos, preferencias y necesidades. Esa mirada nos ayuda a orientar el acompañamiento y mantener una conversación cercana.',
  },
];

const columnBreak = Math.ceil(questions.length / 2);
const questionColumns = [questions.slice(0, columnBreak), questions.slice(columnBreak)];
---

<section class="faq" id="preguntas" tabindex="-1" aria-labelledby="faq-heading">
  <BotanicalPattern />
  <div class="container faq-container">
    <header class="faq-heading" data-reveal="heading">
      <h2 id="faq-heading">Lo importante,<br /><em>antes de la visita.</em></h2>
      <Image class="faq-sprig" src={oakTwig} alt="" aria-hidden="true"
        width={280} widths={[96, 144, 192, 280]}
        sizes="(min-width: 40rem) clamp(76px, 9vw, 144px), 66px" format="webp" />
      <p>Lo esencial para conocer cómo funciona El Roble, qué incluye cada modalidad y cómo acompañamos a tu familiar.</p>
    </header>

    <div class="questions" data-glass-scene>
      {questionColumns.map((column, index) => (
        <div class="question-column">
          {index === questionColumns.length - 1 && (
            <Image class="faq-branch" src={oliveSprig} alt="" aria-hidden="true" data-glass-image width={384}
              widths={[192, 256, 384]} sizes="clamp(144px, 28vw, 368px)" format="webp" />
          )}
          {column.map(({ title, compact, tablet, answer }) => (
            <details name={`preguntas-el-roble-${index + 1}`}>
              <summary>
                {index === questionColumns.length - 1 && <OpticalGlass class="faq-row-lens" source="branch" />}
                <span class:list={['question-title', { 'has-compact': compact, 'has-tablet': tablet }]}>
                  <span class="full-question">{title}</span>
                  {compact && <span class="compact-question">{compact}</span>}
                  {tablet && <span class="tablet-question">{tablet}</span>}
                </span>
                <span class="question-icon" aria-hidden="true">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                    <path d="M3 8h10" />
                    <path class="question-icon__vertical" d="M8 3v10" />
                  </svg>
                </span>
              </summary>
              <p class="answer">{answer}</p>
            </details>
          ))}
        </div>
      ))}
    </div>

    <div class="faq-close">
      <h3>¿Tienes otra pregunta?</h3>
      <Cta label="Agendar una visita" icon="/lower/faq-arrow.svg" />
    </div>
  </div>
</section>

<style>
  .faq {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding-block: var(--space-section) var(--section-gap);
    color: var(--color-ink);
  }
  .faq-container { position: relative; }
  .faq-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-detail);
    align-items: center;
    margin-block-end: var(--section-gap);
  }
  h2 em { color: var(--color-oak); }
  .faq-sprig {
    inline-size: clamp(3.5rem, 17vw, 4.125rem);
    block-size: auto;
    margin-inline-end: .375rem;
    rotate: -12deg;
    opacity: .76;
    pointer-events: none;
  }
  .faq-heading p, .answer { max-inline-size: 65ch; color: var(--color-text); }
  .faq-heading p, .faq-close h3 { display: none; }
  .questions {
    --faq-row-gap: clamp(.75rem, .55rem + .42vw, 1rem);
    display: grid;
    align-items: start;
    gap: var(--faq-row-gap) clamp(1.5rem, 4.5vw, 4rem);
  }
  .question-column { position: relative; display: grid; gap: var(--faq-row-gap); }
  .faq-branch {
    position: absolute;
    z-index: -1;
    inset-inline-end: calc(var(--page-gutter) * -.61);
    inset-block-end: -2.5rem;
    inline-size: clamp(9rem, 28vw, 23rem);
    block-size: auto;
    opacity: .28;
    mask-image: linear-gradient(100deg, transparent 7%, #000 42%);
    pointer-events: none;
  }

  details {
    --question-gutter: clamp(.75rem, .55rem + .85vw, 1.5rem);
    position: relative;
    isolation: isolate;
    min-inline-size: 0;
    border-radius: 1rem;
    overflow: clip;
  }
  details:not([open])::after {
    position: absolute;
    inset: auto var(--question-gutter) 0;
    block-size: 1px;
    background: var(--glass-divider);
    pointer-events: none;
    content: '';
  }
  details::before {
    position: absolute;
    z-index: -1;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(90deg,
      color-mix(in srgb, var(--color-paper) 66%, transparent),
      color-mix(in srgb, var(--color-paper) 35%, transparent) 73%,
      color-mix(in srgb, var(--color-paper) 13%, transparent)
    );
    box-shadow: var(--optical-bevel);
    opacity: 0;
    pointer-events: none;
    content: '';
  }
  details[open]::before { opacity: 1; }
  details:has(> summary:active) .question-icon { background-color: rgb(53 43 31 / 10%); }

  summary > :global(.faq-row-lens) {
    --optical-sample-background: var(--color-cream);
    --optical-film: linear-gradient(155deg, rgb(255 255 255 / 31%), transparent 80%);
    --optical-rim: inset 0 1px 1px rgb(255 255 255 / 78%), inset -1px 0 1px rgb(64 54 40 / 26%);
    display: none;
    z-index: -1;
    inset-inline-start: auto;
    inline-size: clamp(5rem, 31%, 11rem);
    clip-path: inset(0 round 0 1rem 1rem 0);
    mask-image: linear-gradient(to right, transparent, #000 58%);
  }
  details[open] :global(.faq-row-lens) { display: block; }

  summary {
    min-block-size: clamp(4.25rem, 3.55rem + 1.3vw, 5rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-related);
    align-items: center;
    padding: clamp(.875rem, .7rem + .65vw, 1.25rem) var(--question-gutter);
    border-radius: inherit;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  summary::marker { content: ''; }
  summary:focus-visible { outline-color: var(--color-forest); outline-offset: -2px; }
  .question-title { font: 700 var(--text-item) / var(--leading-item) var(--font-display); text-wrap: pretty; }
  .has-compact .full-question, .tablet-question { display: none; }
  .question-icon {
    display: grid;
    place-items: center;
    inline-size: clamp(2.25rem, 2.1rem + .45vw, 2.625rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 26% 18%, rgb(255 255 255 / 72%), transparent 64%);
    box-shadow: var(--optical-bevel), inset 0 -3px 5px -4px rgb(77 67 48 / 24%);
  }
  details[open] .question-icon {
    background-color: rgb(255 255 255 / 49%);
    box-shadow: var(--optical-bevel), 0 4px 10px -6px rgb(39 30 21 / 44%);
  }
  .question-icon__vertical { transform-origin: center; }
  [open] .question-icon__vertical { scale: 1 0; }
  .answer { padding: .15rem max(var(--question-gutter), 16%) var(--space-inset) var(--question-gutter); }
  .faq-close {
    display: grid;
    justify-items: start;
    gap: var(--space-related);
    margin-block-start: var(--section-gap);
  }

  @media (min-width: 40rem) {
    .faq-heading { grid-template-columns: minmax(0, 1.25fr) auto minmax(0, 1fr); gap: var(--section-gap); }
    .faq-sprig { inline-size: clamp(4.75rem, 9vw, 9rem); margin-inline-end: 0; }
    .faq-heading p, .faq-close h3 { display: block; }
    .questions { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .has-compact .full-question, .tablet-question { display: inline; }
    .has-tablet .full-question, .compact-question { display: none; }
    .faq-close { justify-items: center; text-align: center; }
  }

  @media (min-width: 80rem) {
    .has-tablet .full-question { display: inline; }
    .tablet-question { display: none; }
  }

  @media (hover: hover) and (pointer: fine) {
    details:not([open]):has(> summary:hover)::before { opacity: .55; }
    summary:hover .question-icon { background-color: rgb(255 255 255 / 55%); }
  }

  @media (prefers-reduced-transparency: reduce) {
    details[open]::before { background: var(--glass-clear); }
    .faq-branch, details[open] :global(.faq-row-lens) { display: none; }
  }
  @media (forced-colors: active) {
    summary, .question-icon { border: 1px solid CanvasText; }
  }

  @media (prefers-reduced-motion: no-preference) {
    details::before { transition: opacity var(--glass-motion) var(--glass-ease); }
    .question-icon { transition: background-color var(--glass-motion) var(--glass-ease), box-shadow var(--glass-motion) var(--glass-ease); }
    .question-icon__vertical { transition: scale var(--glass-motion) var(--glass-ease); }

    @supports (interpolate-size: allow-keywords) and selector(::details-content) {
      details { interpolate-size: allow-keywords; }
      details::details-content {
        block-size: 0;
        overflow: clip;
        opacity: 0;
        transition: block-size var(--glass-motion) var(--glass-ease),
          opacity var(--motion-state) var(--glass-ease), content-visibility var(--glass-motion) allow-discrete;
      }
      details[open]::details-content { block-size: auto; opacity: 1; }
    }
  }
</style>
