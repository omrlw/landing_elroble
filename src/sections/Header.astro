---
import { Image } from 'astro:assets';
import Cta from '../components/Cta.astro';
import ActionIcon from '../components/ActionIcon.astro';
import OpticalGlass from '../components/OpticalGlass.astro';
import { business, phoneUrl } from '../config/business';
import logo from '../assets/opening/brand.png';

const primaryLinks = [
  { label: 'Historia', href: '#historia' },
  { label: 'Centro de día', href: '#centro-de-dia' },
  { label: 'Enfoque', href: '#enfoque' },
  { label: 'Programa', href: '#programa' },
];

const moreLinks = [
  { label: 'Recorrido', href: '#recorrido' },
  { label: 'Testimonios', href: '#testimonios' },
  { label: 'Preguntas frecuentes', href: '#preguntas' },
  { label: 'Contacto', href: '#contacto' },
];
const glassControl = 'liquid-glass liquid-glass--clear liquid-glass--interactive';
const glassLink = `${glassControl} liquid-glass--underlay`;
---

<header class="site-header" data-site-header>
  <div class="container site-header__inner">
    <a class="site-header__brand" href="#inicio" aria-label="El Roble, inicio">
      <Image src={logo} alt="El Roble, centro geronto geriátrico" width={500} format="webp" quality={92} loading="eager" />
    </a>

    <nav class="site-nav" id="opening-menu" popover="auto" aria-label="Navegación principal">
      <div class="site-nav__drawer-head">
        <a class="site-header__brand site-nav__drawer-brand" href="#inicio" aria-label="El Roble, inicio">
          <Image src={logo} alt="El Roble, centro geronto geriátrico" width={500} format="webp" quality={92} loading="eager" />
        </a>
        <button class:list={['site-nav__close', glassControl]} type="button" aria-label="Cerrar menú" data-nav-close>
          <ActionIcon name="close" size={20} />
        </button>
      </div>

      <div class="site-nav__body">
        <p class="site-nav__group-title" aria-hidden="true">El centro</p>
        <div class="site-nav__rail" data-nav-rail>
          <OpticalGlass class="site-nav__lens" indicator />
          <ul class="site-nav__list" role="list">
            {primaryLinks.map(({ label, href }) => (
              <li>
                <a class:list={['site-nav__link', glassLink]} href={href}>{label}</a>
              </li>
            ))}

            <li class="site-nav__group" data-nav-group>
              <button
                class:list={['site-nav__trigger', glassLink]}
                type="button"
                aria-expanded="false"
                aria-controls="site-nav-submenu"
                data-nav-trigger
              >
                <span>Nosotros</span>
                <ActionIcon class="site-nav__chevron" name="chevron-down" size={14} />
              </button>

              <p class="site-nav__group-title site-nav__group-title--spaced" aria-hidden="true">Conoce más</p>

              <div class="site-nav__panel-wrap" id="site-nav-submenu" data-nav-panel>
                <div class="site-nav__dropdown">
                  <OpticalGlass class="site-nav__dropdown-lens" />
                  <ul class="site-nav__sublist" role="list">
                    {moreLinks.map(({ label, href }) => (
                      <li>
                        <a class:list={['site-nav__sublink', glassLink]} href={href}>{label}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </li>
          </ul>
        </div>

        <div class="site-nav__schedule">
          <span class="site-nav__schedule-icon liquid-glass liquid-glass--clear liquid-glass--lens" aria-hidden="true">
            <ActionIcon name="clock" size={20} />
          </span>
          <div class="site-nav__schedule-copy">
            <strong>Horario de atención</strong>
            <span>{business.schedule}</span>
          </div>
        </div>
      </div>

      <div class="site-nav__drawer-foot">
        <Cta class="site-nav__drawer-cta" icon="whatsapp" />
        <a class:list={['site-nav__drawer-phone', glassControl]} href={phoneUrl}>
          <ActionIcon class="site-header__phone-icon" name="phone" size={20} />
          <span>{business.phone}</span>
        </a>
      </div>
    </nav>

    <div class="site-header__actions">
      <a class:list={['site-header__phone', glassLink]} href={phoneUrl} aria-label={`Llamar al ${business.phone}`}>
        <ActionIcon class="site-header__phone-icon" name="phone" />
        <span class="site-header__phone-number">{business.phone}</span>
        <span class="site-header__phone-short">Llamar</span>
      </a>

      <button
        class:list={['site-header__menu', glassControl]}
        type="button"
        popovertarget="opening-menu"
        aria-controls="opening-menu"
        aria-expanded="false"
        aria-label="Abrir menú de navegación"
      >
        <span class="site-header__menu-label">Menú</span>
        <ActionIcon name="menu" size={20} />
      </button>

      <Cta
        class="site-header__cta"
        variant="compact"
        icon="whatsapp"
        label="Agendar una visita"
        compactLabel="Agendar"
      />
    </div>
  </div>
</header>

<script>
  import { setupHeader } from '../scripts/header';
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  if (header) setupHeader(header);
</script>

<style>
  @property --site-header-expanded {
    syntax: '<number>';
    inherits: true;
    initial-value: 1;
  }

  .site-header {
    --site-header-expanded: 1;
    --header-hero-height: 4.875rem;
    --header-height-growth: calc((var(--header-hero-height) - var(--header-compact-height)) * var(--site-header-expanded));
    --header-hero-control-growth: 0.25rem;
    --header-control-growth: calc(var(--header-hero-control-growth) * var(--site-header-expanded));
    --header-control-height: calc(var(--control-size) + var(--header-control-growth));
    --header-compact-text: var(--text-meta);
    --header-hero-text: var(--text-control);
    --header-text: calc(var(--header-compact-text) + (var(--header-hero-text) - var(--header-compact-text)) * var(--site-header-expanded));
    --header-compact-logo: 4.375rem;
    --header-logo-growth: 0.875rem;
    --header-compact-cta-medallion: 1.4375rem;
    position: sticky;
    inset-block-start: 0;
    z-index: 30;
    /* Keep the hero in place while the sticky bar changes height. */
    margin-block-end: calc(var(--header-hero-height) - var(--header-compact-height) - var(--header-height-growth));
    border-block-end: 1px solid transparent;
    background: var(--color-cream);
    box-shadow: 0 0.3125rem 0.875rem -0.625rem
      color-mix(in srgb, var(--color-ink) calc((1 - var(--site-header-expanded)) * 22%), transparent);
  }

  @media not (prefers-reduced-transparency: reduce) {
    @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
      .site-header { background: none; }
      .site-header::before {
        position: absolute;
        z-index: -1;
        inset: 0;
        background: color-mix(in srgb, var(--color-cream) calc(82% + 18% * var(--site-header-expanded)), transparent);
        -webkit-backdrop-filter: blur(6px);
        backdrop-filter: blur(6px);
        pointer-events: none;
        content: '';
      }
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .site-header { transition: --site-header-expanded var(--motion-exit) ease-out; }
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.375rem;
    min-block-size: calc(var(--header-compact-height) + var(--header-height-growth));
    padding-block: 0.625rem;
  }

  .site-header__brand {
    flex: 0 1 auto;
    min-inline-size: 0;
    display: flex;
    align-items: center;
    inline-size: calc(var(--header-compact-logo) + var(--header-logo-growth) * var(--site-header-expanded));
    min-block-size: var(--control-size);
    border-radius: 0.5rem;
    transition: opacity var(--motion-state) var(--ease-soft);
  }

  .site-header__brand img {
    display: block;
    inline-size: 100%;
    block-size: auto;
  }

  .site-header__brand:active { opacity: 0.78; }

  .site-header__brand:focus-visible {
    outline: 2px solid var(--color-forest);
    outline-offset: 2px;
  }

  .site-header__actions {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    min-inline-size: 0;
  }

  .site-header__phone {
    --glass-rest-visibility: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    min-block-size: var(--header-control-height);
    padding-inline: var(--space-detail);
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    color: var(--color-ink);
    font-size: var(--header-text);
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
  }

  .site-header__phone-icon { color: var(--color-oak); }

  .site-header__phone-number { display: none; }
  .site-header__phone-short { display: inline; }

  .site-header__actions :global(.site-header__cta) {
    --cta-height: var(--header-control-height);
    --cta-padding: 0.375rem 0.375rem 0.375rem 0.625rem;
    --cta-gap: 0.375rem;
    --cta-medallion-size: calc(var(--header-compact-cta-medallion) + var(--header-control-growth) / 2);
    font-size: var(--header-text);
  }

  .site-header__actions :global(.site-header__cta .cta-label--full) { display: none; }
  .site-header__actions :global(.site-header__cta .cta-label--compact) { display: inline; }

  .site-header__menu {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    min-inline-size: var(--header-control-height);
    min-block-size: var(--header-control-height);
    padding-inline: var(--space-detail);
    border-radius: var(--radius-pill);
    color: var(--color-forest);
    font-size: var(--text-control);
    font-weight: 600;
    line-height: 1;
  }

  .site-header__menu-label {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  :is(.site-header__phone, .site-header__menu, .site-nav__close,
      .site-nav__drawer-phone, .site-nav__link, .site-nav__sublink, .site-nav__trigger) {
    --glass-depth: 0 0 transparent;
  }

  .site-header__menu[aria-expanded="true"],
  .site-nav__trigger[aria-expanded="true"] { --glass-edge: var(--glass-edge-selected); }

  @media (hover: hover) {
    .site-header__brand:hover { opacity: 0.88; }
  }

  /* ── Mobile & Tablet Drawer (< 73rem) ─────────────────────────────────── */
  .site-nav {
    --drawer-px: var(--space-inset);
    --color-surface-line: var(--glass-divider);
    position: fixed;
    inset: 0;
    inline-size: 100%;
    block-size: 100dvh;
    max-block-size: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--surface-paper);
    color: var(--color-ink);
    flex-direction: column;
    overflow: hidden;
  }

  .site-nav:popover-open {
    display: flex;
  }

  .site-nav::backdrop {
    background: color-mix(in srgb, var(--color-ink) 36%, transparent);
  }

  .site-nav__drawer-head {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-block-size: calc(var(--header-compact-height) + var(--header-height-growth) + 1px);
    padding: 0.625rem var(--drawer-px);
    border-block-end: 1px solid var(--color-surface-line);
  }

  .site-nav__drawer-brand {
    inline-size: calc(var(--header-compact-logo) + var(--header-logo-growth) * var(--site-header-expanded));
  }

  .site-nav__close {
    display: grid;
    place-items: center;
    flex: none;
    min-inline-size: var(--header-control-height);
    min-block-size: var(--header-control-height);
    border-radius: var(--radius-pill);
    color: var(--color-forest);
  }

  .site-nav__body {
    flex: 1 1 auto;
    min-block-size: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: var(--space-inset) var(--drawer-px);
  }

  .site-nav__group-title {
    margin: 0 0 0.25rem;
    padding-inline: var(--space-detail);
    color: var(--color-oak);
    font-family: var(--font-display);
    font-size: var(--text-item);
    font-style: italic;
    font-weight: 700;
    line-height: var(--leading-item);
  }

  .site-nav__group-title--spaced {
    margin-block-start: var(--space-detail);
    padding-block-start: var(--space-control-gap);
    border-block-start: 1px solid var(--color-surface-line);
  }

  .site-nav__list,
  .site-nav__sublist {
    display: grid;
    gap: 0.125rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-nav__trigger {
    display: none;
  }

  .site-nav__rail > :global(.site-nav__lens),
  .site-nav__dropdown > :global(.site-nav__dropdown-lens) { display: none; }

  .site-nav__link,
  .site-nav__sublink {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-block-size: var(--control-size);
    padding-inline: var(--space-detail);
    border-radius: var(--radius-pill);
    color: var(--color-ink);
    font-size: var(--text-control);
    font-weight: 500;
    line-height: 1.35;
    text-decoration: none;
  }

  :is(.site-nav__link, .site-nav__sublink)[aria-current="location"],
  .site-nav__group[data-current-group] > .site-nav__trigger {
    --glass-visible: 1;
    --glass-fill: linear-gradient(165deg, rgb(255 255 255 / 72%), rgb(255 255 255 / 20%));
    --glass-lift: rgb(255 255 255 / 12%);
    --glass-depth: var(--glass-shadow-soft);
    --glass-edge: var(--glass-edge-selected);
    --glass-hover-edge: var(--glass-edge-selected);
    color: var(--color-forest);
    text-shadow: .018em 0 currentColor;
  }

  :is(.site-nav__link, .site-nav__sublink)[aria-current="location"]:active,
  .site-nav__group[data-current-group] > .site-nav__trigger:active { --glass-wash: var(--glass-press); }

  .site-nav__schedule {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    margin-block-start: 0.75rem;
    padding: var(--space-control-gap) var(--space-detail) 0;
    border-block-start: 1px solid var(--color-surface-line);
  }

  .site-nav__schedule-icon {
    display: grid;
    place-items: center;
    flex: none;
    inline-size: 2rem;
    block-size: 2rem;
    border-radius: 50%;
    color: var(--color-oak);
  }

  .site-nav__schedule-copy {
    display: grid;
    gap: 0.125rem;
    font-size: var(--text-meta);
    line-height: 1.45;
  }

  .site-nav__schedule-copy strong {
    color: var(--color-ink);
    font-weight: 600;
  }

  .site-nav__schedule-copy span {
    color: var(--color-text);
  }

  .site-nav__drawer-foot {
    flex: 0 0 auto;
    display: grid;
    gap: var(--space-detail);
    padding: var(--space-control-gap) var(--drawer-px) max(var(--space-inset), env(safe-area-inset-bottom));
    border-block-start: 1px solid var(--color-surface-line);
    background: var(--surface-paper);
  }

  .site-nav__drawer-foot :global(.site-nav__drawer-cta) {
    --cta-width: 100%;
    --cta-justify: center;
  }

  .site-nav__drawer-foot :global(.site-nav__drawer-cta .cta-icon svg) {
    inline-size: 1.25rem;
    block-size: 1.25rem;
  }

  .site-nav__drawer-phone {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-detail);
    inline-size: 100%;
    min-block-size: var(--control-size);
    padding-inline: 1rem;
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    color: var(--color-ink);
    font-size: var(--text-control);
    font-weight: 600;
    text-decoration: none;
  }

  @media (min-width: 23.5rem) {
    .site-header {
      --header-compact-logo: clamp(5.375rem, 23vw, 9.25rem);
    }
    .site-header__inner { gap: var(--space-detail); }
    .site-header__actions { gap: 0.375rem; }
    .site-header__phone {
      padding-inline: 0.6875rem;
      gap: 0.3125rem;
    }
  }

  @media (min-width: 25.5rem) {
    .site-header__actions :global(.site-header__cta) { --cta-padding: 0.375rem 0.375rem 0.375rem 0.75rem; }
  }

  @media (width < 40rem) {
    .site-header {
      --header-compact-logo: clamp(7.75rem, 35vw, 9.125rem);
      --header-logo-growth: 1.125rem;
    }

    .site-nav__drawer-head { padding-inline: var(--page-gutter); }
    .site-header__phone { display: none; }

    .site-header__actions :global(.site-header__cta) {
      --cta-height: 4.25rem;
      --cta-width: var(--cta-height);
      --cta-padding: 0;
      --cta-justify: center;
      --cta-medallion-size: 2.375rem;
      --glass-fill: linear-gradient(
        155deg,
        color-mix(in srgb, var(--color-action) 82%, var(--color-paper)),
        var(--color-action) 65%,
        var(--color-forest)
      );
      --glass-highlight: var(--glass-bevel-dark);
      --glass-depth: var(--shadow-raised);
      position: fixed;
      inset-inline-end: calc(var(--space-inset) + env(safe-area-inset-right, 0px));
      inset-block-end: calc(var(--space-inset) + env(safe-area-inset-bottom, 0px));
    }

    .site-header__actions :global(.site-header__cta .cta-label--full) {
      display: block;
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }
    .site-header__actions :global(.site-header__cta .cta-label--compact) { display: none; }

    .site-header__actions :global(.site-header__cta .cta-icon) {
      background: none;
      box-shadow: none;
    }

    .site-header__actions :global(.site-header__cta .cta-icon svg) {
      inline-size: var(--cta-medallion-size);
      block-size: var(--cta-medallion-size);
    }

    .site-header:has(.site-nav:popover-open) :global(.site-header__cta) { visibility: hidden; }
  }

  /* ── Tablet (>= 40rem / 640px & >= 48rem / 768px) ───────────────────────── */
  @media (min-width: 40rem) and (max-width: 72.999rem) {
    .site-nav {
      --drawer-px: 1.75rem;
      inset: 0 0 0 auto;
      inline-size: min(27.5rem, 100vw);
      border-start-start-radius: var(--radius-card);
      border-end-start-radius: var(--radius-card);
      box-shadow: var(--shadow-raised);
    }
  }

  @media (min-width: 42rem) and (max-width: 72.999rem) {
    .site-header {
      --header-hero-height: 5.375rem;
      --header-hero-control-growth: 0.375rem;
      --header-compact-logo: clamp(9.5rem, 6.5rem + 6vw, 11.25rem);
      --header-logo-growth: 1.25rem;
      --header-compact-cta-medallion: 1.625rem;
    }
    .site-header__inner { gap: var(--space-control-gap); }
    .site-header__actions { gap: 0.625rem; }
    .site-header__phone { padding-inline: 0.9375rem; }
    .site-header__actions :global(.site-header__cta) {
      --cta-padding: 0.375rem 0.5rem 0.375rem 1.0625rem;
    }
    .site-header__actions :global(.site-header__cta .cta-label--full) { display: inline; }
    .site-header__actions :global(.site-header__cta .cta-label--compact) { display: none; }
  }

  @media (min-width: 48rem) and (max-width: 72.999rem) {
    .site-header__menu {
      padding-inline: 0.875rem;
      border: 1px solid transparent;
    }
    .site-header__menu-label {
      position: static;
      inline-size: auto;
      block-size: auto;
      overflow: visible;
      clip-path: none;
    }
  }

  /* ── Drawer open/close animation (< 73rem) ──────────────────────────────── */
  @media (width < 73rem) {
    :global(html:has(#opening-menu:popover-open)) {
      overflow: hidden;
    }
  }

  @media (width < 73rem) and (prefers-reduced-motion: no-preference) {
    :is(.site-nav__close, .site-header__menu) :global(svg) {
      transition: scale var(--motion-state) var(--ease-soft);
    }
    :is(.site-nav__close, .site-header__menu):active :global(svg) {
      scale: 0.85;
      transition-duration: var(--motion-press);
    }

    .site-nav[popover]:not([data-drawer-closing]) {
      /* Native dismissals retain the top layer while GSAP moves the panel out. */
      transition:
        display var(--motion-drawer-exit) allow-discrete,
        overlay var(--motion-drawer-exit) allow-discrete;
    }
    .site-nav[popover]:is([data-drawer-closing], :not(:popover-open)) { pointer-events: none; }
    .site-nav[popover]::backdrop {
      opacity: 0;
      transition:
        opacity var(--motion-drawer-exit) var(--ease-in-out),
        display var(--motion-drawer-exit) allow-discrete,
        overlay var(--motion-drawer-exit) allow-discrete;
    }
    .site-nav[popover][data-drawer-closing]::backdrop { transition-property: opacity; }
    .site-nav:popover-open:not([data-drawer-closing])::backdrop {
      opacity: 1;
      transition-duration: var(--motion-drawer);
    }
    @starting-style {
      .site-nav:popover-open:not([data-drawer-closing])::backdrop { opacity: 0; }
    }
  }

  /* ── Desktop Layout (>= 73rem / 1168px) ─────────────────────────────────── */
  @media (min-width: 73rem) {
    .site-header {
      --header-hero-height: clamp(5.625rem, 6.5vw, 6rem);
      --header-hero-control-growth: 0.5rem;
      --header-compact-logo: clamp(9.25rem, 8.2rem + 1.8vw, 11.25rem);
      --header-logo-growth: clamp(1rem, 2vw - 0.5rem, 1.75rem);
      --header-compact-cta-medallion: 1.75rem;
    }

    .site-header__inner {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: clamp(0.75rem, 1.15vw, 1.5rem);
    }

    .site-header__brand {
      grid-column: 1;
      justify-self: start;
    }

    .site-nav {
      grid-column: 2;
      justify-self: start;
      position: static;
      display: flex;
      flex-direction: row;
      align-items: center;
      inline-size: auto;
      block-size: auto;
      max-block-size: none;
      overflow: visible;
      background: none;
      color: var(--color-ink);
    }

    .site-nav__drawer-head,
