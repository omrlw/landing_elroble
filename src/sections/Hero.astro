---
import { Image, Picture } from 'astro:assets';
import Cta from '../components/Cta.astro';
import GalleryPlayback from '../components/GalleryPlayback.astro';
import OpticalGlass from '../components/OpticalGlass.astro';
import { business, firstVisitUrl } from '../config/business';
import hero from '../assets/opening/hero.png';
import sharedActivity from '../assets/opening/hero-actividad-compartida.jpg';
import room from '../assets/opening/hero-salon-luminoso.jpg';
import workshop from '../assets/opening/hero-materiales-del-taller.jpg';
import discoverArrow from '../assets/opening/discover-arrow.svg';
import tourArrow from '../assets/opening/tour-arrow.svg';
import mimp from '../assets/opening/mimp.svg';
import mimpMobile from '../assets/opening/mimp-mobile.svg';
import heart from '../assets/opening/heart.svg';
import sunrise from '../assets/opening/sunrise.svg';
import evaluation from '../assets/opening/evaluation.svg';
import oakLeaf from '../assets/botanical/hero-oak-leaf.webp';
import ring from '../assets/opening/promo-ring.svg';
import ringTablet from '../assets/opening/promo-ring-tablet.svg';
import ringMobile from '../assets/opening/promo-ring-mobile.svg';

const photos = [
  { src: hero, alt: 'Entrada de El Roble con un sendero entre jardines' },
  { src: sharedActivity, alt: 'Varias personas comparten un juego de mesa en el salón', position: '50% 35%' },
  { src: room, alt: 'Salón de El Roble con mesas de madera y ventanas decoradas', position: '56% 50%' },
  { src: workshop, alt: 'Tablero de actividades y materiales preparados para un taller', position: '50% 54%' },
];

const credentials = [
  { label: 'Acreditación MIMP', icon: mimp, mobile: mimpMobile },
  { label: 'Centro de día', icon: sunrise },
  { label: 'Cuidado geriátrico', icon: heart },
  { label: 'Evaluación previa', icon: evaluation },
];
---

<section class="opening-hero" aria-labelledby="opening-title">
  <div class="container opening-hero__inner">
    <div class="opening-hero__lead">
      <h1 id="opening-title">
        <span>Una vida activa,</span>
        <em>acompañada <span class="hero-ending">con dignidad.<Image class="hero-leaf" src={oakLeaf} alt="" aria-hidden="true"
          width={96} widths={[40, 64, 96, 144]} sizes="(min-width: 73rem) 50px, 30px"
          format="webp" loading="eager" decoding="async" /></span></em>
      </h1>
      <div class="opening-hero__intro">
        <p>Acompañamiento integral durante el día para cuidar la autonomía, el bienestar y los vínculos de cada persona mayor.</p>
        <Cta class="opening-hero__discover" href="#centro-de-dia" label="Descubre nuestro centro" icon={discoverArrow.src} variant="oak" />
      </div>
    </div>

    <div class="hero-media" data-swipe-gallery data-glass-scene>
      <div class="hero-media__photos" id="hero-gallery-photos">
        {photos.map(({ src, alt, position }, index) => (
          <div class="hero-media__scene" data-photo-scene>
            <Picture {src} {alt} style={position ? `object-position: ${position}` : undefined} formats={['avif', 'webp']} fallbackFormat="jpg" quality={82}
              widths={[480, 768, 960, 1200, 1680, 2240].filter((width) => width <= src.width)}
              sizes="(max-width: 40rem) 52rem, (max-width: 73rem) max(60rem, calc(100vw - 64px)), min(87.5vw, 1600px)"
              loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'low'} decoding="async" />
          </div>
        ))}
      </div>
      <div class="hero-media__shade" aria-hidden="true"></div>
      <Cta class="hero-media__tour" href="#recorrido" label="Ver el recorrido" icon={tourArrow.src} variant="glass">
        <OpticalGlass slot="surface" source="photo" />
      </Cta>
      <div class="hero-media__experience liquid-glass liquid-glass--blur">
        <OpticalGlass class="hero-media__mobile-lens" source="photo" />
        <p class="hero-media__year"><span>desde</span> <strong>{business.foundedYear}</strong></p>
        <p>Acompañando a personas mayores y sus familias.</p>
      </div>
      <fieldset class="gallery-pagination hero-media__paging" data-gallery-pagination>
        <legend class="sr-only">Fotografías de El Roble</legend>
        {photos.map(({ alt }, index) => (
          <label data-gallery-dot>
            <input type="radio" name="opening-photo" value={index} checked={index === 0}
              aria-label={alt} aria-controls="hero-gallery-photos" />
            <span data-gallery-mark aria-hidden="true"></span>
          </label>
        ))}
        <GalleryPlayback controls="hero-gallery-photos" />
      </fieldset>
    </div>

    <aside class="first-visit" aria-label="Primera visita gratis" data-first-visit>
      <a class="first-visit__link" href={firstVisitUrl}>
        <picture aria-hidden="true">
          <source media="(max-width: 40rem)" srcset={ringMobile.src} />
          <source media="(max-width: 72.999rem)" srcset={ringTablet.src} />
          <img src={ring.src} alt="" />
        </picture>
        <span>Primera visita</span>
        <strong>GRATIS</strong>
      </a>
      <button class="first-visit__dismiss liquid-glass liquid-glass--clear liquid-glass--lens liquid-glass--interactive" type="button" aria-label="Cerrar promoción" hidden>
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 18 18" fill="none">
          <path d="m5 5 8 8m0-8-8 8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
      </button>
    </aside>

    <div class="opening-hero__credentials liquid-glass liquid-glass--clear liquid-glass--optical">
      <OpticalGlass />
      <ul role="list" aria-label="Credenciales de El Roble">
        {credentials.map(({ label, icon, mobile }) => (
          <li>
            <picture>
              {mobile && <source media="(max-width: 40rem)" srcset={mobile.src} />}
              <img src={icon.src} alt="" />
            </picture>
            <span>{label}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  import { setupRadioGallery } from '../scripts/gallery';

  const media = document.querySelector<HTMLElement>('.hero-media');
  if (media) setupRadioGallery(media, [...media.querySelectorAll<HTMLInputElement>('input[type="radio"]')], [...media.querySelectorAll<HTMLElement>('[data-photo-scene]')]);

  const promo = document.querySelector<HTMLElement>('[data-first-visit]');
  const dismiss = promo?.querySelector<HTMLButtonElement>('.first-visit__dismiss');
  const storageKey = 'el-roble-first-visit-dismissed';

  if (promo && dismiss) {
    try { promo.hidden = sessionStorage.getItem(storageKey) === 'true'; } catch { /* Optional storage. */ }
    dismiss.hidden = false;
    dismiss.addEventListener('click', () => {
      try { sessionStorage.setItem(storageKey, 'true'); } catch { /* Storage is optional. */ }
      if (promo.contains(document.activeElement)) document.querySelector<HTMLAnchorElement>('.opening-hero__discover')?.focus({ preventScroll: true });
      promo.inert = true;
      promo.hidden = true;
    }, { once: true });
  }
</script>

<style>
  @property --hero-glass-opacity {
    syntax: '<percentage>';
    inherits: true;
    initial-value: 78%;
  }
  .opening-hero {
    --opening-gap: clamp(1.5rem, 1rem + 2vw, 3rem);
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding-block: clamp(1.75rem, 1rem + 2.6vw, 4rem) clamp(2.5rem, 1.75rem + 1.6vw, 3rem);
  }
  .opening-hero__inner {
    display: grid;
    grid-template-areas: "lead" "photo" "badges";
    gap: var(--opening-gap);
    position: relative;
  }
  .opening-hero__lead { grid-area: lead; display: grid; gap: var(--space-related); }
  .opening-hero h1 > span, .opening-hero h1 > em { display: block; }
  .opening-hero h1 em { color: var(--color-oak); }
  .opening-hero__intro { display: grid; justify-items: start; gap: clamp(1rem, .58rem + 1.2vw, 2rem); color: var(--color-text); }
  .opening-hero__intro p { max-inline-size: 65ch; }

  .hero-media {
    grid-area: photo;
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: end;
    justify-content: space-between;
    min-block-size: clamp(23.375rem, 14rem + 25vw, 40rem);
    border-radius: 2rem;
    overflow: clip;
    padding: 1rem clamp(1rem, 4vw, 3.5rem) 2.75rem;
    background: var(--color-forest);
    color: var(--color-cream);
    box-shadow: var(--shadow-raised);
  }
  .hero-media__photos, .hero-media__scene, .hero-media__shade { position: absolute; inset: 0; }
  .hero-media__photos { z-index: -2; }
  .hero-media__scene { display: none; }
  .hero-media:not([data-gallery-ready]) .hero-media__scene:first-child { display: block; }
  .hero-media__scene picture, .hero-media__scene img { display: block; inline-size: 100%; block-size: 100%; }
  .hero-media__scene img { object-fit: cover; }
  .hero-media:not([data-gallery-ready]):has(input:not([value="0"]):checked) .hero-media__scene:first-child { display: none; }
  .hero-media:not([data-gallery-ready]):has(input[value="1"]:checked) .hero-media__scene:nth-child(2),
  .hero-media:not([data-gallery-ready]):has(input[value="2"]:checked) .hero-media__scene:nth-child(3),
  .hero-media:not([data-gallery-ready]):has(input[value="3"]:checked) .hero-media__scene:nth-child(4) { display: block; }
  .hero-media__shade {
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(transparent 62%, var(--color-dialog-backdrop));
  }
  .hero-media :global(.hero-media__tour) {
    --optical-film: linear-gradient(165deg,
      color-mix(in srgb, var(--color-action) var(--hero-glass-opacity), transparent),
      color-mix(in srgb, var(--color-forest) calc(var(--hero-glass-opacity) + 12%), transparent));
    --optical-rim: var(--glass-bevel-dark);
    white-space: nowrap;
  }
  @media (hover: hover) {
    .hero-media :global(.hero-media__tour:hover) { --hero-glass-opacity: 74%; }
  }
  .hero-media :global(.hero-media__tour:active) { --hero-glass-opacity: 86%; }
  @media (prefers-reduced-motion: no-preference) {
    .hero-media :global(.hero-media__tour) {
      transition: --hero-glass-opacity var(--glass-motion) var(--glass-ease), box-shadow var(--glass-motion) var(--glass-ease);
    }
  }
  .hero-media :global(.hero-media__tour .cta-icon img) { inline-size: 20px; block-size: 20px; }
  .hero-media__experience {
    position: relative;
    inline-size: clamp(15.5rem, 13.9rem + 2.4vw, 17.5rem);
    min-inline-size: 0;
    padding: clamp(1.125rem, .85rem + .5vw, 1.5rem);
    border-radius: 1rem;
    font-size: 1rem;
    line-height: 1.5;
  }
  .hero-media__experience > p { position: relative; }
  :global(.hero-media__mobile-lens) { display: none; }
  .hero-media__year { display: grid; gap: .75rem; margin-block-end: .75rem; padding-block-end: .875rem; background: linear-gradient(90deg, var(--color-on-forest-line), transparent) left bottom / 100% 1px no-repeat; }
  .hero-media__year span { color: var(--color-on-forest-muted); }
  .hero-media__year strong { font: 700 clamp(3rem, 2.65rem + .75vw, 4rem) / 1 var(--font-display); }

  .hero-media__paging {
    position: absolute;
    inset: auto auto 0 50%;
    transform: translateX(-50%);
  }

  .hero-ending { position: relative; display: inline-block; }

  .hero-leaf {
    display: block;
    position: absolute;
    inset-block-end: .19em;
    inset-inline-start: calc(100% + .15em);
    inline-size: clamp(1.65rem, .7em, 3.125rem);
    block-size: auto;
    rotate: 9deg;
    pointer-events: none;
  }

  .first-visit {
    --offer-size: 7.6rem;
    grid-area: photo;
    z-index: 2;
    align-self: start;
    justify-self: end;
    position: absolute;
    inset: 0 0 auto auto;
    margin: 1rem;
    inline-size: var(--offer-size);
    block-size: var(--offer-size);
    color: var(--color-paper);
  }
  .first-visit__link {
    display: grid;
    position: relative;
    inline-size: 100%;
    block-size: 100%;
    align-content: center;
    justify-items: center;
    border-radius: 50%;
    background: var(--color-oak-highlight);
    box-shadow: var(--shadow-control);
    font-size: clamp(.875rem, .79rem + .25vw, 1rem);
    line-height: 1.35;
  }
  .first-visit__link picture { position: absolute; inset: 0; display: grid; place-items: center; pointer-events: none; }
  .first-visit__link strong { font: 700 clamp(1.5rem, 1.3rem + .48vw, 2rem) / 1.15 var(--font-display); }
  .first-visit__link { transition: background-color var(--motion-state); }
  .first-visit__link:active { background-color: var(--color-oak); }
  @media (hover: hover) { .first-visit__link:hover { background-color: var(--color-oak); } }
  .first-visit__dismiss {
    position: absolute;
    inset: -.75rem -.375rem auto auto;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    --glass-depth: var(--shadow-control);
  }
  .first-visit[hidden], .first-visit__dismiss[hidden] { display: none; }

  @media (prefers-reduced-motion: no-preference) {
    @supports (transition-behavior: allow-discrete) {
      .first-visit {
        transform-origin: top right;
        transition: opacity var(--motion-exit) var(--ease-soft), scale var(--motion-exit) var(--ease-soft), display var(--motion-exit) allow-discrete;
      }
      .first-visit[hidden] { opacity: 0; scale: .96; }
    }
  }

  .opening-hero__credentials {
    --optical-film: var(--glass-clear-tint);
    grid-area: badges;
    justify-self: center;
    z-index: 1;
    inline-size: min(100%, 25rem);
    margin-block-start: calc(var(--space-related) - var(--opening-gap));
    padding: .45rem;
    border-radius: 1.125rem;
    font-size: var(--text-meta);
    font-weight: 600;
    line-height: 1.3;
  }
  .opening-hero__credentials ul { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .opening-hero__credentials li {
    display: flex;
    align-items: center;
    gap: clamp(.4375rem, 1vw, .75rem);
    min-block-size: 2.875rem;
    padding: .5rem clamp(.5rem, 1.1vw, .875rem);
  }
  .opening-hero__credentials li:nth-child(even) { border-inline-start: 1px solid var(--glass-divider); }
  .opening-hero__credentials li:nth-child(n+3) { border-block-start: 1px solid var(--glass-divider); }
  .opening-hero__credentials picture {
    display: grid;
    place-items: center;
    flex: none;
    inline-size: clamp(1.125rem, 1rem + .5vw, 1.375rem);
    aspect-ratio: 1;
  }
  .opening-hero__credentials img { inline-size: 100%; block-size: auto; max-block-size: 1.375rem; object-fit: contain; }

  @media (max-width: 40rem) {
    .opening-hero { --opening-gap: 1.5rem; padding-block-start: 1.75rem; }
    .opening-hero__inner { grid-template-columns: minmax(0, 1fr); }
    .hero-ending { display: block; inline-size: fit-content; }
    .hero-media { min-block-size: 23.375rem; padding-inline: 1rem; }
    .hero-media :global(.hero-media__tour) { display: none; }
    :global(.hero-media__mobile-lens) {
      --optical-film: linear-gradient(165deg, rgb(25 32 23 / 77%), rgb(20 27 19 / 92%));
      --optical-rim: var(--glass-bevel-dark);
      display: block;
    }
    .hero-media__experience { padding: 1rem; inline-size: 100%; }
    .hero-media__year { display: flex; align-items: center; gap: .5rem; margin-block-end: .375rem; padding: 0; background: none; }
    .hero-media__year strong { font-size: 2rem; }
    .first-visit { --offer-size: 7rem; grid-area: lead; margin: 2rem .625rem 0 0; }
    .first-visit__dismiss { border-radius: .875rem; }
  }
  @media (max-width: 24rem) {
    .first-visit { --offer-size: 6.675rem; grid-area: photo; margin-block-start: 1rem; margin-inline-end: 1rem; }
    .first-visit__link picture { inset: .1rem; }
  }
  @media (24rem < width <= 40rem) {
    .opening-hero__inner:has(.first-visit:not([hidden])) h1 { min-block-size: 8.5rem; }
  }
  @media (min-width: 40.001rem) and (max-width: 72.999rem) {
    .opening-hero { --opening-gap: 2rem; padding-block-start: 2.25rem; }
    .opening-hero__intro { gap: 1.25rem; }
    .hero-media { padding-inline: 1.5rem; }
  }
  @media (min-width: 54rem) {
    .opening-hero__credentials { inline-size: min(100%, 57rem); font-size: clamp(var(--text-meta), 1.7vw, var(--text-control)); }
    .opening-hero__credentials ul { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .opening-hero__credentials li { justify-content: center; }
    .opening-hero__credentials li:nth-child(n+3) { border-block-start: 0; }
    .opening-hero__credentials li + li { border-inline-start: 1px solid var(--glass-divider); }
  }
  @media (min-width: 73rem) {
    .opening-hero__lead {
      grid-template-columns: minmax(0, 2.3fr) minmax(18.5rem, 1fr);
      gap: clamp(2.25rem, 5.8vw, 6rem);
      align-items: center;
      min-block-size: clamp(9.5rem, 11.25vw, 13.5rem);
    }
    .first-visit {
      --offer-size: clamp(7.5rem, 8vw, 9.5rem);
      grid-area: photo;
      margin: clamp(1.5rem, 2vw, 2.25rem) clamp(1rem, 2vw, 2.25rem) 0 0;
    }
    .first-visit__dismiss { inset: -1rem -.75rem auto auto; }
    .hero-media { padding-block-end: 2.5rem; }
    .hero-media__experience { inline-size: 17.5rem; }
    .hero-media__paging { inset-block-end: 1.375rem; }
    .opening-hero__credentials {
      --optical-film: linear-gradient(
        color-mix(in srgb, var(--color-cream) 58%, transparent),
        var(--color-cream) .875rem,
        color-mix(in srgb, var(--color-cream) 77%, transparent)
      );
      margin-block-start: calc(-1 * var(--opening-gap) - .625rem);
    }
  }
</style>
