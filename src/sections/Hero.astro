---
import { Image, Picture } from 'astro:assets';
import Cta from '../components/Cta.astro';
import ActionIcon from '../components/ActionIcon.astro';
import Pictogram from '../components/Pictogram.astro';
import GalleryPlayback from '../components/GalleryPlayback.astro';
import OpticalGlass from '../components/OpticalGlass.astro';
import { business, firstVisitUrl } from '../config/business';
import hero from '../assets/opening/hero.png';
import sharedActivity from '../assets/opening/hero-actividad-compartida.jpg';
import room from '../assets/opening/hero-salon-luminoso.jpg';
import workshop from '../assets/opening/hero-materiales-del-taller.jpg';
import oakLeaf from '../assets/botanical/hero-oak-leaf.webp';
import promoSprig from '../assets/botanical/genial-left-sprig.webp';

const photos = [
  { src: hero, alt: 'Entrada de El Roble con un sendero entre jardines' },
  { src: sharedActivity, alt: 'Varias personas comparten un juego de mesa en el salón', position: '50% 35%' },
  { src: room, alt: 'Salón de El Roble con mesas de madera y ventanas decoradas', position: '56% 50%' },
  { src: workshop, alt: 'Tablero de actividades y materiales preparados para un taller', position: '50% 54%' },
];

const credentials = [
  { label: 'Acreditación MIMP', icon: 'mimp' },
  { label: 'Centro de día', icon: 'sunrise' },
  { label: 'Cuidado geriátrico', icon: 'heart' },
  { label: 'Evaluación previa', icon: 'evaluation' },
] as const;
---

<section class="opening-hero" aria-labelledby="opening-title">
  <span class="opening-hero__waves" aria-hidden="true">
    <canvas class="opening-hero__light"></canvas>
  </span>
  <div class="container opening-hero__inner">
    <div class="opening-hero__lead">
      <h1 id="opening-title">
        <span>Una vida activa,</span>
        <em>acompañada <span class="hero-ending">con dignidad.<Image class="hero-leaf" src={oakLeaf} alt="" aria-hidden="true"
          width={96} widths={[40, 64, 96, 144]} sizes="(min-width: 73rem) 50px, 30px"
          format="webp" loading="eager" decoding="async" /></span></em>
      </h1>
      <div class="opening-hero__intro">
        <p>Acompañamiento integral durante el día para cuidar la autonomía, el bienestar y los vínculos de cada persona mayor.</p>
        <Cta class="opening-hero__discover" href="#centro-de-dia" label="Descubre nuestro centro" variant="oak" />
      </div>
    </div>

    <div class="hero-media" data-swipe-gallery>
      <div class="hero-media__photos" id="hero-gallery-photos">
        {photos.map(({ src, alt, position }, index) => (
          <div class="hero-media__scene" data-photo-scene>
            <Picture {src} {alt} style={position ? `object-position: ${position}` : undefined} formats={['avif']} fallbackFormat="webp" quality={82}
              widths={[480, 768, 960, 1200, 1680, 2240].filter((width) => width <= src.width)}
              sizes="(max-width: 40rem) 52rem, (max-width: 73rem) max(60rem, calc(100vw - 64px)), min(87.5vw, 1600px)"
              loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'low'} decoding="async" />
          </div>
        ))}
      </div>
      <div class="hero-media__shade" aria-hidden="true"></div>
      <Cta class="hero-media__tour" href="#recorrido" label="Ver el recorrido" variant="glass" />
      <div class="hero-media__experience liquid-glass liquid-glass--blur">
        <p class="hero-media__year"><span>desde</span> <strong>{business.foundedYear}</strong></p>
        <p>Acompañando a personas mayores y sus familias.</p>
      </div>
      <fieldset class="gallery-pagination hero-media__paging" data-gallery-pagination>
        <legend class="sr-only">Fotografías de El Roble</legend>
        {photos.map(({ alt }, index) => (
          <label data-gallery-dot>
            <input type="radio" name="opening-photo" value={index} checked={index === 0} data-gallery-control
              aria-label={alt} aria-controls="hero-gallery-photos" />
            <span data-gallery-mark aria-hidden="true"></span>
          </label>
        ))}
        <GalleryPlayback controls="hero-gallery-photos" subject="carrusel y fondo" />
      </fieldset>
    </div>

    <div class="first-visit-origin" data-first-visit-origin>
      <aside class="first-visit" aria-label="Primera visita gratis" data-first-visit>
        <a class="first-visit__link liquid-glass liquid-glass--action liquid-glass--oak liquid-glass--interactive" href={firstVisitUrl}>
          <Image class="first-visit__leaf" src={promoSprig} alt="" aria-hidden="true"
            width={128} widths={[64, 96, 128]} sizes="(min-width: 80rem) 64px, 52px" format="webp" />
          <span class="first-visit__copy">
            <span><span class="sr-only">Agendar </span>Primera visita</span>{' '}
            <strong>Gratis</strong>
          </span>
        </a>
        <button class="first-visit__dismiss liquid-glass liquid-glass--clear liquid-glass--blur liquid-glass--underlay liquid-glass--interactive" type="button" aria-label="Cerrar promoción" hidden>
          <ActionIcon name="close" />
        </button>
      </aside>
    </div>

    <div class="opening-hero__credentials liquid-glass liquid-glass--clear liquid-glass--optical">
      <OpticalGlass />
      <div class="credentials-viewport" id="hero-credentials" role="region" aria-label="Credenciales de El Roble" tabindex="0">
        <div class="credentials-track">
          {[false, true].map((copy) => (
            <ul role="list" aria-hidden={copy ? 'true' : undefined}>
              {credentials.map(({ label, icon }) => (
                <li>
                  <Pictogram name={icon} size={20} />
                  <span>{label}</span>
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { setupRadioGallery } from '../scripts/gallery';
  import { setupHeroLight } from '../scripts/hero-light';
  import { phoneLayoutQuery, reducedMotion } from '../scripts/media';

  const media = document.querySelector<HTMLElement>('.hero-media');
  if (media) setupRadioGallery(media);

  const light = document.querySelector<HTMLCanvasElement>('.opening-hero__light');
  const lightLayer = light?.parentElement;
  const heroSection = lightLayer?.parentElement;
  if (light && lightLayer && heroSection) setupHeroLight(light, lightLayer, heroSection);

  const credentials = document.querySelector<HTMLElement>('#hero-credentials');
  if (credentials) {
    const manualScroll = matchMedia(`${phoneLayoutQuery} and ${reducedMotion.media}`);
    const syncFocus = () => {
      if (manualScroll.matches) credentials.tabIndex = 0;
      else credentials.removeAttribute('tabindex');
    };
    manualScroll.addEventListener('change', syncFocus);
    syncFocus();
  }

  const promo = document.querySelector<HTMLElement>('[data-first-visit]');
  const promoOrigin = document.querySelector<HTMLElement>('[data-first-visit-origin]');
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const dismiss = promo?.querySelector<HTMLButtonElement>('.first-visit__dismiss');
  const storageKey = 'el-roble-first-visit-dismissed';

  if (promo && dismiss) {
    const listeners = new AbortController();
    let pendingFrame = 0;
    let placement: Animation | undefined;

    const updatePlacement = (animate: boolean) => {
      if (!promoOrigin || !header) return;
      const origin = promoOrigin.getBoundingClientRect();
      // Move before the branch reaches the sticky header.
      const docked = origin.top <= header.getBoundingClientRect().bottom + 24;
      if (docked === promo.hasAttribute('data-docked')) return;

      const previous = promo.getBoundingClientRect();
      placement?.cancel();
      promo.toggleAttribute('data-docked', docked);
      if (!animate || reducedMotion.matches) return;

      const next = promo.getBoundingClientRect();
      const distance = previous.top - next.top;
      placement = promo.animate([
        {
          transform: Math.abs(distance) < next.height
            ? `translate(${previous.right - next.right}px, ${distance}px) scale(${previous.width / next.width})`
            : 'translateY(8px)',
          opacity: Math.abs(distance) < next.height ? 1 : .75,
        },
        { transform: 'none', opacity: 1 },
      ], { duration: 280, easing: 'cubic-bezier(.22, .66, .2, 1)' });
    };

    const schedulePlacement = () => {
      if (pendingFrame) return;
      pendingFrame = requestAnimationFrame(() => {
        pendingFrame = 0;
        updatePlacement(true);
      });
    };

    try { promo.hidden = sessionStorage.getItem(storageKey) === 'true'; } catch { /* Optional storage. */ }
    if (!promo.hidden) {
      dismiss.hidden = false;
      updatePlacement(false);
      const options = { passive: true, signal: listeners.signal };
      window.addEventListener('scroll', schedulePlacement, options);
      window.addEventListener('resize', schedulePlacement, options);
      reducedMotion.addEventListener('change', () => placement?.cancel(), options);

      dismiss.addEventListener('click', () => {
        try { sessionStorage.setItem(storageKey, 'true'); } catch { /* Storage is optional. */ }
        if (promo.contains(document.activeElement)) {
          const target = promo.hasAttribute('data-docked') ? '.site-header__brand' : '.opening-hero__discover';
          document.querySelector<HTMLAnchorElement>(target)?.focus({ preventScroll: true });
        }
        listeners.abort();
        cancelAnimationFrame(pendingFrame);
        placement?.cancel();
        promo.inert = true;
        promo.hidden = true;
      }, { once: true });
    }
  }
</script>

<style>
  .opening-hero {
    --opening-gap: clamp(1.5rem, 1rem + 2vw, 3rem);
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding-block: clamp(1.75rem, 1rem + 2.6vw, 4rem) clamp(2.5rem, 1.75rem + 1.6vw, 3rem);
  }
  .opening-hero::before {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      radial-gradient(ellipse 56% 24rem at 47% 10rem, var(--color-paper), transparent),
      radial-gradient(ellipse 47% 31rem at 0% 23%,
        color-mix(in srgb, var(--color-sand) 70%, transparent), transparent),
      radial-gradient(ellipse 51% 32rem at 100% 26%,
        color-mix(in srgb, var(--color-honey) 34%, transparent), transparent),
      radial-gradient(ellipse 74% 16rem at 50% 88%,
        color-mix(in srgb, var(--color-sand) 50%, transparent), transparent);
    mask-image: linear-gradient(transparent, black 4rem, black 84%, transparent);
    pointer-events: none;
    content: '';
  }
  .opening-hero__waves {
    --hero-arc-mask: linear-gradient(to right, transparent 54%, black 75%);
    --hero-arc-top: -19rem;
    --hero-arc-overhang: clamp(-5.5rem, -5vw, -3rem);
    --hero-arc-width: clamp(34rem, 48vw, 58rem);
    --hero-arc-height: 35.5rem;
    position: absolute;
    z-index: -1;
    inset: 0;
    pointer-events: none;
  }
  .opening-hero__light {
    position: absolute;
    inset: 0 0 auto;
    inline-size: 100%;
    block-size: min(23rem, 100%);
    mask-image: linear-gradient(transparent, black 1rem, black 93%, transparent);
    visibility: hidden;
  }
  .opening-hero__waves[data-wave-rendered] .opening-hero__light { visibility: visible; }
  .opening-hero__waves[data-wave-rendered]::before,
  .opening-hero__waves[data-wave-rendered]::after { visibility: hidden; }
  .opening-hero__waves::before,
  .opening-hero__waves::after {
    position: absolute;
    inset-block-start: var(--hero-arc-top);
    inline-size: var(--hero-arc-width);
    block-size: var(--hero-arc-height);
    background: radial-gradient(ellipse closest-side,
      transparent 72%,
      color-mix(in srgb, var(--color-paper) 22%, transparent) 94%,
      color-mix(in srgb, var(--color-paper) 78%, transparent) 98.6%,
      transparent 100%);
    mask-image: var(--hero-arc-mask);
    content: '';
  }
  .opening-hero__waves::before { inset-inline-end: var(--hero-arc-overhang); }
  .opening-hero__waves::after {
    inset-block-start: calc(var(--hero-arc-top) - .75rem);
    inset-inline-start: var(--hero-arc-overhang);
    scale: -1 1;
    opacity: .64;
  }
  .opening-hero__inner {
    display: grid;
    grid-template-areas: "lead" "photo" "badges";
    grid-template-columns: minmax(0, 1fr);
    gap: var(--opening-gap);
    position: relative;
  }
  .opening-hero__lead { grid-area: lead; display: grid; gap: var(--space-related); }
  .opening-hero h1 > span, .opening-hero h1 > em { display: block; }
  .opening-hero h1 em { color: var(--color-oak); }
  .opening-hero__intro { display: grid; justify-items: start; gap: clamp(1rem, .58rem + 1.2vw, 2rem); color: var(--color-text); }
  .opening-hero__intro p { max-inline-size: 65ch; }

  .hero-media {
    grid-area: photo;
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: end;
    justify-content: space-between;
    min-block-size: clamp(23.375rem, 14rem + 25vw, 40rem);
    border-radius: 2rem;
    overflow: clip;
    padding: 1rem clamp(1rem, 4vw, 3.5rem) 2.75rem;
    background: var(--color-forest);
    color: var(--color-cream);
    box-shadow: var(--shadow-card);
  }
  .hero-media__photos, .hero-media__scene, .hero-media__shade { position: absolute; inset: 0; }
  .hero-media__photos { z-index: -2; }
  .hero-media__scene { display: none; }
  .hero-media:not([data-gallery-ready]) .hero-media__scene:first-child { display: block; }
  .hero-media__scene picture, .hero-media__scene img { display: block; inline-size: 100%; block-size: 100%; }
  .hero-media__scene img { object-fit: cover; }
  .hero-media:not([data-gallery-ready]):has(input:not([value="0"]):checked) .hero-media__scene:first-child { display: none; }
  .hero-media:not([data-gallery-ready]):has(input[value="1"]:checked) .hero-media__scene:nth-child(2),
  .hero-media:not([data-gallery-ready]):has(input[value="2"]:checked) .hero-media__scene:nth-child(3),
  .hero-media:not([data-gallery-ready]):has(input[value="3"]:checked) .hero-media__scene:nth-child(4) { display: block; }
  .hero-media__shade {
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(ellipse 69% 59% at 15% 0%,
        color-mix(in srgb, var(--color-honey) 19%, transparent), transparent),
      radial-gradient(ellipse at 47% 29%, transparent 50%,
        color-mix(in srgb, var(--color-ink) 19%, transparent)),
      linear-gradient(transparent 62%, var(--color-dialog-backdrop));
  }
  .hero-media :global(.hero-media__tour) { white-space: nowrap; }

  .hero-media__experience {
    position: relative;
    inline-size: clamp(15.5rem, 13.9rem + 2.4vw, 17.5rem);
    min-inline-size: 0;
    padding: clamp(1.125rem, .85rem + .5vw, 1.5rem);
    border-radius: 1rem;
    font-size: 1rem;
    line-height: 1.5;
  }
  .hero-media__experience > p { position: relative; }
  .hero-media__year { display: grid; gap: var(--space-control-gap); margin-block-end: .75rem; padding-block-end: .875rem; background: linear-gradient(90deg, var(--color-on-forest-line), transparent) left bottom / 100% 1px no-repeat; }
  .hero-media__year span { color: var(--color-on-forest-muted); }
  .hero-media__year strong { font: 700 clamp(3rem, 2.65rem + .75vw, 4rem) / 1 var(--font-display); }

  .hero-media__paging {
    position: absolute;
    inset: auto auto 0 50%;
    transform: translateX(-50%);
  }

  .hero-ending { position: relative; display: inline-block; }

  .hero-leaf {
    display: block;
    position: absolute;
    inset-block-end: .19em;
    inset-inline-start: calc(100% + .15em);
    inline-size: clamp(1.65rem, .7em, 3.125rem);
    block-size: auto;
    rotate: 9deg;
    pointer-events: none;
  }

  .opening-hero:has(.first-visit[data-docked]:not([hidden])) { z-index: 10; }

  .first-visit-origin {
    --offer-size: clamp(7rem, 8.5vw, 8.75rem);
    grid-area: photo;
    z-index: 2;
    align-self: start;
    justify-self: end;
    position: absolute;
    inset: 0 0 auto auto;
    margin: 1rem;
    inline-size: var(--offer-size);
    aspect-ratio: 1;
  }
  .first-visit {
    inline-size: 100%;
    aspect-ratio: 1;
    transform-origin: top right;
  }
  .first-visit[data-docked] {
    position: fixed;
    inset-block-start: calc(var(--header-block-size) + 1.75rem);
    inset-inline-end: clamp(1.25rem, 2.5vw, 2.5rem);
    inline-size: 7rem;
  }
  .first-visit[data-docked] .first-visit__leaf {
    inset-block-start: -1.125rem;
    inline-size: 3rem;
  }
  .first-visit[data-docked] .first-visit__copy strong { font-size: 2.125rem; }
  .first-visit__link {
    --glass-fill: radial-gradient(ellipse at 30% 8%, var(--color-oak-highlight), var(--color-oak) 82%);
    --glass-edge: color-mix(in srgb, var(--color-honey) 46%, transparent);
    --glass-hover-edge: var(--color-honey);
    position: relative;
    display: grid;
    inline-size: 100%;
    block-size: 100%;
    place-content: center;
    place-items: center;
    padding-block-start: .375rem;
    border: 1px solid transparent;
    border-radius: 50%;
    font-size: var(--first-visit-label-size, var(--text-meta));
    line-height: var(--leading-control);
    text-align: center;
  }
  .first-visit__copy { display: grid; gap: .125rem; font-weight: 500; }
  .first-visit__copy strong {
    color: color-mix(in srgb, var(--color-paper) 70%, var(--color-honey));
    font: italic 700 clamp(2.125rem, 1.65rem + 1.35vw, 2.5rem) / .95 var(--font-display);
  }
  .first-visit__leaf {
    position: absolute;
    inset-block-start: -1.375rem;
    inset-inline-start: -.75rem;
    inline-size: clamp(3.25rem, 4vw, 4rem);
    rotate: -12deg;
    transform-origin: 55% 75%;
    filter: drop-shadow(0 3px 4px rgb(33 21 10 / 25%));
    pointer-events: none;
  }

  .first-visit__dismiss {
    --glass-rest-visibility: 1;
    --glass-backdrop: linear-gradient(
      color-mix(in srgb, var(--color-paper) 88%, transparent),
      color-mix(in srgb, var(--color-paper) 68%, transparent)
    );
    --glass-filter: blur(8px);
    position: absolute;
    inset: -.875rem -.875rem auto auto;
    inline-size: var(--control-size);
    block-size: var(--control-size);
    display: grid;
    place-items: center;
    border-radius: 50%;
  }
  .first-visit__dismiss::before { inset: .5rem; }
  .first-visit__dismiss[hidden] { display: none; }

  @media (prefers-reduced-transparency: reduce) {
    .first-visit__dismiss { --glass-backdrop: var(--surface-paper); --glass-filter: none; }
  }

  @media (forced-colors: active) {
    .opening-hero::before, .opening-hero__waves { display: none; }
    .first-visit__link { border-color: LinkText; }
    .first-visit__copy strong { color: inherit; }
    .first-visit__dismiss::before { background: ButtonFace; border: 1px solid ButtonText; }
    .first-visit__dismiss { color: ButtonText; }
    .first-visit__dismiss:focus-visible, .first-visit__link:focus-visible {
      outline-color: Highlight;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .opening-hero__waves[data-wave-fallback]::before,
    .opening-hero__waves[data-wave-fallback]::after {
      mask-image: var(--hero-arc-mask),
        linear-gradient(106deg, rgb(0 0 0 / .34) 8%, black 47% 60%, rgb(0 0 0 / .40) 90%);
      mask-size: 100% 100%, 185% 100%;
      mask-composite: intersect;
      animation: hero-light-glint 6.5s ease-in-out infinite alternate;
    }
    .opening-hero__waves[data-wave-fallback]::after { animation-direction: alternate-reverse; }
    .opening-hero__waves[data-wave-idle]::before,
    .opening-hero__waves[data-wave-idle]::after {
      animation-play-state: paused;
    }
    @keyframes hero-light-glint {
      from { mask-position: center, left center; }
      to { mask-position: center, right center; }
    }
    .first-visit__leaf {
      animation: first-visit-breeze 12s 4s ease-in-out infinite;
      transition: rotate var(--motion-state) var(--ease-soft);
    }
    .first-visit:focus-within .first-visit__leaf { animation-play-state: paused; }
    .first-visit__link:focus-visible .first-visit__leaf { rotate: -18deg; }
    @media (hover: hover) and (pointer: fine) {
      .first-visit:hover .first-visit__leaf { animation-play-state: paused; }
      .first-visit__link:hover .first-visit__leaf { rotate: -18deg; }
    }
    @keyframes first-visit-breeze {
      0%, 10%, 100% { transform: rotate(0deg); }
      3% { transform: rotate(-9deg); }
      6% { transform: rotate(4deg); }
    }
    @supports (transition-behavior: allow-discrete) {
      .first-visit {
        transition: opacity var(--motion-exit) var(--ease-soft), scale var(--motion-exit) var(--ease-soft), display var(--motion-exit) allow-discrete;
      }
      .first-visit[hidden] { opacity: 0; scale: .96; }
    }
  }

  .opening-hero__credentials {
    --optical-film: var(--glass-clear-tint);
    grid-area: badges;
    justify-self: center;
    z-index: 1;
    inline-size: min(100%, 57rem);
    margin-block-start: calc(max(1rem, var(--space-related)) - var(--opening-gap));
    padding: .375rem .5rem;
    border-radius: var(--radius-pill);
    font-size: clamp(.9375rem, .87rem + .24vw, var(--text-control));
    font-weight: 600;
    line-height: 1.3;
  }
  .credentials-track ul {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-detail);
    padding-inline: clamp(.375rem, 1.25vw, .75rem);
  }
  .credentials-track ul[aria-hidden='true'] { display: none; }
  .credentials-track li {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(.4375rem, 1vw, .75rem);
    min-block-size: 2.875rem;
  }
  .credentials-viewport:focus-visible { outline-offset: -2px; }

  @media (width < 40rem) {
    .credentials-viewport {
      container-type: inline-size;
      overflow-x: auto;
    }
    .credentials-track {
      --credentials-gap: clamp(1.5rem, 4vw, 3rem);
      display: flex;
      inline-size: max-content;
    }
    .credentials-track ul {
      display: flex;
      flex: none;
      justify-content: space-around;
      min-inline-size: 100cqi;
      gap: var(--credentials-gap);
      padding-inline: calc(var(--credentials-gap) / 2);
    }
    .credentials-track li { white-space: nowrap; }
  }

  @media (width < 40rem) and (prefers-reduced-motion: no-preference) {
    .credentials-viewport {
      overflow: clip;
      mask-image: linear-gradient(90deg, transparent, black .625rem, black calc(100% - .625rem), transparent);
    }
    .credentials-track ul[aria-hidden='true'] { display: flex; }
    .credentials-track { animation: credentials-loop 28s linear infinite; }
    @keyframes credentials-loop {
      to { transform: translateX(-50%); }
    }
  }

  @media (width < 40rem) {
    .opening-hero { --opening-gap: var(--section-gap); padding-block: var(--space-inset) var(--section-gap); }
    .opening-hero h1 { line-height: .99; }
    .opening-hero__intro { gap: var(--space-related); }
    .opening-hero__light { block-size: min(25rem, 100%); }
    .opening-hero__waves {
      --hero-arc-top: -11rem;
      --hero-arc-overhang: -5.5rem;
      --hero-arc-width: 26rem;
