---
import { Image } from 'astro:assets';
import Cta from '../components/Cta.astro';
import health from '../assets/approach/portrait.png';
import cognitive from '../assets/program/cognitive.png';
import group from '../assets/program/group.png';
import integral from '../assets/program/integral.png';
import leavesLeft from '../assets/botanical/genial-left-sprig.webp';
import leavesRight from '../assets/botanical/program-oak-sprig.webp';
import reminiscence from '../assets/program/reminiscence.png';

const activities = [
  {
    id: 'cognitive',
    title: 'Estimulación y terapia cognitiva',
    desktopTitle: ['Estimulación y', 'terapia cognitiva'],
    mobileTitle: 'Estimulación cognitiva',
    description: 'Actividades diseñadas para ejercitar la memoria, la atención y el lenguaje, adaptadas al ritmo de cada persona.',
    mobileDescription: 'Ejercicios de memoria, atención y lenguaje.',
    photo: cognitive,
    alt: 'Personas mayores realizan ejercicios en una mesa compartida.',
  },
  {
    id: 'reminiscence',
    title: 'Terapia de reminiscencia',
    description: 'Recuerdos y experiencias de vida para conversar, expresarse y compartir la propia historia.',
    mobileDescription: 'Recuerdos para conversar y compartir historias.',
    photo: reminiscence,
    alt: 'Una participante conversa con una cuidadora durante una actividad.',
  },
  {
    id: 'art',
    title: 'Talleres de arte creativos',
    desktopTitle: ['Talleres de arte', 'creativos'],
    mobileTitle: 'Talleres de arte',
    description: 'Explorar materiales y dar forma a ideas propias, respetando los gustos de cada persona.',
    mobileDescription: 'Ideas y materiales para crear a su manera.',
  },
  {
    id: 'group',
    title: 'Actividades grupales de convivencia y recreación',
    desktopTitle: ['Actividades grupales de', 'convivencia y recreación'],
    mobileTitle: 'Convivencia y recreación',
    description: 'Espacios de encuentro para compartir, jugar y disfrutar momentos en grupo.',
    mobileDescription: 'Juegos y momentos para compartir en grupo.',
    photo: group,
    alt: 'Participantes comparten una actividad con materiales de colores.',
  },
  {
    id: 'physio',
    title: 'Fisioterapia suave',
    description: 'Movimientos suaves y pausados para trabajar la coordinación, la movilidad y el bienestar físico.',
    mobileDescription: 'Ejercicios de movilidad y coordinación.',
  },
  {
    id: 'health',
    title: 'Monitoreo constante de signos vitales',
    desktopTitle: ['Monitoreo constante', 'de signos vitales'],
    mobileTitle: 'Control de signos vitales',
    description: 'Seguimiento continuo de la salud para garantizar tranquilidad y atención oportuna.',
    mobileDescription: 'Seguimiento continuo para cuidar su salud.',
    photo: health,
    alt: 'Una mujer mayor con chaleco verde en el centro.',
  },
  {
    id: 'integral',
    title: 'Programa integral',
    description: 'Un enfoque integral que combina apoyo cognitivo, creatividad, convivencia, movimiento y seguimiento de la salud para acompañar cada día.',
    mobileDescription: 'Apoyo cognitivo, físico y social en el día a día.',
    photo: integral,
    alt: 'Una participante sonríe durante un taller de pintura.',
  },
];
---

<section class="program" id="programa" tabindex="-1" aria-labelledby="program-title">
  <div class="container program-inner">
    <div class="program-decoration" aria-hidden="true">
      <Image class="program-leaves--left" src={leavesLeft} alt="" width={240} widths={[128, 192, 240]}
        sizes="clamp(112px, 9.4vw, 160px)" format="webp" />
      <Image class="program-leaves--right" src={leavesRight} alt="" width={360} widths={[96, 144, 192, 280, 360]}
        sizes="(min-width: 75rem) clamp(112px, 9.4vw, 160px), 64px" format="webp" />
    </div>

    <header class="program-heading" data-reveal="heading">
      <h2 id="program-title">
        <span class="program-title-default">Un programa para</span>
        <span class="program-title-tablet">Actividades para</span>
        <em>seguir descubriendo.</em>
      </h2>
      <div>
        <p class="program-mobile">
          Memoria, movimiento, creatividad y encuentro, al ritmo de cada persona.
        </p>
        <p class="program-tablet">
          Memoria, movimiento y creatividad para disfrutar en compañía, cada persona a su ritmo.
        </p>
        <p class="program-desktop">
          Memoria, movimiento, creatividad y encuentro. Explora las actividades de El Roble:
          propuestas para participar según los intereses y capacidades de cada persona.
        </p>
      </div>
    </header>

    <div class="program-grid">
      {activities.map((activity) => (
        <article class:list={[`program-card program-card--${activity.id}`, activity.id !== 'art' && 'liquid-glass liquid-glass--reading']} data-reveal="program">
          {activity.photo && (
            <div class="program-photo">
              <Image
                src={activity.photo}
                alt={activity.alt}
                format="webp"
                widths={[352, 528, 704, 1056]}
                sizes="(max-width: 767px) calc(100vw - 40px), (max-width: 1199px) 44vw, (max-width: 1920px) 29vw, 552px"
              />
            </div>
          )}
          <div class="program-content">
            <div class:list={['program-symbol liquid-glass liquid-glass--lens', activity.id === 'art' ? 'liquid-glass--forest-panel' : 'liquid-glass--clear']} aria-hidden="true">
              <picture>
                <source media="(min-width: 1200px)" srcset={`/images/program/${activity.id}-icon.svg`} />
                <img src={`/images/program/${activity.id}-compact.svg`} alt="" loading="lazy" />
              </picture>
            </div>
            <div class="program-copy">
              <h3>
                {activity.mobileTitle && <span class="program-mobile">{activity.mobileTitle}</span>}
                {activity.desktopTitle ? (
                  <>
                    <span class="program-tablet">{activity.title}</span>
                    <span class="program-desktop">
                      {activity.desktopTitle[0]}<br />{' '}{activity.desktopTitle[1]}
                    </span>
                  </>
                ) : (
                  <span class:list={[activity.mobileTitle && 'program-expanded']}>{activity.title}</span>
                )}
              </h3>
              <p class="program-mobile">{activity.mobileDescription}</p>
              <p class="program-expanded">{activity.description}</p>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="program-close">
      <p class="program-expanded">Conoce el espacio donde puede compartir sus días.</p>
      <Cta label="Recorrer el centro" href="#recorrido" />
    </div>
  </div>
</section>

<style>
  .program {
    position: relative;
    isolation: isolate;
    overflow: clip;
  }

  .program-inner {
    position: relative;
    /* Recorrido provides the other half of the space on the shared light surface. */
    padding-block: var(--space-section) calc(var(--space-section) / 2);
  }

  .program-decoration {
    position: absolute;
    z-index: -1;
    inset: 0;
    pointer-events: none;
  }

  .program-leaves--left { display: none; }

  .program-leaves--right {
    position: absolute;
    inset-block-end: 0;
    inset-inline-end: .125rem;
    inline-size: clamp(3.25rem, 12vw, 4rem);
    max-block-size: 5.5rem;
    block-size: auto;
    object-fit: contain;
    rotate: 15deg;
    opacity: .62;
  }

  @media (48rem <= width < 75rem) {
    .program-decoration { display: none; }
  }

  @media (min-width: 75rem) {
    .program-inner {
      --program-gutter: clamp(4.625rem, 7vw, 8.5rem);
      width: calc(100% - var(--program-gutter) * 2);
    }

    .program-decoration img {
      display: block;
      position: absolute;
      inline-size: clamp(7rem, 9.4vw, 10rem);
      block-size: auto;
      max-block-size: none;
      opacity: .77;
      scale: -1 1;
    }

    .program-leaves--left {
      inset-block-start: 36%;
      inset-inline-start: calc(.75rem - var(--program-gutter));
      rotate: -8deg;
    }

    .program-leaves--right {
      inset-block: 50% auto;
      inset-inline-end: calc(1rem - var(--program-gutter));
      rotate: 5deg;
    }
  }

  .program-heading {
    display: grid;
    align-items: center;
    gap: var(--space-related);
    margin-block-end: var(--section-gap);
  }

  .program-heading em,
  .program-title-default {
    display: block;
  }

  .program-heading em {
    color: var(--color-oak);
  }

  .program-tablet,
  .program-desktop,
  .program-expanded,
  .program-title-tablet {
    display: none;
  }

  .program-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-inset);
  }

  .program-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: var(--space-detail);
    overflow: hidden;
    border-radius: 24px;
  }

  .program-photo {
    position: relative;
    flex: none;
    width: 100%;
    height: 142px;
    overflow: hidden;
    border-radius: 20px;
  }

  .program-photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .program-card--cognitive .program-photo { height: 176px; }

  .program-card--health .program-photo,
  .program-card--integral .program-photo { height: 160px; }

  .program-card--health .program-photo img { object-position: center 22%; }
  .program-card--integral .program-photo img { object-position: center 12%; }

  .program-content {
    display: flex;
    align-items: flex-start;
    gap: var(--space-related);
    min-width: 0;
    padding: var(--space-related);
  }

  .program-copy {
    min-width: 0;
  }

  .program-symbol {
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    aspect-ratio: 1;
    border-radius: 50%;
  }

  .program-card h3 {
    color: var(--color-forest);
    font-size: var(--text-item);
    line-height: var(--leading-item);
  }

  .program-card p {
    margin-block-start: calc(var(--space-detail) / 2);
  }

  .program-card--art {
    background: var(--surface-forest);
    color: var(--color-cream);
    box-shadow: var(--shadow-card);
  }

  .program-card--art h3 { color: inherit; }

  .program-card--physio {
    --program-physio-accent: #d3bd99;
    --glass-fill: linear-gradient(145deg,
      color-mix(in srgb, var(--color-paper) 68%, var(--program-physio-accent)),
      var(--color-honey) 48%,
      var(--program-physio-accent));
    --glass-sheen: var(--glass-sheen-clear);
  }

  .program-card:is(.program-card--art, .program-card--physio) {
    padding: 0;
  }

  .program-card:is(.program-card--art, .program-card--physio) .program-content {
    padding: var(--space-inset);
  }

  .program-close {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-related);
    margin-block-start: var(--section-gap);
  }

  .program-close :global(.cta) {
    flex: 0 0 auto;
  }

  .program-close p {
    color: var(--color-forest);
    font: 700 var(--text-subheading) / var(--leading-title) var(--font-display);
  }

  @media (min-width: 768px) {
    .program-heading {
      grid-template-columns: minmax(0, 364fr) minmax(0, 316fr);
      gap: var(--section-gap);
    }

    .program-mobile,
    .program-title-default {
      display: none;
    }

    .program-tablet,
    .program-expanded,
    .program-title-tablet {
      display: block;
    }

    .program-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .program-card--physio { grid-column: 1 / -1; }

    .program-card .program-photo { height: 180px; }
    .program-card--group .program-photo { height: 134px; }
    .program-card--health .program-photo img { object-position: center 25%; }
    .program-card--integral .program-photo img { object-position: center 32%; }

    .program-content {
      flex-direction: column;
    }

    .program-card--art {
      justify-content: center;
    }

    .program-card--physio .program-content {
      flex-direction: row;
      align-items: center;
    }

    .program-card p { margin-block-start: var(--space-detail); }
    .program-card--physio p { max-width: 490px; }

    .program-close {
      align-items: center;
    }
  }

  @media (min-width: 1200px) {
    .program-heading {
      grid-template-columns: 960fr 624fr;
    }

    .program-tablet,
    .program-title-tablet {
      display: none;
    }

    .program-desktop,
    .program-title-default {
      display: block;
    }

    .program-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .program-card {
      grid-column: span 2;
      border-radius: 28px;
    }

    .program-card--cognitive {
      grid-column: span 4;
      grid-template-columns: 552fr 544fr;
    }

    .program-card--cognitive,
    .program-card--reminiscence {
      min-block-size: clamp(21rem, 24vw, 28rem);
    }

    .program-card--art { justify-content: flex-start; }

    .program-card--health,
    .program-card--integral {
      grid-column: span 3;
      min-block-size: clamp(20rem, 23vw, 27rem);
    }

    .program-card--health { grid-template-columns: 428fr 384fr; }
    .program-card--integral { grid-template-columns: 384fr 428fr; }

    .program-card:is(.program-card--cognitive, .program-card--health, .program-card--integral) {
      display: grid;
    }

    .program-card:is(.program-card--cognitive, .program-card--health, .program-card--integral) .program-photo {
      height: 100%;
    }

    .program-card--reminiscence .program-photo { height: clamp(155px, 11.25vw, 216px); }
    .program-card--group .program-photo { height: clamp(92px, 7.5vw, 144px); }
    .program-card--health .program-photo { order: 1; }
    .program-card--health .program-photo img,
    .program-card--integral .program-photo img { object-position: center; }

    .program-content {
      padding: var(--space-inset);
    }

    .program-card--physio .program-content {
      flex-direction: column;
      align-items: flex-start;
    }

    .program-symbol {
      width: 48px;
    }

  }
</style>
