---
import { Image } from 'astro:assets';
import clay from '../assets/approach/clay.png';
import group from '../assets/program/group.png';
---

<section class="story" aria-labelledby="story-title" data-story>
  <div class="story-stage" data-story-stage>
    <div class="story-backdrop" data-story-backdrop aria-hidden="true"></div>
    <div class="container story-acts">
      <div class="story-beat story-opening">
        <h2 class="story-title" id="story-title" data-story-title>
          La vida, en los <em>pequeños momentos.</em>
        </h2>
        <div class="story-detail" aria-hidden="true">
          <Image src={clay} alt="" widths={[360, 576, 768, 1200]}
            sizes="(min-width: 48rem) 38vw, 94vw" format="webp" loading="lazy" />
        </div>
      </div>

      <div class="story-beat story-discovery">
        <h3 class="story-title" data-story-discovery>
          Tiempo para hacer <em>lo que disfruta.</em>
        </h3>
        <div class="story-portrait" data-story-portrait>
          <Image src={clay} alt="Una mujer mayor muestra dos figuras de arcilla de colores en las palmas de sus manos."
            widths={[360, 576, 768, 960, 1200]}
            sizes="(min-width: 75rem) min(35vw, 61svh), (min-width: 60rem) min(44vw, 61svh), (min-width: 48rem) 43vw, 88vw"
            format="webp" loading="lazy" />
        </div>
      </div>

      <div class="story-beat story-encounter">
        <h3 class="story-title" data-story-encounter>
          Y con quién <em>compartirlo.</em>
        </h3>
        <div class="story-group" data-story-group>
          <Image src={group} alt="Dos mujeres se inclinan sobre sus cartones y colocan fichas en un juego de mesa compartido."
            widths={[480, 720, 960, 1200]} sizes="(min-width: 75rem) 75vw, (min-width: 48rem) 85vw, 170vw"
            format="webp" loading="lazy" />
        </div>
      </div>
    </div>

    <div class="story-resolution" data-story-resolution>
      <h3 class="story-title">A su propio ritmo. <em>Sin dejar de ser quien es.</em></h3>
    </div>
  </div>
</section>

<style>
  .story {
    --story-radius: .875rem;
    background: var(--color-cream);
  }

  .story-stage { position: relative; }

  .story-backdrop {
    position: absolute;
    inset: 0;
    background: var(--color-forest);
  }

  .story-acts {
    position: relative;
    display: grid;
    gap: clamp(4rem, 9vw, 8rem);
    padding-block: clamp(4rem, 8vw, 7rem);
  }

  .story-beat {
    display: grid;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 3rem);
  }

  .story-title {
    color: var(--color-paper);
    font-size: clamp(2.5rem, 5.2vw, 6rem);
    line-height: .99;
    letter-spacing: -.025em;
    text-wrap: balance;
  }

  .story-title em {
    display: block;
    color: var(--color-honey);
  }

  .story-detail,
  .story-portrait,
  .story-group {
    overflow: hidden;
    border-radius: var(--story-radius);
    background: var(--color-section-forest);
  }

  .story-beat img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .story-detail {
    inline-size: min(94%, 38rem);
    justify-self: end;
    aspect-ratio: 16 / 9;
  }

  .story-detail img { object-position: center 88%; }

  .story-portrait {
    inline-size: min(88%, 36rem);
    aspect-ratio: 3 / 4;
  }

  .story-group {
    aspect-ratio: 5 / 4;
  }

  .story-group img { object-position: 44% center; }

  .story-resolution {
    position: relative;
    display: grid;
    place-items: center;
    padding: clamp(4.75rem, 11vw, 9rem) var(--page-gutter);
    background: var(--color-cream);
    text-align: center;
  }

  .story-resolution .story-title { color: var(--color-ink); }
  .story-resolution em { color: var(--color-oak); }

  @media (min-width: 48rem) {
    .story-opening,
    .story-discovery {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .story-discovery .story-title { grid-column: 2; }
    .story-discovery .story-portrait { grid-area: 1 / 1; }
    .story-detail,
    .story-portrait { inline-size: 100%; }
    .story-group { aspect-ratio: 20 / 9; }
  }

  @media (min-width: 75rem) {
    .story-acts { inline-size: min(84%, 88rem); }
    .story-portrait { inline-size: min(86%, 36rem); }
    .story-encounter .story-title { margin-inline-start: 8%; }
  }

  @media (prefers-reduced-motion: no-preference) and (orientation: landscape) and (min-width: 60rem) and (min-height: 40rem) {
    .story {
      --story-height: calc(100svh - var(--header-block-size));
      --story-travel: 165svh;
      min-block-size: calc(var(--story-height) + var(--story-travel));
    }

    .story:not([data-story-playing]) .story-stage {
      display: flex;
      flex-direction: column;
      /* Keep the content below Story in place while the photographs decode. */
      min-block-size: inherit;
    }

    .story:not([data-story-playing]) .story-acts {
      flex: 1;
      align-content: space-evenly;
      gap: min(5svh, 4rem);
      padding-block: min(5svh, 4rem);
    }

    .story:not([data-story-playing]) .story-portrait { inline-size: min(100%, 52svh, 36rem); }
    .story:not([data-story-playing]) .story-detail { max-block-size: 38svh; }
    .story:not([data-story-playing]) .story-encounter { inline-size: min(100%, 75rem); }
  }

  @media (min-width: 75rem) {
    .story { --story-travel: 235svh; }
  }

  .story[data-story-playing] .story-stage {
    position: sticky;
    inset-block-start: var(--header-block-size);
    block-size: var(--story-height);
    isolation: isolate;
    overflow: clip;
  }

  .story[data-story-playing] .story-acts {
    --story-portrait-width: min(47%, calc(var(--story-height) * .61), 40rem);
    --story-portrait-inset: clamp(1.5rem, 7%, 8.5rem);
    display: block;
    block-size: 100%;
    padding-block: 0;
  }

  .story[data-story-playing] .story-opening,
  .story[data-story-playing] .story-discovery {
    position: absolute;
    inset: 0;
    grid-template: minmax(0, 1fr) / minmax(0, 1fr);
    gap: 0;
  }

  .story[data-story-playing] .story-detail { display: none; }

  .story[data-story-playing] :is(.story-opening, .story-discovery) > .story-title {
    grid-area: 1 / 1;
    max-inline-size: calc(100% - var(--story-portrait-width) - var(--story-portrait-inset) - clamp(1.5rem, 2.5vw, 3rem));
    z-index: 1;
  }

  .story[data-story-playing] .story-discovery > .story-title,
  .story[data-story-playing] .story-encounter > .story-title,
  .story[data-story-playing] .story-group {
    opacity: 0;
  }

  .story[data-story-playing] .story-portrait {
    grid-area: 1 / 1;
    justify-self: end;
    margin-inline-end: var(--story-portrait-inset);
    inline-size: var(--story-portrait-width);
    clip-path: inset(var(--story-mask-top) var(--story-mask-side) var(--story-mask-bottom) round var(--story-radius));
  }

  .story[data-story-playing] .story-portrait img { transform-origin: 50% 76%; }

  .story[data-story-playing] .story-encounter {
    position: absolute;
    inset: 0;
    grid-template-columns: min(100%, calc(var(--story-height) * 1.48), 75rem);
    place-content: center;
    gap: clamp(1rem, 2.5svh, 2rem);
  }

  .story[data-story-playing] .story-encounter > .story-title {
    grid-row: 2;
    margin: 0;
    font-size: clamp(2.5rem, min(5vw, 7.4svh), 5.25rem);
  }

  .story[data-story-playing] .story-encounter em { display: inline; }

  .story[data-story-playing] .story-resolution {
    position: absolute;
    inset: 0;
    padding-block: 0;
    opacity: 0;
    background: transparent;
    pointer-events: none;
  }

  @media (min-width: 60rem) and (max-width: 74.999rem) {
    .story[data-story-playing] .story-acts { --story-portrait-inset: clamp(.5rem, 3%, 2rem); }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) and (width < 60rem), (prefers-reduced-motion: no-preference) and (orientation: portrait) {
      .story:not([data-story-playing]) .story-beat > .story-title {
        animation: story-read-in linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 100%;
      }
    }

    @keyframes story-read-in {
      from { opacity: .84; transform: translateY(.35rem); }
    }
  }
</style>
