---
import { Image } from 'astro:assets';
import Cta from '../components/Cta.astro';
import portrait from '../assets/story/manos-creando.jpg';
import hands from '../assets/story/detalle-cuentas.jpg';
import garden from '../assets/story/ronda-en-el-jardin.jpg';
import bingo from '../assets/story/bingo-en-el-roble.jpg';
import acorns from '../assets/botanical/day-oak-acorns.webp';
import oakTwig from '../assets/botanical/story-oak-twig.webp';
import oakWood from '../assets/botanical/story-oak-wood.webp';

const botanicalArt = {
  acorns: { src: acorns, sizes: 'clamp(3.75rem, 7vw, 6rem)' },
  wood: { src: oakWood, sizes: 'clamp(4.75rem, 8vw, 7.25rem)' },
  twig: { src: oakTwig, sizes: 'clamp(4rem, 6.5vw, 5.5rem)' },
};

const scenes = [
  {
    key: 'hands',
    anchor: 'historia',
    heading: 'Una mañana',
    emphasis: 'en El Roble.',
    copy: 'En nuestro centro de día en Arequipa, hay tiempo para hacer algo con las manos, moverse y disfrutar de la compañía de otros.',
    botany: ['acorns', 'wood'] as const,
    image: portrait,
    alt: 'Una mujer ensarta cuentas de colores en una mesa de El Roble.',
  },
  {
    key: 'workshop',
    anchor: 'historia-taller',
    heading: 'Cada quien',
    emphasis: 'a su propio ritmo.',
    copy: 'Una ronda en el jardín invita a dar unos pasos y disfrutar juntos del aire libre.',
    botany: ['twig'] as const,
    image: garden,
    alt: 'Varias personas se toman de las manos en una ronda en el jardín de El Roble.',
  },
  {
    key: 'table',
    anchor: 'historia-compania',
    heading: 'La alegría',
    emphasis: 'de estar juntos.',
    botany: [] as const,
    image: bingo,
    alt: 'Personas mayores y acompañantes juegan bingo en el salón de El Roble.',
  },
];

const widths = [400, 640, 800, 1024, 1440];
const portraitSizes = '(min-width: 62rem) 42vw, (min-width: 48rem) 47vw, 96vw';
const gardenSizes = '(min-width: 48rem) 49vw, 90vw';
---

<section class="story" id="historia" tabindex="-1" aria-labelledby="story-title" data-story>
  <div class="story__reel" data-story-reel>
    <span class="story__cue" data-story-cue aria-hidden="true"></span>
    <span class="story__cue" data-story-cue aria-hidden="true"></span>
    <span class="story__cue" data-story-cue aria-hidden="true"></span>

    <div class="story__stage">
      {scenes.map((scene, index) => {
        const Title = index === 0 ? 'h2' : 'h3';
        const titleId = index === 0 ? 'story-title' : `${scene.anchor}-titulo`;
        return (
          <article
            class:list={['story__scene', `story__scene--${scene.key}`]}
            id={index ? scene.anchor : undefined}
            data-story-scene
            aria-labelledby={titleId}
            tabindex={index ? -1 : undefined}
          >
            <div class="container story__composition">
              <div class="story__copy" data-story-copy>
                <Title id={titleId}>{scene.heading} <em>{scene.emphasis}</em></Title>
                {scene.copy && <p>{scene.copy}</p>}
                {scene.botany.length > 0 && (
                  <div class="story__botany" aria-hidden="true">
                    {scene.botany.map((piece) => {
                      const { src, sizes } = botanicalArt[piece];
                      return (
                        <Image class:list={['story__botanical', `story__botanical--${piece}`]}
                          {src} {sizes} alt="" width={192} widths={[64, 96, 144, 192, 256, 320]}
                          style={`--story-botanical-width: ${sizes}`} format="webp" loading="lazy" decoding="async" />
                      );
                    })}
                  </div>
                )}
              </div>
              <figure class="story__photo">
                <div class="story__frame" data-story-frame>
                  <Image
                    src={scene.image}
                    alt={scene.alt}
                    widths={scene.key === 'table' ? [...widths, 1800, 2048] : widths}
                    sizes={scene.key === 'table' ? '100vw' : scene.key === 'workshop' ? gardenSizes : portraitSizes}
                    format="webp"
                    quality={82}
                    loading={index === 0 ? 'eager' : 'lazy'}
                    decoding="async"
                    data-story-image
                  />
                </div>
                {index === 0 && (
                  <div class="story__detail" aria-hidden="true" data-story-detail>
                    <Image
                      src={hands}
                      alt=""
                      widths={[280, 440, 760]}
                      sizes="(min-width: 62rem) 18vw, 280px"
                      format="webp"
                      quality={86}
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                )}
              </figure>
              {scene.key === 'table' && (
                <div class="story__visit" id="historia-visita" data-story-visit tabindex="-1" role="group" aria-label="Visita a El Roble">
                  <p>Ven a conocer El Roble y conversemos sobre lo que necesita tu familia.</p>
                  <Cta variant="light" />
                </div>
              )}
            </div>
          </article>
        );
      })}
    </div>
  </div>
</section>

<style>
  .story {
    --story-radius: clamp(.875rem, 1.2vw, 1.25rem);
    --story-panel-radius: clamp(1.25rem, 2.25vw, 2rem);
    --story-edge: clamp(.75rem, 1.6vw, 1.5rem);
  }

  .story__reel {
    position: relative;
  }

  :is(.story, .story__scene, .story__visit):focus {
    outline: none;
  }

  .story__cue {
    display: none;
  }

  .story__scene {
    --story-ink: var(--color-ink);
    --story-accent: var(--color-oak);
    position: relative;
    isolation: isolate;
    padding-block: var(--section-gap);
    color: var(--color-text);
  }

  /* Split the transition between the two scenes on the continuous light surface. */
  .story__scene--hands { padding-block-end: calc(var(--space-section) / 2); }
  .story__scene--workshop { padding-block-start: calc(var(--space-section) / 2); }

  .story__scene--table {
    --story-ink: var(--color-paper);
    --story-accent: var(--color-honey);
    border-radius: var(--story-panel-radius);
    background: var(--surface-forest);
    color: var(--color-on-forest-muted);
  }

  .story__scene:is(.story__scene--workshop, .story__scene--table) {
    margin-inline: var(--story-edge);
  }

  .story__composition {
    display: grid;
    gap: var(--section-gap);
  }

  .story__scene:is(.story__scene--workshop, .story__scene--table) .story__composition {
    width: calc(100% - max(.75rem, var(--page-gutter) - var(--story-edge)) * 2);
  }

  .story__copy {
    position: relative;
    z-index: 1;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: var(--space-related);
    min-inline-size: 0;
  }

  .story__copy :is(h2, h3) {
    color: var(--story-ink);
    font-size: var(--text-section);
  }

  .story__copy em {
    display: block;
    padding-block-end: .06em;
    color: var(--story-accent);
  }

  .story__copy p {
    max-inline-size: 48ch;
  }

  .story__botany {
    display: flex;
    align-items: end;
    gap: clamp(.75rem, 1.25vw, 1rem);
    pointer-events: none;
  }

  .story__botanical {
    flex: none;
    inline-size: var(--story-botanical-width);
    block-size: auto;
  }

  .story__botanical--wood { margin-block-end: .375rem; }
  .story__botanical--twig {
    transform-origin: left bottom;
    rotate: 17deg;
  }

  .story__photo {
    position: relative;
    min-inline-size: 0;
  }

  .story__frame {
    aspect-ratio: 5 / 4;
    overflow: hidden;
    border-radius: var(--story-radius);
    background: var(--color-sand);
  }

  .story__scene--table .story__frame {
    background: var(--color-section-forest);
  }

  .story__frame img,
  .story__detail img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .story__scene--hands .story__frame {
    aspect-ratio: 7 / 8;
    border-start-start-radius: clamp(3.5rem, 9vw, 9rem);
  }

  .story__scene--hands .story__frame img {
    object-position: 50% 40%;
    transform-origin: 52% 45%;
  }

  .story__scene--workshop .story__frame {
    aspect-ratio: 4 / 5;
  }

  .story__scene--workshop img {
    object-position: 50% 74%;
  }

  .story__scene--table .story__frame {
    aspect-ratio: 5 / 3;
  }

  .story__scene--table img {
    object-position: 50% 34%;
    transform-origin: 55% 66%;
  }

  .story__detail {
    display: none;
  }

  .story__visit {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: start;
    gap: var(--space-related);
  }

  .story__visit p {
    max-inline-size: 28ch;
  }

  @media (min-width: 48rem) {
    .story__scene:is(.story__scene--hands, .story__scene--workshop) .story__composition {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
    }

    .story__scene--workshop .story__photo {
      grid-area: 1 / 1;
    }

    .story__scene--table .story__frame {
      aspect-ratio: 2.2;
    }

  }

  /* The base layout remains a continuous photo essay on short screens and
     when motion is disabled. Only the enhanced reel stacks its scenes. */
  .story[data-story-cinema] {
    --story-viewport: calc(100svh - var(--header-block-size));
    /* Scroll distance for the chapter cues and timeline. */
    --story-travel: clamp(68rem, 168svh, 98rem);
  }

  [data-story-cinema] .story__reel {
    block-size: calc(var(--story-viewport) + var(--story-travel));
    isolation: isolate;
  }

  [data-story-cinema] .story__stage {
    position: sticky;
    inset-block-start: var(--header-block-size);
    block-size: var(--story-viewport);
    overflow: clip;
    isolation: isolate;
  }

  [data-story-cinema] .story__cue {
    display: block;
    position: absolute;
    inset-block-start: calc(var(--story-travel) * var(--cue-progress));
    inset-inline-start: 0;
    pointer-events: none;
  }

  [data-story-cinema] .story__scene {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-rows: minmax(0, 1fr);
    align-items: center;
    padding-block: clamp(1.5rem, 4.8svh, 3.65rem);
  }

  [data-story-cinema] .story__scene:is(.story__scene--workshop, .story__scene--table) {
    inset: var(--story-edge);
    margin: 0;
    overflow: clip;
  }

  [data-story-cinema] .story__composition {
    grid-template-columns: minmax(0, .95fr) minmax(0, 1.05fr);
    align-items: center;
    block-size: 100%;
    min-block-size: 0;
  }

  [data-story-cinema] .story__scene--hands .story__photo {
    align-self: stretch;
    justify-self: center;
    display: grid;
    grid-template-rows: minmax(0, 1fr);
    inline-size: min(100%, calc(var(--story-viewport) * .71));
    min-block-size: 0;
  }

  [data-story-cinema] .story__scene--hands .story__frame {
    aspect-ratio: auto;
    box-shadow: var(--shadow-raised);
  }

  [data-story-cinema] .story__detail {
    position: absolute;
    z-index: 1;
    inset: auto auto 8% -16%;
    display: block;
    inline-size: 44%;
    aspect-ratio: 5 / 3;
    overflow: hidden;
    border-radius: var(--story-radius);
    box-shadow: var(--shadow-raised);
  }

  [data-story-cinema] .story__detail img {
    object-position: 50% 49%;
  }

  [data-story-cinema] .story__scene--workshop .story__composition {
    grid-template-columns: minmax(0, 1.18fr) minmax(0, .82fr);
    column-gap: clamp(2rem, 5vw, 5.5rem);
  }

  [data-story-cinema] .story__scene--workshop {
    --story-reveal: 100%;
    background: var(--color-cream);
    clip-path: inset(var(--story-reveal) 0 0 round var(--story-panel-radius));
  }

  [data-story-cinema] .story__scene--workshop .story__frame {
    aspect-ratio: 1;
    max-block-size: calc(var(--story-viewport) - 8rem);
    border-end-end-radius: clamp(4rem, 9vw, 9rem);
  }

  [data-story-cinema] .story__scene--table .story__composition {
    grid-template-columns: minmax(0, 1.75fr) minmax(0, .8fr);
    align-content: end;
    align-items: end;
    column-gap: clamp(2rem, 4.2vw, 4.5rem);
  }

  [data-story-cinema] .story__scene--table {
    --story-reveal-top: 58%;
    --story-reveal-bottom: 32%;
    --story-reveal-inline: 50%;
    clip-path: inset(var(--story-reveal-top) var(--story-reveal-inline) var(--story-reveal-bottom) round var(--story-panel-radius));
  }

  [data-story-cinema] .story__scene--table .story__photo {
    position: absolute;
    inset: 0;
  }

  [data-story-cinema] .story__scene--table .story__frame {
    block-size: 100%;
    aspect-ratio: auto;
    border-radius: inherit;
  }

  [data-story-cinema] .story__scene--table .story__photo::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 29%, color-mix(in srgb, var(--color-forest) 66%, transparent) 69%, var(--color-forest) 100%);
    content: '';
    pointer-events: none;
  }

</style>
