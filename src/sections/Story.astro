---
import { Image } from 'astro:assets';
import workshop from '../assets/opening/day-painting.png';
---

<section class="story" id="historia" aria-labelledby="story-title" data-story>
  <div class="container story__scene" data-story-scene>
    <div class="story__intro">
      <h2 id="story-title">Detrás de <em>la huella.</em></h2>
      <p>Una mañana en el taller de pintura de El Roble.</p>
    </div>

    <figure class="story__portrait" data-story-aperture>
      <Image
        src={workshop}
        alt="Una participante sonríe y muestra la palma pintada junto a las huellas que dejó en el papel."
        widths={[320, 480, 640]}
        sizes="(min-width: 72rem) 640px, (min-width: 48rem) 56vw, calc(100vw - 1.5rem)"
        format="webp"
        loading="lazy"
        data-story-camera
      />
    </figure>
  </div>
</section>

<style>
  .story {
    background: var(--color-cream);
    padding-block: clamp(2.5rem, 4.5vw, 4rem) clamp(2rem, 3.7vw, 3.25rem);
  }

  .story__scene {
    display: grid;
    align-items: center;
    gap: var(--section-gap);
  }

  .story__intro h2 {
    font-size: clamp(2.875rem, 5.7vw, 5.5rem);
    letter-spacing: -.028em;
    line-height: .98;
  }

  .story__intro em {
    display: block;
    color: var(--color-oak);
  }

  .story__intro p {
    max-inline-size: 25ch;
    margin-block-start: clamp(.75rem, 1.25vw, 1.125rem);
  }

  .story__portrait {
    --story-radius: clamp(1rem, 2vw, 1.75rem);
    position: relative;
    overflow: hidden;
    aspect-ratio: 1 / 1.12;
    border-radius: var(--story-radius);
    background: var(--color-sand);
  }

  .story__portrait img {
    /* The painted palm is at (236, 529) in the 640 × 853 source. */
    position: absolute;
    inset: -11% 0 auto;
    display: block;
    inline-size: 100%;
    block-size: auto;
    transform-origin: 36.875% 62%;
  }

  @media (min-width: 40rem) {
    .story__portrait { aspect-ratio: 1.02; }
    .story__portrait img { inset-block-start: -12%; }
  }

  @media (min-width: 48rem) {
    .story__scene {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.68fr);
    }

    .story__intro {
      align-self: start;
      margin-block-start: clamp(2.5rem, 11vw, 10.5rem);
    }

    .story__portrait {
      justify-self: end;
      inline-size: min(100%, 43rem, max(30rem, (100svh - var(--header-block-size) - 4rem) * 1.02));
    }
  }
</style>
