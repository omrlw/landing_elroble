---
import { Image } from 'astro:assets';
import AmbientLight from '../components/AmbientLight.astro';
import GalleryPlayback from '../components/GalleryPlayback.astro';
import carmen from '../assets/lower/testimonial-carmen.png';
import jorge from '../assets/lower/testimonial-jorge.png';
import patricia from '../assets/lower/testimonial-patricia.png';
import { reviews } from '../config/reviews';

const avatars = { carmen, jorge, patricia };
const placements = [
  [1, 1, 45], [2, 1, 55], [1, 48, 96], [2, 58, 96],
  [3, 1, 49], [4, 1, 49], [3, 52, 96], [4, 52, 96],
  [5, 1, 45], [6, 1, 49], [5, 48, 96], [6, 52, 96],
];
---

<section class="testimonials" id="testimonios" aria-labelledby="testimonials-heading" data-reviews>
  <AmbientLight profile="sweep" tone="forest" />
  <header class="container review-opening" data-reveal="heading">
    <h2 id="testimonials-heading">La tranquilidad,<br /><em>en sus palabras.</em></h2>
    <p>Historias de familias que encontraron en El Roble tranquilidad, compañía y un cuidado digno para quienes más quieren.</p>
  </header>

  <div class="container review-container" data-reveal="rail">
    <ul class="review-track" id="review-track" tabindex="0" aria-label="Reseñas de familias" data-review-track>
      {reviews.map((review, index) => {
        const [column, start, end] = placements[index];
        const popover = `review-${index + 1}`;
        const avatar = review.avatar ? avatars[review.avatar] : undefined;

        return (
          <li
            class:list={['review-card liquid-glass liquid-glass--reading', { featured: review.featured }]}
            style={`--column:${column};--start:${start};--end:${end}`}
          >
            <div class="review-body">
              <span class="quote-mark" aria-hidden="true">“</span>
              <blockquote>
                <p class="quote">{review.excerpt ?? review.quote}</p>
                <p class="tablet-quote">{review.tabletQuote}</p>
              </blockquote>
              {review.excerpt && (
                <button type="button" class="read-review liquid-glass liquid-glass--clear liquid-glass--interactive" popovertarget={popover} aria-label={`Leer reseña de ${review.name}`}>
                  Leer reseña
                </button>
              )}
            </div>

            <div class="author">
              {avatar ? (
                <Image class="avatar" src={avatar} alt="" widths={[40, 52, 104]} sizes="(min-width: 80rem) 52px, 40px" />
              ) : (
                <span class="avatar liquid-glass liquid-glass--clear liquid-glass--lens" aria-hidden="true">{review.initials}</span>
              )}
              <div class="identity">
                <p class="name">{review.name}</p>
                <p class="relationship">Familia de residente</p>
                <div class="rating" role="img" aria-label={`${review.rating} estrellas de 5`}>
                  <span class="stars" aria-hidden="true">
                    {Array.from({ length: 5 }, (_, star) => (
                      <svg class:list={['star', { 'star--empty': star >= review.rating }]} width="14" height="14" viewBox="0 0 14 14">
                        <path d="M7 1.26 8.75 4.97 12.74 5.46 9.8 8.26 10.57 12.25 7 10.22 3.43 12.25 4.2 8.26 1.26 5.46 5.25 4.97Z" />
                      </svg>
                    ))}
                  </span>
                  <span class="rating-caption" aria-hidden="true">{review.rating} estrellas</span>
                </div>
              </div>
            </div>
          </li>
        );
      })}
    </ul>
  </div>

  {reviews.map((review, index) => review.excerpt && (
    <dialog class="review-popover liquid-glass liquid-glass--reading" id={`review-${index + 1}`} popover="auto" aria-labelledby={`review-title-${index + 1}`}>
      <h3 id={`review-title-${index + 1}`}>{review.name}</h3>
      <blockquote><p>“{review.quote}”</p></blockquote>
      <button class="liquid-glass liquid-glass--clear liquid-glass--interactive" type="button" autofocus popovertarget={`review-${index + 1}`} popovertargetaction="hide">Cerrar reseña</button>
    </dialog>
  ))}

  <div class="review-controls">
    <div class="gallery-pagination" role="group" aria-label="Explorar reseñas" data-review-pagination data-gallery-pagination hidden>
      {Array.from({ length: 4 }, (_, index) => (
        <button type="button" data-gallery-dot aria-label={`Ver grupo de reseñas ${index + 1}`} aria-controls="review-track" aria-pressed={index === 0 ? 'true' : 'false'}>
          <span data-gallery-mark aria-hidden="true"></span>
        </button>
      ))}
      <GalleryPlayback controls="review-track" />
    </div>
    <p>Desliza para ver más reseñas</p>
  </div>
</section>

<script>
  import { setupSnapTrack } from '../scripts/gallery';

  const tablet = matchMedia('(min-width: 40rem) and (max-width: 79.999rem)');
  for (const section of document.querySelectorAll<HTMLElement>('[data-reviews]')) {
    const track = section.querySelector<HTMLElement>('[data-review-track]');
    const buttons = [...section.querySelectorAll<HTMLButtonElement>('[data-review-pagination] [data-gallery-dot]')];
    if (track && track.children.length > 1) {
      setupSnapTrack(track, buttons, {
        playbackArea: section,
        pageCount: () => tablet.matches ? 4 : 3,
        readingTime: 12000,
      });
    }
    if (!('showPopover' in HTMLElement.prototype) && typeof HTMLDialogElement !== 'undefined' && 'showModal' in HTMLDialogElement.prototype) {
      for (const button of section.querySelectorAll<HTMLButtonElement>('.read-review')) {
        const dialog = document.getElementById(button.getAttribute('popovertarget') ?? '');
        if (!(dialog instanceof HTMLDialogElement)) continue;
        button.addEventListener('click', () => dialog.showModal());
      }
      for (const dialog of section.querySelectorAll('dialog')) {
        dialog.querySelector('button')?.addEventListener('click', () => dialog.close());
      }
    }
  }
</script>

<style>
  .testimonials {
    --ambient-y: 0px;
    --ambient-shift: -33%;
    --ambient-size: clamp(13rem, 25vw, 25rem);
    --ambient-aspect: 1.8;
    --ambient-crop: 23%;
    --track-gap: var(--space-related);
    position: relative;
    isolation: isolate;
    background: var(--surface-forest);
    color: var(--color-cream);
    padding-block: var(--space-section) var(--section-gap);
    border-radius: 1.25rem;
  }

  .review-opening {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    margin-block-end: var(--section-gap);
  }
  .review-opening h2 {
    margin: 0;
    color: inherit;
    min-width: 0;
    overflow-wrap: break-word;
  }
  .review-opening em { font-weight: inherit; }
  .review-opening p { display: none; }

  .review-container { overflow: clip; }
  @media (width < 80rem) {
    .review-container { width: auto; }
  }
  .review-track {
    --review-gutter: var(--page-gutter);
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(78%, 19rem);
    gap: var(--track-gap);
    list-style: none;
    margin: 0;
    padding: .125rem var(--review-gutter) .625rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--review-gutter);
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .review-track::-webkit-scrollbar { display: none; }
  .review-track:focus-visible { outline-offset: -.25rem; }

  .review-card {
    min-width: 0;
    min-height: 16.5rem;
    display: flex;
    justify-content: space-between;
    flex-direction: column;
    gap: var(--space-related);
    padding: var(--space-related);
    scroll-snap-align: start;
    border: 1px solid transparent;
    border-radius: 1.25rem;
  }

  .review-card.featured { --glass-fill: linear-gradient(var(--color-paper), var(--color-cream) 150%); }
  .review-body blockquote, .review-body p, .author p { margin: 0; }
  .tablet-quote { display: none; }
  .quote-mark {
    display: block;
    block-size: 1.5rem;
    color: var(--color-oak);
    font: 700 var(--text-subheading)/1 var(--font-display);
    opacity: .64;
  }

  .read-review {
    --glass-depth: 0 0 transparent;
    --glass-hover-edge: var(--glass-edge-selected);
    min-height: 2.5rem;
    padding-inline: .875rem;
    margin-block-start: var(--space-detail);
    border-radius: var(--radius-pill);
    font-size: var(--text-meta);
    font-weight: 600;
  }

  .author { display: flex; gap: var(--space-detail); align-items: center; }
  .avatar {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    flex: none;
    object-fit: cover;
    border-radius: 50%;
    font-size: var(--text-meta);
  }
  .author .name { font-weight: 600; font-size: var(--text-control); line-height: var(--leading-control); }
  .author .relationship { color: var(--color-text); font-size: var(--text-meta); }
  .identity { display: flex; flex-direction: column; gap: .2rem; min-width: 0; }
  .rating {
    color: var(--color-text);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    align-self: start;
    gap: .15rem .375rem;
    font-size: var(--text-meta);
  }
  .stars { display: inline-flex; align-items: center; gap: .125rem; color: var(--color-oak); }
  .star { display: block; flex: none; fill: currentColor; }
  .star--empty { fill: none; stroke: currentColor; stroke-width: 1; stroke-linejoin: round; }

  .review-controls { display: grid; justify-items: center; margin-block-start: var(--space-detail); }
  .review-controls p { margin: 0; font-size: var(--text-meta); }

  .review-popover {
    --glass-depth: var(--shadow-raised);
    position: fixed;
    inset: 0;
    box-sizing: border-box;
    max-inline-size: min(34rem, 100% - 2rem);
    max-height: calc(100dvh - 2rem);
    overflow: auto;
    margin: auto;
    border: 1px solid transparent;
    border-radius: var(--radius-card);
    color: var(--color-ink);
    padding: clamp(1.25rem, 4vw, 2.5rem);
  }
  .review-popover::backdrop { background: var(--color-dialog-backdrop); }
  .review-popover:popover-open { display: block; }
  @supports not selector(:popover-open) {
    .review-popover:not([open]) { display: none; }
  }
  .review-popover h3 { margin: 0; }
  .review-popover blockquote { margin: 1rem 0; }
  .review-popover button { border: 1px solid transparent; border-radius: var(--radius-pill); padding: .65rem 1rem; font-size: var(--text-control); font-weight: 600; }

  @media (prefers-reduced-motion: no-preference) {
    @supports (transition-behavior: allow-discrete) and selector(:popover-open) {
      .review-popover {
        opacity: 0;
        translate: 0 .25rem;
        scale: .985;
        transition: opacity var(--motion-exit) var(--ease-soft), translate var(--motion-exit) var(--ease-soft), scale var(--motion-exit) var(--ease-soft), display var(--motion-exit) allow-discrete, overlay var(--motion-exit) allow-discrete;
      }
      .review-popover:popover-open {
        opacity: 1;
        translate: 0 0;
        scale: 1;
        transition-duration: var(--motion-panel);
        transition-timing-function: var(--ease-soft);
      }
      .review-popover::backdrop {
        opacity: 0;
        transition: opacity var(--motion-exit) var(--ease-soft), display var(--motion-exit) allow-discrete, overlay var(--motion-exit) allow-discrete;
      }
      .review-popover:popover-open::backdrop { opacity: 1; transition-duration: var(--motion-panel); }
      @starting-style {
        .review-popover:popover-open { opacity: 0; translate: 0 .5rem; scale: .985; }
        .review-popover:popover-open::backdrop { opacity: 0; }
      }
    }
  }

  @media (max-width: 40rem) {
    .review-popover { max-inline-size: min(34rem, 100% - var(--page-gutter) * 2); }
  }

  @media (min-width: 40rem) {
    .testimonials { --track-gap: var(--space-inset); border-radius: 0; }
    .review-opening { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); gap: var(--section-gap); }
    .review-opening p { display: block; margin: 0; }
    .review-track { grid-auto-columns: clamp(13rem, 27vw, 16rem); }
    .review-card { min-height: 14rem; border-radius: var(--radius-card); }
    .quote, .relationship, .rating-caption { display: none; }
    .tablet-quote { display: block; }
    .avatar { width: 2.25rem; height: 2.25rem; }
  }

  @media (min-width: 80rem) {
    .review-track {
      --review-gutter: 0px;
      min-block-size: clamp(40rem, 39.583vw, 47.5rem);
      grid-auto-columns: max(18rem, calc((100% - var(--track-gap) * 4) / 5));
      grid-template-rows: repeat(95, minmax(0, 1fr));
      row-gap: 0;
    }
    .review-card { grid-column: var(--column); grid-row: var(--start) / var(--end); min-height: 0; border-radius: 1.75rem; }
    .tablet-quote { display: none; }
    .quote, .relationship, .rating-caption { display: block; }
    .avatar { width: clamp(2.5rem, 2.71vw, 3.25rem); height: clamp(2.5rem, 2.71vw, 3.25rem); }
    .review-controls p { display: none; }

  }

</style>
