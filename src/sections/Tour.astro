---
import GalleryPlayback from '../components/GalleryPlayback.astro';
import { Image } from 'astro:assets';
import AmbientLight from '../components/AmbientLight.astro';
import Cta from '../components/Cta.astro';
import TourCaption from '../components/TourCaption.astro';
import activities from '../assets/tour/activities.png';
import details from '../assets/tour/details.png';
import entrance from '../assets/tour/entrance.png';
import BotanicalArt from '../components/BotanicalArt.astro';
import ramp from '../assets/tour/ramp.png';

const entrancePhotos = [
  {
    id: 'entrance' as const,
    photo: entrance,
    label: 'Entrada y jardín',
    desktopLabel: 'Una primera mirada.',
    alt: 'Jardín y camino hacia la entrada del centro.',
  },
  {
    id: 'ramp' as const,
    photo: ramp,
    label: 'Rampa de acceso',
    desktopLabel: 'Un poco más cerca.',
    alt: 'Vista cercana de la rampa que lleva a la entrada del centro.',
  },
];

const interiorPhotos = [
  {
    id: 'activities' as const,
    photo: activities,
    label: 'Salón de actividades',
    desktopLabel: 'La vida que compartimos.',
    alt: 'Salón con mesas y materiales de actividades.',
  },
  {
    id: 'details' as const,
    photo: details,
    label: 'Detalles del salón',
    desktopLabel: 'También en los detalles.',
    alt: 'Materiales y juegos en el salón del centro.',
  },
];

const galleryPhotos = [...entrancePhotos, ...interiorPhotos];
---

<section class="tour" id="recorrido" tabindex="-1" aria-labelledby="tour-title">
  <AmbientLight />
  <div class="container tour-inner">
    <header class="tour-heading botanical-layout" data-reveal="heading">
      <div class="tour-heading-copy">
        <h2 id="tour-title">El Roble,<br /><em>por dentro.</em></h2>
        <div class="tour-wide">
          <h3>Conocer el lugar también forma parte de elegir.</h3>
          <p>Acércate a El Roble, recorre sus ambientes y conoce dónde transcurren las actividades y los encuentros de cada día.</p>
        </div>
        <p class="tour-tablet">Conoce la entrada, el jardín y los salones donde se realizan las actividades.</p>
        <p class="tour-mobile">Un lugar para compartir y sentirse bien.</p>
      </div>
      <BotanicalArt motif="branch" />
    </header>

    <div class="tour-layout">
      <div class="tour-entrance">
        {entrancePhotos.map(({ id, photo, alt, label, desktopLabel }) => (
          <figure class={`tour-photo tour-photo--${id}`} data-reveal="frame" data-glass-scene>
            <Image
              data-reveal-image
              data-glass-image
              src={photo}
              alt={alt}
              format="webp"
              widths={[448, 640, 960, 1200]}
              sizes={id === 'entrance' ? '(max-width: 1199px) 51vw, (max-width: 1920px) 50vw, 960px' : '(max-width: 1199px) 40vw, (max-width: 1920px) 35vw, 656px'}
            />
            <TourCaption icon={id}>
              <span class="tour-tablet">{label}</span>
              <span class="tour-wide">{desktopLabel}</span>
            </TourCaption>
          </figure>
        ))}
      </div>

      {interiorPhotos.map(({ id, photo, alt, label, desktopLabel }) => (
        <figure class={`tour-photo tour-photo--${id}`} data-reveal="frame" data-glass-scene>
          <Image
            data-reveal-image
            data-glass-image
            src={photo}
            alt={alt}
            format="webp"
            widths={[448, 640, 960, 1200]}
            sizes="(max-width: 1199px) 43vw, (max-width: 1920px) 25vw, 480px"
          />
          <TourCaption icon={id}>
            <span class="tour-tablet">{label}</span>
            <span class="tour-wide">{desktopLabel}</span>
          </TourCaption>
        </figure>
      ))}

      <div class="tour-gallery" data-tour-gallery data-reveal="rail">
        <div class="tour-track" id="tour-photos" role="region" aria-label="Galería del centro" tabindex="0">
          {galleryPhotos.map(({ id, photo, alt, label }) => (
            <figure class:list={['tour-slide', (id === 'entrance' || id === 'activities') && `tour-slide--${id}`]} data-glass-scene>
              {/* Cover scales these 1200:540 photos to the card's 420px height before cropping. */}
              <Image src={photo} alt={alt} format="webp" widths={[960, 1200]} sizes="934px" data-glass-image />
              <TourCaption icon={id}>{label}</TourCaption>
            </figure>
          ))}
        </div>
        <div class="gallery-pagination liquid-glass--clear tour-pagination" data-gallery-pagination role="group" aria-label="Seleccionar foto" hidden>
          {galleryPhotos.map(({ label }, index) => (
            <button
              data-gallery-dot
              type="button"
              aria-label={`Ver foto: ${label}`}
              aria-controls="tour-photos"
              aria-current={index === 0 ? 'true' : undefined}
              hidden
            ><span data-gallery-mark aria-hidden="true"></span></button>
          ))}
          <GalleryPlayback controls="tour-photos" />
        </div>
      </div>

      <div class="tour-invitation" data-reveal="heading">
        <h3>Ven a recorrerlo.<br /><em>Conversemos sin prisa.</em></h3>
        <p class="tour-mobile">Conoce el centro y conversemos<br /> sobre tu familiar.</p>
        <p class="tour-expanded">Te invitamos a conocer el centro y<br /> conversar sobre tu familiar.</p>
        <Cta />
      </div>
    </div>
  </div>
</section>

<script>
  import { setupSnapTrack } from '../scripts/gallery';

  for (const gallery of document.querySelectorAll<HTMLElement>('[data-tour-gallery]')) {
    const track = gallery.querySelector<HTMLElement>('.tour-track');
    if (track) setupSnapTrack(track, [...gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-dot]')], { playbackArea: gallery });
  }
</script>

<style>
  .tour {
    --ambient-y: 51%;
    --tour-photo-radius: 24px;
    position: relative;
    isolation: isolate;
    overflow: clip;
  }

  .tour-inner { padding-block: calc(var(--space-section) / 2) var(--section-gap); }

  .tour-heading { margin-block-end: var(--section-gap); }

  .tour-heading-copy {
    display: grid;
    align-items: center;
    gap: var(--space-related) var(--section-gap);
  }

  .tour-heading em { color: var(--color-oak); }

  .tour-wide,
  .tour-tablet,
  .tour-expanded,
  .tour-entrance,
  .tour-photo {
    display: none;
  }

  .tour-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--section-gap);
  }

  .tour-track {
    --tour-slide-gap: 17px;
    --tour-track-tail: 7px;
    display: flex;
    gap: var(--tour-slide-gap);
    position: relative;
    overflow-x: auto;
    border-radius: var(--tour-photo-radius);
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-inline: contain;
    filter: drop-shadow(var(--shadow-cutout));
  }

  .tour-track::after {
    content: "";
    flex: 0 0 var(--tour-track-tail);
  }

  .tour-slide {
    position: relative;
    flex: 0 0 calc(100% - var(--tour-slide-gap) - var(--tour-track-tail));
    height: 420px;
    overflow: hidden;
    border-radius: var(--tour-photo-radius);
    scroll-snap-align: start;
  }

  .tour-slide > img,
  .tour-photo > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tour-slide--entrance > img { object-position: 43% center; }
  .tour-slide--activities > img { object-position: 66.6% center; }

  .tour-tag {
    position: absolute;
    z-index: 1;
    bottom: 14px;
    left: 13px;
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 48px;
    max-width: calc(100% - 26px);
    padding: 6px 12px 6px 8px;
    border-radius: var(--radius-pill);
    font-size: var(--text-control);
    font-weight: 600;
    line-height: var(--leading-control);
  }

  .tour-pagination { margin-block-start: .375rem; }

  .tour-invitation {
    display: flex;
    flex-direction: column;
    gap: var(--space-related);
    align-items: center;
    color: var(--color-forest);
    text-align: center;
  }

  .tour-invitation h3 { color: inherit; }
  .tour-invitation p { color: var(--color-text); }

  @media (min-width: 768px) {
    .tour-heading-copy { grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); }

    .tour-mobile,
    .tour-gallery { display: none; }
    .tour-tablet,
    .tour-expanded { display: block; }

    .tour-layout {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: center;
      column-gap: var(--space-inset);
    }

    .tour-entrance {
      display: grid;
      grid-column: 1 / -1;
      grid-template-columns: 390fr 298fr;
      align-items: start;
      gap: var(--space-inset);
    }

    .tour-photo {
      display: block;
      position: relative;
      min-width: 0;
      height: 252px;
      overflow: hidden;
      border-radius: var(--tour-photo-radius);
      box-shadow: var(--shadow-card);
    }

    .tour-photo:is(.tour-photo--entrance, .tour-photo--ramp)::after {
      position: absolute;
      inset: 0;
      background: linear-gradient(color-mix(in srgb, var(--color-paper) 18%, transparent), transparent 28% 60%, color-mix(in srgb, var(--color-ink) 18%, transparent));
      content: "";
      pointer-events: none;
    }

    .tour-photo--ramp { border-radius: 10.5px; }

    .tour-tag {
      bottom: 12px;
      left: 12px;
    }

    .tour-invitation {
      grid-column: 1 / -1;
    }

  }

  @media (min-width: 1200px) {
    .tour-heading h3 { margin-block-end: var(--space-detail); }
    .tour-heading p { max-inline-size: 65ch; }

    .tour-tablet { display: none; }
    .tour-wide { display: block; }

    .tour-layout {
      grid-template-columns: 480fr 624fr 480fr;
      column-gap: var(--section-gap);
    }

    .tour-entrance {
      grid-template-columns: 960fr 656fr;
      gap: var(--section-gap);
    }

    .tour-photo { height: auto; }
    .tour-photo--entrance { aspect-ratio: 960 / 592; }

    .tour-photo--ramp {
      margin-top: 48px;
      aspect-ratio: 656 / 488;
      border-radius: var(--tour-photo-radius);
    }

    .tour-photo--activities {
      grid-column: 1;
      grid-row: 2;
      aspect-ratio: 480 / 420;
      margin-block: 18px;
    }

    .tour-photo--activities > img { object-position: 66.6% center; }

    .tour-photo--details {
      grid-column: 3;
      grid-row: 2;
      aspect-ratio: 480 / 336;
    }

    .tour-tag {
      bottom: 24px;
      left: 24px;
      gap: var(--space-control-gap);
      min-height: 3.25rem;
      max-width: calc(100% - 48px);
      padding-inline-end: 1rem;
    }

    .tour-invitation {
      grid-column: 2;
      grid-row: 2;
    }

  }
</style>
