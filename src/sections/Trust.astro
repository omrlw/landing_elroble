---
import { Image } from 'astro:assets';
import Cta from '../components/Cta.astro';
import GalleryPlayback from '../components/GalleryPlayback.astro';
import clay from '../assets/confianza/persona-y-arcilla.jpg';
import gardenPortrait from '../assets/confianza/retrato-en-el-jardin.jpg';
import activityCorner from '../assets/confianza/rincon-de-actividades.jpg';
import supplies from '../assets/confianza/materiales-en-la-mesa.jpg';
import workshop from '../assets/confianza/ayuda-en-el-taller.jpg';
import game from '../assets/confianza/acompanamiento-en-el-juego.jpg';
import sharedRoom from '../assets/confianza/salon-compartido.jpg';
import clubTable from '../assets/confianza/mesa-del-club.jpg';
import sharedTable from '../assets/confianza/mesa-en-compania.jpg';
import windowRoom from '../assets/confianza/sala-con-ventanales.jpg';
import flowers from '../assets/confianza/buganvilla-del-jardin.jpg';
import path from '../assets/confianza/camino-a-el-roble.jpg';
import visitArrow from '../assets/opening/tour-arrow.svg';

const reasons = [
  {
    title: 'Primero, conocer a la persona.',
    text: 'Partimos de su historia, sus intereses y sus necesidades. La evaluación previa al ingreso orienta una atención acorde con sus capacidades.',
    photos: [
      { src: clay, alt: 'Una mujer muestra dos figuras de arcilla en las palmas de sus manos' },
      { src: gardenPortrait, alt: 'Una mujer sentada al aire libre en el jardín de El Roble' },
      { src: supplies, alt: 'Piezas de colores y un tablero de actividades preparados sobre una mesa' },
      { src: activityCorner, alt: 'Mesas de madera y estantes con materiales en un rincón del salón' },
    ],
  },
  {
    title: 'Un equipo que puedes conocer.',
    text: 'En tu visita, conversa con el equipo disponible y pregunta cómo acompaña a las personas mayores en su día a día.',
    photos: [
      { src: workshop, alt: 'Una mujer recibe ayuda con una manualidad en el taller' },
      { src: game, alt: 'Una acompañante mira junto a una mujer su cartón de bingo' },
      { src: sharedRoom, alt: 'Vista de las mesas y los materiales del salón de actividades' },
      { src: clubTable, alt: 'Mesa de trabajo junto a una ventana decorada del salón' },
    ],
  },
  {
    title: 'La familia también forma parte.',
    text: 'Cuéntanos sus rutinas y preferencias, y comparte tus dudas. Juntos valoramos la propuesta de atención.',
    photos: [
      { src: sharedTable, alt: 'Varias personas comparten una actividad alrededor de una mesa' },
      { src: path, alt: 'Sendero junto al jardín que lleva a la entrada de El Roble' },
      { src: windowRoom, alt: 'Sala de El Roble con mesas de madera junto a los ventanales' },
      { src: flowers, alt: 'Buganvilla fucsia en el jardín de El Roble' },
    ],
  },
];
const photoSizes = [
  '(min-width: 112rem) 330px, (min-width: 73rem) 19vw, (max-width: 40rem) calc(100vw - 24px), 52vw',
  '(min-width: 112rem) 445px, (min-width: 73rem) 26vw, 46vw',
  '(min-width: 112rem) 445px, 26vw',
  '(min-width: 112rem) 330px, 19vw',
];
---

<section class="trust" aria-labelledby="trust-title" data-trust>
  <div class="container trust__inner">
    <div class="trust__message" data-reveal="heading">
      <h2 id="trust-title">La confianza empieza<br /><em>por conocernos.</em></h2>
      <p>Antes de decidir, conversemos. Escuchamos a tu familia y valoramos juntos el apoyo que tu familiar necesita.</p>
    </div>

    <div class="trust__media">
      <div class="trust__gallery" id="trust-gallery-photos" data-swipe-gallery>
        {reasons.map(({ photos: slides }, index) => (
          <div class="trust__slides" data-scene={index} data-photo-scene>
            {[slides.slice(0, 2), slides.slice(2)].map((row, rowIndex) => (
              <div class:list={['trust__row', rowIndex === 1 && 'trust__row--extra']}
                data-gallery-extra={rowIndex === 1 ? '' : undefined}>
                {row.map(({ src, alt }, column) => (
                  <div class="trust__tile" data-gallery-tile>
                    <Image {src} {alt} widths={[320, 480, 720, 900].filter((width) => width <= src.width)}
                      sizes={photoSizes[rowIndex * 2 + column]} format="webp" />
                  </div>
                ))}
              </div>
            ))}
          </div>
        ))}
      </div>
      <fieldset class="gallery-pagination trust__pagination" data-gallery-pagination>
        <legend class="sr-only">Escenas de confianza</legend>
        {reasons.map(({ title }, index) => (
          <label title={title} data-gallery-dot>
            <input id={'trust-scene-' + index} type="radio" name="trust-scene" value={index} checked={index === 0}
              aria-label={title} aria-controls={'trust-gallery-photos trust-detail-' + index} />
            <span data-gallery-mark aria-hidden="true"></span>
          </label>
        ))}
        <GalleryPlayback controls="trust-gallery-photos" />
      </fieldset>
    </div>

    <div class="trust__reasons">
      {reasons.map(({ title, text }, index) => (
        <article class="trust__reason liquid-glass liquid-glass--forest-panel liquid-glass--underlay" data-scene={index}>
          <h3>
            <button class="trust__reason-trigger" type="button" aria-expanded={index === 0}
              aria-controls={'trust-detail-' + index} data-trust-trigger>
              {title}
              <span class="trust__reason-icon liquid-glass liquid-glass--forest-panel liquid-glass--lens" aria-hidden="true"></span>
            </button>
            <label class="trust__reason-fallback" for={'trust-scene-' + index}>{title}</label>
          </h3>
          <div class="trust__detail" id={'trust-detail-' + index} data-trust-detail>
            <div><p>{text}</p></div>
          </div>
        </article>
      ))}
    </div>

    <div class="trust__invitation">
      <div class="trust__invitation-copy">
        <div>
          <h3>Ven a conocernos.</h3>
          <p>Conoce el espacio, conversa con nuestro equipo y decide con tranquilidad.</p>
        </div>
        <Cta class="trust__visit" icon={visitArrow.src} variant="light" />
      </div>
    </div>
  </div>
</section>

<script>
  import { setupRadioGallery } from '../scripts/gallery';

  const trust = document.querySelector<HTMLElement>('[data-trust]');
  const carousel = trust?.querySelector<HTMLElement>('[data-swipe-gallery]');
  if (trust && carousel) {
    const controls = [...trust.querySelectorAll<HTMLInputElement>('input[name="trust-scene"]')];
    const scenes = [...carousel.querySelectorAll<HTMLElement>('[data-photo-scene]')];
    const triggers = [...trust.querySelectorAll<HTMLButtonElement>('[data-trust-trigger]')];
    const details = [...trust.querySelectorAll<HTMLElement>('[data-trust-detail]')];
    triggers.forEach((trigger, index) => {
      trigger.addEventListener('click', () => {
        if (trigger.getAttribute('aria-expanded') === 'false') controls[index].click();
      });
    });
    setupRadioGallery(carousel, controls, scenes, trust, (current) => {
      triggers.forEach((trigger, index) => {
        const expanded = index === current;
        trigger.setAttribute('aria-expanded', String(expanded));
        trigger.setAttribute('aria-disabled', String(expanded));
        details[index].inert = !expanded;
      });
    });
  }
</script>

<style>
  .trust {
    position: relative;
    isolation: isolate;
    overflow: clip;
    margin-inline: var(--section-edge);
    border-radius: clamp(1.5rem, 2.7vw, 1.75rem);
    color: var(--color-cream);
  }
  .trust::before {
    position: absolute;
    z-index: -2;
    inset: 0;
    border-radius: inherit;
    background: var(--surface-forest);
    content: '';
  }
  .trust__inner {
    display: grid;
    position: relative;
    width: calc(100% - max(.75rem, var(--page-gutter) - var(--section-edge)) * 2);
    grid-template-areas: "heading" "gallery" "reasons" "invitation";
    padding-block: clamp(3rem, 6.5vw, 4.75rem) clamp(2.25rem, 4vw, 3.25rem);
  }
  .trust__message {
    grid-area: heading;
    display: grid;
    align-content: start;
    gap: clamp(1.15rem, 1.6vw, 1.5rem);
    margin-block-end: clamp(1.75rem, 3.1vw, 3rem);
  }
  .trust h2 { color: inherit; }
  .trust h2 em { color: var(--color-honey); }
  .trust__message p, .trust__detail p {
    max-inline-size: 48ch;
    color: var(--color-on-forest-muted);
  }
  .trust__media {
    grid-area: gallery;
    display: grid;
    align-self: start;
    grid-template-columns: minmax(0, 1fr);
    gap: .15rem;
    min-inline-size: 0;
  }
  .trust__gallery { display: grid; grid-template: 'scene' / minmax(0, 1fr); isolation: isolate; }
  .trust__slides {
    --photo-display: grid;
    display: none;
    grid-area: scene;
    position: relative;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr);
    gap: clamp(.625rem, .75vw, .875rem);
    block-size: clamp(14rem, 34.375vw, 18rem);
  }
  .trust__row {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr);
    gap: inherit;
  }
  .trust__row--extra { display: none; }
  .trust__tile {
    position: relative;
    overflow: clip;
    border-radius: .85rem;
    background: var(--color-forest);
  }
  .trust__tile::after {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px var(--color-on-forest-line);
    pointer-events: none;
    content: '';
  }
  .trust__tile img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .trust__row:first-child .trust__tile:first-child img { object-position: 50% 16%; }
  .trust__slides[data-scene="0"] .trust__row:first-child .trust__tile:nth-child(2) img { object-position: 50% 33%; }
  .trust__slides[data-scene="2"] .trust__row:first-child .trust__tile:nth-child(2) img { object-position: 37% center; }
  .trust__slides[data-scene="2"] .trust__row--extra .trust__tile:nth-child(2) img { object-position: 50% 69%; }
  .trust:not([data-gallery-index]):has(#trust-scene-0:checked) .trust__slides[data-scene="0"],
  .trust:not([data-gallery-index]):has(#trust-scene-1:checked) .trust__slides[data-scene="1"],
  .trust:not([data-gallery-index]):has(#trust-scene-2:checked) .trust__slides[data-scene="2"] { display: grid; }

  .trust__reasons {
    grid-area: reasons;
    display: grid;
    align-content: start;
    gap: clamp(.65rem, 1vw, .95rem);
    margin-block-start: 1.125rem;
  }
  .trust__reason {
    --reason-active: 0;
    --reason-inset: clamp(1rem, 1.5vw, 1.5rem);
    --glass-visible: var(--reason-active);
    border-radius: .9rem;
  }
  .trust__reason h3 {
    color: inherit;
    font-size: var(--text-item);
    line-height: var(--leading-item);
  }
  .trust__reason-trigger, .trust__reason-fallback {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .75rem;
    min-block-size: var(--control-row-min-height);
    inline-size: 100%;
    padding: clamp(.75rem, 1.05vw, .95rem) var(--reason-inset);
    border-radius: inherit;
    cursor: pointer;
    text-align: start;
  }
  .trust__reason h3 { border-radius: inherit; }
  .trust__reason-trigger:focus-visible { outline-offset: -2px; }
  .trust__reason-trigger[aria-disabled="true"] { cursor: default; }
  .trust__reason-trigger, .trust[data-gallery-index] .trust__reason-fallback { display: none; }
  .trust[data-gallery-index] .trust__reason-trigger { display: flex; }

  .trust__reason-icon {
    position: relative;
    flex: 0 0 1.7rem;
    aspect-ratio: 1;
    border: 1px solid transparent;
    border-radius: 50%;
    color: var(--color-cream);
  }
  .trust__reason-icon::before, .trust__reason-icon::after {
    position: absolute;
    inset: 50% auto auto 50%;
    inline-size: .57rem;
    block-size: 1px;
    background: currentColor;
    content: '';
  }
  .trust__reason-icon::before { transform: translate(-50%, -50%); }
  .trust__reason-icon::after { transform: translate(-50%, -50%) rotate(90deg); }
  .trust__reason-trigger[aria-expanded="true"] .trust__reason-icon::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  .trust__detail {
    display: grid;
    grid-template-rows: var(--reason-track, 0fr);
    opacity: var(--reason-active);
    visibility: var(--reason-visibility, hidden);
  }
  .trust__detail > div { min-block-size: 0; overflow: clip; }
  .trust__detail p { max-inline-size: 58ch; padding: .225rem var(--reason-inset) clamp(1.2rem, 1.55vw, 1.45rem); }
  .trust:not([data-gallery-index]):has(#trust-scene-0:checked) .trust__reason[data-scene="0"],
  .trust:not([data-gallery-index]):has(#trust-scene-1:checked) .trust__reason[data-scene="1"],
  .trust:not([data-gallery-index]):has(#trust-scene-2:checked) .trust__reason[data-scene="2"],
  .trust[data-gallery-index] .trust__reason:has(.trust__reason-trigger[aria-expanded="true"]) {
    --reason-active: 1;
    --reason-track: 1fr;
    --reason-visibility: visible;
    --reason-hide-delay: 0s;
  }
  @media (hover: hover) {
    .trust__reason:has(.trust__reason-trigger[aria-expanded="false"]:hover, .trust__reason-fallback:hover) {
      --glass-visible: 1;
    }
  }
  .trust__reason:has(.trust__reason-trigger[aria-expanded="false"]:active, .trust__reason-fallback:active) {
    --glass-visible: 1;
    --glass-wash: var(--glass-press);
  }
  @media (prefers-reduced-motion: no-preference) {
    .trust__reason::before { transition: opacity 420ms var(--ease-in-out); }
    .trust__reason-icon::after { transition: transform 360ms var(--ease-soft); }
    .trust__detail {
      transition: grid-template-rows 420ms var(--ease-soft), opacity 310ms ease, visibility 0s var(--reason-hide-delay, 420ms);
    }
  }

  .trust__invitation {
    grid-area: invitation;
    margin-block-start: clamp(1.25rem, 1.75vw, 1.75rem);
    padding-block-start: clamp(1.15rem, 1.65vw, 1.65rem);
    border-block-start: 1px solid var(--color-on-forest-line);
  }
  .trust__invitation-copy { display: grid; align-items: center; gap: 1rem 1.5rem; }
  .trust__invitation h3 { color: inherit; }
  .trust__invitation p { margin-block-start: .55rem; color: var(--color-on-forest-muted); }
  .trust__invitation :global(.trust__visit) { justify-self: start; }
  .trust__invitation :global(.trust__visit .cta-icon img) { inline-size: 20px; block-size: 20px; }

  @media (max-width: 40rem) {
    .trust__slides { block-size: clamp(15rem, 60vw, 18rem); }
    .trust__row { grid-template-columns: minmax(0, 1fr); }
    .trust__row > .trust__tile:nth-child(2) { display: none; }
  }

  @media (min-width: 48rem) {
    .trust__invitation-copy { grid-template-columns: minmax(0, 1fr) auto; }
  }

  @media (min-width: 73rem) {
    .trust::before { inset-block-start: clamp(3.25rem, 4.2vw, 5rem); }
    .trust__inner {
      grid-template-columns: minmax(0, 744fr) minmax(0, 805fr);
      grid-template-rows: auto 1fr auto;
      grid-template-areas: "gallery heading" "gallery reasons" "invitation invitation";
      column-gap: clamp(2.75rem, 5vw, 6.25rem);
      padding-block: 0 clamp(2.5rem, 3.1vw, 3.25rem);
    }
    .trust__message {
      padding-block-start: clamp(5.8rem, 7.1vw, 8.5rem);
      padding-inline: clamp(1rem, 1.5vw, 1.5rem);
    }
    .trust__slides {
      grid-template-rows: minmax(0, 1.05fr) minmax(0, 1fr);
      block-size: auto;
      inline-size: 100%;
      min-block-size: clamp(35.75rem, 43vw, 40.5rem);
      aspect-ratio: 1.16;
    }
    .trust__row { grid-template-columns: minmax(0, 304fr) minmax(0, 424fr); }
    .trust__row--extra { display: grid; grid-template-columns: minmax(0, 424fr) minmax(0, 304fr); }
    .trust__row:first-child > .trust__tile:nth-child(2) { margin-block-start: clamp(1rem, 1.65vw, 1.85rem); }
    .trust__row--extra > .trust__tile:nth-child(2) { margin-block-end: clamp(.55rem, .8vw, .95rem); }
    .trust__reasons { margin-block-start: 0; }
    .trust__pagination { justify-self: end; margin-inline: 0; margin-block-start: -.25rem; }
  }

  @media (min-width: 73rem) and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .trust__media { view-timeline-name: --trust-mosaic; }

      .trust__tile {
        --trust-photo-offset: .45rem;
        animation: trust-photo-settle linear both;
        animation-timeline: --trust-mosaic;
        animation-range: entry 4% cover 38%;
      }
      .trust__tile:nth-child(2) { --trust-photo-offset: .85rem; }
      .trust__row--extra .trust__tile { animation-range: entry 12% cover 41%; }

      @keyframes trust-photo-settle {
        from { translate: 0 var(--trust-photo-offset); }
        to { translate: 0 0; }
      }
    }
  }
</style>
